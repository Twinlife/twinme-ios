    "account_view_controller_backup_beta_part_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خدمة النسخ الاحتياطي/الاستعادة قيد الاختبار التجريبي (بيتا) لتحديد المشكلات المحتملة قبل إطلاقها رسميًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopierings-/gendannelsestjenesten foreslås i BETA-test for at identificere potentielle problemer før dens generelle udgivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Backup-/Wiederherstellungsdienst befindet sich in der BETA-Testphase, um potenzielle Probleme vor der Veröffentlichung zu identifizieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The back-up/restore service is proposed in BETA testing in order to identify potential issues before its general release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de copia de seguridad/restauración se encuentra en fase beta para identificar posibles problemas antes de su lanzamiento general."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرویس پشتیبان‌گیری/بازیابی در مرحله‌ی آزمایش بتا (BETA) قرار دارد تا مشکلات احتمالی قبل از انتشار عمومی شناسایی شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopiointi-/palautuspalvelua ehdotetaan BETA-testauksessa mahdollisten ongelmien tunnistamiseksi ennen sen yleistä julkaisua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de sauvegarde/restauration est proposé en version BETA afin d'identifier les problèmes potentiels avant sa mise en service générale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שירות הגיבוי/שחזור מוצע בבדיקות BETA על מנת לזהות בעיות פוטנציאליות לפני השקתו הכללית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैक-अप/रिस्टोर सर्विस को BETA टेस्टिंग में प्रपोज़ किया गया है ताकि इसके जनरल रिलीज़ से पहले संभावित दिक्कतों की पहचान की जा सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan pencadangan/pemulihan diusulkan dalam pengujian BETA untuk mengidentifikasi potensi masalah sebelum rilis umum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio di backup/ripristino è proposto in fase di test BETA per identificare potenziali problemi prima del rilascio generale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップ/復元サービスは、一般公開前に潜在的な問題を特定するためにベータテストで提案されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업/복원 서비스는 정식 출시 전 잠재적인 문제를 파악하기 위해 베타 테스트 중입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopierings-/gjenopprettingstjenesten er foreslått i BETA-testing for å identifisere potensielle problemer før den generelle utgivelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-up-/herstelservice wordt momenteel in bètatests aangeboden om potentiële problemen te identificeren vóór de algemene release."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa tworzenia kopii zapasowej/przywracania jest proponowana w fazie testów BETA w celu zidentyfikowania potencjalnych problemów przed jej oficjalnym udostępnieniem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço de backup/restauro está em fase de testes BETA para identificar possíveis problemas antes do lançamento oficial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба резервного копирования/восстановления предлагается в рамках бета-тестирования для выявления потенциальных проблем перед её общим выпуском."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopierings-/återställningstjänsten föreslås i BETA-testning för att identifiera potentiella problem innan den släpps allmänt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekleme/geri yükleme hizmeti, genel kullanıma sunulmadan önce olası sorunları belirlemek amacıyla BETA testinde sunulmaktadır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба резервного копіювання/відновлення пропонується на стадії БЕТА-тестування, щоб виявити потенційні проблеми перед її загальним випуском."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ sao lưu/khôi phục đang được thử nghiệm BETA để xác định các vấn đề tiềm ẩn trước khi phát hành rộng rãi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份/恢复服务目前处于 Beta 测试阶段，旨在正式发布前识别潜在问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份/復原服務目前處於 Beta 測試階段，旨在正式發布前識別潛在問題。"
          }
        }
      }
    },
    "account_view_controller_backup_beta_part_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تهدف هذه الخدمة إلى نسخ بيانات الحساب الوصفية فقط (الملفات الشخصية، جهات الاتصال، المجموعات) إلى وحدة تخزين خارجية، بحيث يمكن استعادتها لاحقًا على جهاز آخر في حال سرقة الجهاز الأصلي أو تلفه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tjeneste er beregnet til kun at sikkerhedskopiere kontometadata (profiler, kontakter, grupper) til ekstern lagring, så de kan gendannes senere på en anden enhed, hvis originalen bliver stjålet eller ødelagt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Dienst sichert ausschließlich Konto-Metadaten (Profile, Kontakte, Gruppen) auf einem externen Speicher, damit diese später auf einem anderen Gerät wiederhergestellt werden können, falls das Original gestohlen oder zerstört wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This service is intended to back up only account metadata (profiles, contacts, groups) to external storage so it can be restored later on another device, if the original is stolen or destroyed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servicio está diseñado para respaldar únicamente los metadatos de la cuenta (perfiles, contactos, grupos) en un almacenamiento externo para que puedan restaurarse posteriormente en otro dispositivo, en caso de robo o destrucción del dispositivo original."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این سرویس فقط برای پشتیبان‌گیری از فراداده‌های حساب (پروفایل‌ها، مخاطبین، گروه‌ها) در حافظه خارجی در نظر گرفته شده است تا در صورت سرقت یا از بین رفتن نسخه اصلی، بتوان بعداً آن را در دستگاه دیگری بازیابی کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palvelu on tarkoitettu vain tilien metatietojen (profiilit, yhteystiedot, ryhmät) varmuuskopiointiin ulkoiseen tallennustilaan, jotta ne voidaan palauttaa myöhemmin toiselle laitteelle, jos alkuperäinen varastetaan tai tuhoutuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce service est destiné à sauvegarder uniquement les métadonnées du compte (profils, contacts, groupes) sur un support de stockage externe afin qu'elles puissent être restaurées ultérieurement sur un autre appareil, si l'original est volé ou détruit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שירות זה נועד לגבות רק מטא-נתונים של חשבונות (פרופילים, אנשי קשר, קבוצות) לאחסון חיצוני, כך שניתן יהיה לשחזר אותם מאוחר יותר במכשיר אחר, אם המקור נגנב או נהרס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सर्विस का मकसद सिर्फ़ अकाउंट मेटाडेटा (प्रोफ़ाइल, कॉन्टैक्ट, ग्रुप) का एक्सटर्नल स्टोरेज में बैकअप लेना है, ताकि अगर ओरिजिनल चोरी हो जाए या खराब हो जाए, तो इसे बाद में किसी दूसरे डिवाइस पर रिस्टोर किया जा सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan ini dimaksudkan untuk mencadangkan hanya metadata akun (profil, kontak, grup) ke penyimpanan eksternal sehingga dapat dipulihkan nanti di perangkat lain, jika perangkat asli dicuri atau rusak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo servizio è progettato per eseguire il backup solo dei metadati dell'account (profili, contatti, gruppi) su un dispositivo di archiviazione esterno, in modo da poterli ripristinare in seguito su un altro dispositivo, in caso di furto o distruzione dell'originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサービスは、アカウントのメタデータ（プロフィール、連絡先、グループ）のみを外部ストレージにバックアップし、元のデバイスが盗難または破損した場合に、後で別のデバイスで復元できるようにすることを目的としています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서비스는 계정 메타데이터(프로필, 연락처, 그룹)만 외부 저장소에 백업하여 원본 기기가 도난당하거나 파손된 경우 다른 기기에서 복원할 수 있도록 설계되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tjenesten er ment å sikkerhetskopiere kun kontometadata (profiler, kontakter, grupper) til ekstern lagring, slik at de kan gjenopprettes senere på en annen enhet hvis originalen blir stjålet eller ødelagt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze service is bedoeld om alleen accountmetadata (profielen, contacten, groepen) naar externe opslag te back-uppen, zodat deze later op een ander apparaat kunnen worden hersteld als het origineel wordt gestolen of vernietigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa ta służy do tworzenia kopii zapasowych wyłącznie metadanych konta (profili, kontaktów, grup) na zewnętrznej pamięci masowej, aby można je było później przywrócić na innym urządzeniu, jeśli oryginał zostanie skradziony lub zniszczony."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este serviço destina-se a fazer o backup apenas dos metadados da conta (perfis, contactos, grupos) num armazenamento externo, para que possam ser restaurados posteriormente noutro dispositivo, caso o original seja roubado ou destruído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта служба предназначена для резервного копирования только метаданных учетной записи (профилей, контактов, групп) на внешнее хранилище, чтобы их можно было восстановить позже на другом устройстве, если оригинал будет украден или уничтожен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här tjänsten är avsedd att säkerhetskopiera endast kontometadata (profiler, kontakter, grupper) till extern lagring så att den kan återställas senare på en annan enhet om originalet blir stulet eller förstört."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hizmet, yalnızca hesap meta verilerini (profiller, kişiler, gruplar) harici depolamaya yedeklemek ve orijinal cihaz çalınırsa veya imha edilirse daha sonra başka bir cihazda geri yüklemek için tasarlanmıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця служба призначена для резервного копіювання лише метаданих облікового запису (профілів, контактів, груп) на зовнішній накопичувач, щоб їх можна було відновити пізніше на іншому пристрої, якщо оригінал буде викрадено або знищено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ này chỉ nhằm mục đích sao lưu siêu dữ liệu tài khoản (hồ sơ, danh bạ, nhóm) vào bộ nhớ ngoài để có thể khôi phục sau này trên thiết bị khác, nếu thiết bị gốc bị đánh cắp hoặc bị hỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务仅用于将帐户元数据（个人资料、联系人、群组）备份到外部存储，以便在原始设备被盗或损坏时，可以在其他设备上恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服務僅用於將帳戶元資料（個人資料、聯絡人、群組）備份到外部存儲，以便在原始設備被盜或損壞時，可以在其他設備上恢復。"
          }
        }
      }
    },
    "account_view_controller_backup_beta_part_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب استخدام خدمة نقل الحساب لنقل جميع بيانات الحساب (بما في ذلك المحادثات) من جهاز (قديم) إلى جهاز آخر (جديد)، عند توفر كلا الجهازين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontooverførselstjenesten bør bruges til at overføre alle kontodata (inklusive samtaler) fra en (gammel) enhed til en anden (ny) enhed, når begge enheder er tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kontoübertragungsdienst können alle Kontodaten (einschließlich Konversationen) von einem (alten) Gerät auf ein anderes (neues) Gerät übertragen werden, sofern beide Geräte verfügbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This service is intended to back up only account metadata (profiles, contacts, groups) to external storage so it can be restored later on another device, if the original is stolen or destroyed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de transferencia de cuenta debe utilizarse para transferir todos los datos de la cuenta (incluidas las conversaciones) de un dispositivo (antiguo) a otro (nuevo), siempre que ambos dispositivos estén disponibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرویس انتقال حساب باید برای انتقال تمام داده‌های حساب (از جمله مکالمات) از یک دستگاه (قدیمی) به دستگاه دیگر (جدید) در صورت موجود بودن هر دو دستگاه استفاده شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilinsiirtopalvelua tulisi käyttää kaikkien tilitietojen (mukaan lukien keskustelut) siirtämiseen yhdestä (vanhasta) laitteesta toiseen (uuteen) laitteeseen, kun molemmat laitteet ovat käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de transfert de compte doit être utilisé pour transférer toutes les données du compte (y compris les conversations) d'un appareil (ancien) à un autre appareil (nouveau), lorsque les deux appareils sont disponibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שירות זה נועד לגבות רק מטא-נתונים של חשבונות (פרופילים, אנשי קשר, קבוצות) לאחסון חיצוני, כך שניתן יהיה לשחזר אותם מאוחר יותר במכשיר אחר, אם המקור נגנב או נהרס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अकाउंट ट्रांसफ़र सर्विस का इस्तेमाल सभी अकाउंट डेटा (बातचीत सहित) को एक (पुराने) डिवाइस से दूसरे (नए) डिवाइस में ट्रांसफ़र करने के लिए किया जाना चाहिए, जब दोनों डिवाइस उपलब्ध हों।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan transfer akun harus digunakan untuk mentransfer semua data akun (termasuk percakapan) dari satu perangkat (lama) ke perangkat lain (baru), ketika kedua perangkat tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio di trasferimento account deve essere utilizzato per trasferire tutti i dati dell'account (incluse le conversazioni) da un (vecchio) dispositivo a un altro (nuovo), quando entrambi i dispositivi sono disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント移行サービスは、両方のデバイスが利用可能な場合に、1つの（古い）デバイスから別の（新しい）デバイスにすべてのアカウントデータ（会話を含む）を移行するために使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 전송 서비스는 두 기기 모두 사용 가능한 경우, 모든 계정 데이터(대화 포함)를 한 (이전) 기기에서 다른 (새) 기기로 전송하는 데 사용해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontooverføringstjenesten bør brukes til å overføre alle kontodata (inkludert samtaler) fra én (gammel) enhet til en annen (ny) enhet, når begge enhetene er tilgjengelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De accountoverdrachtservice moet worden gebruikt om alle accountgegevens (inclusief gesprekken) van een (oud) apparaat naar een ander (nieuw) apparaat over te zetten, wanneer beide apparaten beschikbaar zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa transferu konta powinna być używana do przenoszenia wszystkich danych konta (w tym rozmów) z jednego (starego) urządzenia na inne (nowe) urządzenie, gdy oba urządzenia są dostępne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço de transferência de conta deve ser utilizado para transferir todos os dados da conta (incluindo conversas) de um dispositivo (antigo) para outro (novo), quando ambos os dispositivos estão disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба переноса учетной записи должна использоваться для переноса всех данных учетной записи (включая переписку) с одного (старого) устройства на другое (новое) устройство, если оба устройства доступны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoöverföringstjänsten bör användas för att överföra all kontodata (inklusive konversationer) från en (gammal) enhet till en annan (ny) enhet, när båda enheterna är tillgängliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap aktarma hizmeti, her iki cihaz da kullanılabilir olduğunda, tüm hesap verilerini (konuşmalar dahil) bir (eski) cihazdan başka bir (yeni) cihaza aktarmak için kullanılmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба перенесення облікових записів повинна використовуватися для перенесення всіх даних облікового запису (включаючи розмови) з одного (старого) пристрою на інший (новий), коли обидва пристрої доступні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ chuyển tài khoản nên được sử dụng để chuyển tất cả dữ liệu tài khoản (bao gồm cả cuộc trò chuyện) từ thiết bị (cũ) sang thiết bị (mới) khác, khi cả hai thiết bị đều khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帐户转移服务用于在两台设备都可用时，将所有帐户数据（包括对话）从一台（旧）设备传输到另一台（新）设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳戶轉移服務用於在兩台裝置都可用時，將所有帳戶資料（包括對話）從一台（舊）裝置傳輸到另一台（新）裝置。"
          }
        }
      }
    },
