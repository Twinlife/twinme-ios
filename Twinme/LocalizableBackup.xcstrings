    "backups_view_controller_invalidate_backup_message_part_one" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُصبح جميع نسخك الاحتياطية السابقة غير صالحة ولن تتمكن من استعادتها."
