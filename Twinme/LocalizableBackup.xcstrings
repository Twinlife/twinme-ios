    "backup_view_controller_onboarding" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شئ نسخة احتياطية مشفرة لبيانات حسابك (\"Spaces\"، الملفات الشخصية، جهات الاتصال، \"click-to-call\") التي يمكن استعادتها إلى هذا الجهاز أو جهاز آخر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav en krypteret sikkerhedskopi af kontodata (\"Spaces\", profiler, kontakter, \"click-to-call\"), der kan gendannes til denne enhed eller en anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie ein verschlüsseltes Backup der Kontodaten („Spaces“, Profile, Kontakte, „Click-to-Call“), das auf diesem oder einem anderen Gerät wiederhergestellt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make an encrypted backup of account data (Spaces, profiles, contacts, click-to-call) that can be restored to this device or another one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una copia de seguridad cifrada de los datos de la cuenta (\"Spaces\", perfiles, contactos, \"click-to-call\") que se pueda restaurar en este dispositivo o en otro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک نسخه پشتیبان رمزگذاری شده از اطلاعات حساب (فضاها، پروفایل‌ها، مخاطبین، کلیک برای تماس) تهیه کنید که بتوان آن را در این دستگاه یا دستگاه دیگری بازیابی کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee salattu varmuuskopio tilitiedoista (\"Spaces\", profiilit, yhteystiedot, \"click-to-call\"), joka voidaan palauttaa tähän tai toiseen laitteeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuez une sauvegarde chiffrée des données de votre compte (Spaces, profils, contacts, click-to-call) qui pourra être restaurée sur cet appareil ou un autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצע גיבוי מוצפן של נתוני חשבון (\"Spaces\", פרופילים, אנשי קשר, \"click-to-call\") שניתן לשחזר למכשיר זה או למכשיר אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाता डेटा (\"Spaces\", प्रोफ़ाइल, संपर्क, \"click-to-call\") का एक एन्क्रिप्टेड बैकअप बनाएँ जिसे इस डिवाइस या किसी अन्य डिवाइस पर पुनर्स्थापित किया जा सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat cadangan terenkripsi untuk data akun (\"Spaces\", profil, kontak, \"click-to-call\") yang dapat dipulihkan ke perangkat ini atau perangkat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui un backup crittografato dei dati dell'account (\"Spaces\", profili, contatti, \"click-to-call\") che può essere ripristinato su questo dispositivo o su un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントデータ（「Spaces」、プロフィール、連絡先、「click-to-call」）の暗号化されたバックアップを作成します。このバックアップは、このデバイスまたは別のデバイスに復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 데이터(\"Spaces\", 프로필, 연락처, \"click-to-call\")를 암호화하여 이 기기 또는 다른 기기에 복원할 수 있는 백업을 만드세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag en kryptert sikkerhetskopi av kontodata (\"Spaces\", profiler, kontakter, \"click-to-call\") som kan gjenopprettes til denne enheten eller en annen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een versleutelde back-up van accountgegevens (\"Spaces\", profielen, contacten, \"click-to-call\") die kan worden hersteld naar dit apparaat of een ander apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz zaszyfrowaną kopię zapasową danych konta („Spaces”, profile, kontakty, „click-to-call”), którą można przywrócić na to lub inne urządzenie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um backup encriptado dos dados da conta (\"Spaces\", perfis, contactos, \"click-to-call\") que podem ser restaurados neste ou noutro dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте зашифрованную резервную копию данных учётной записи («Spaces», профили, контакты, «Click-to-call»), которую можно будет восстановить на этом или другом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör en krypterad säkerhetskopia av kontodata (\"Spaces\", profiler, kontakter, \"click-to-call\") som kan återställas till den här enheten eller en annan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap verilerinizin (\"Spaces\", profiller, kişiler, \"click-to-call\") şifreli bir yedeğini oluşturun ve bu yedek bu cihaza veya başka bir cihaza geri yüklenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
