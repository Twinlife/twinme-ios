    "restore_view_controller_backup_device_always_signed_in_part_three" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت ترغب في نقل حسابك إلى جهاز جديد، ولا يزال حسابك القديم موجودًا، يُفضل استخدام عملية \"نقل الحساب\" بدلاً من استعادة النسخة الاحتياطية، حيث ستنقل أيضًا المحادثات والمجموعات والإشعارات وسجل التصفح."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil overføre din konto til en ny enhed, og du stadig har den gamle, er det at foretrække at bruge \"kontomigrering\"-handlingen i stedet for at gendanne en sikkerhedskopi, da det også vil overføre samtaler, grupper, notifikationer og historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihr Konto auf ein neues Gerät übertragen möchten und das alte noch besitzen, verwenden Sie am besten die Kontomigration anstelle der Wiederherstellung eines Backups, da dabei auch Konversationen, Gruppen, Benachrichtigungen und der Verlauf übertragen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want to transfer your account to a new device, and you still have the old one, it is preferable to use the \"account migration\" operation, rather than restoring a backup, as it will also transfer conversations, groups, notifications, and history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si desea transferir su cuenta a un nuevo dispositivo y aún conserva el antiguo, es preferible usar la operación de \"migración de cuenta\" en lugar de restaurar una copia de seguridad, ya que también se transferirán las conversaciones, los grupos, las notificaciones y el historial."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر می‌خواهید حساب خود را به دستگاه جدیدی منتقل کنید و هنوز دستگاه قدیمی خود را دارید، ترجیحاً از عملیات «انتقال حساب» به جای بازیابی نسخه پشتیبان استفاده کنید، زیرا این کار مکالمات، گروه‌ها، اعلان‌ها و تاریخچه را نیز منتقل می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat siirtää tilisi uudelle laitteelle ja sinulla on vielä vanha laite, on parempi käyttää \"tilin siirtoa\" varmuuskopion palauttamisen sijaan, koska se siirtää myös keskustelut, ryhmät, ilmoitukset ja historian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous souhaitez transférer votre compte vers un nouvel appareil et que vous possédez toujours l'ancien, il est préférable d'utiliser la « migration de compte » plutôt que de restaurer une sauvegarde, car elle transférera également les conversations, les groupes, les notifications et l'historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ברצונך להעביר את החשבון שלך למכשיר חדש, ועדיין יש לך את החשבון הישן, עדיף להשתמש בפעולת \"העברת חשבון\", במקום שחזור גיבוי, מכיוון שהיא תעביר גם שיחות, קבוצות, התראות והיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप अपना खाता किसी नए डिवाइस पर स्थानांतरित करना चाहते हैं, और आपके पास अभी भी पुराना डिवाइस है, तो बैकअप पुनर्स्थापित करने के बजाय \"खाता माइग्रेशन\" प्रक्रिया का उपयोग करना बेहतर होगा, क्योंकि यह बातचीत, समूह, सूचनाएँ और इतिहास भी स्थानांतरित कर देगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda ingin mentransfer akun ke perangkat baru, dan Anda masih memiliki perangkat lama, sebaiknya gunakan operasi \"migrasi akun\", daripada memulihkan cadangan, karena tindakan ini juga akan mentransfer percakapan, grup, notifikasi, dan riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desideri trasferire il tuo account su un nuovo dispositivo e hai ancora quello vecchio, è preferibile utilizzare l'operazione di \"migrazione dell'account\", piuttosto che ripristinare un backup, poiché trasferirà anche conversazioni, gruppi, notifiche e cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを新しいデバイスに移行したいが、古いデバイスをまだお持ちの場合は、バックアップの復元ではなく「アカウント移行」操作をご利用いただくことをおすすめします。この操作では、会話、グループ、通知、履歴も移行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 새 기기로 이전하고 싶지만 기존 기기가 아직 있는 경우, 백업을 복원하는 것보다 \"계정 마이그레이션\" 작업을 사용하는 것이 좋습니다. 이 작업을 수행하면 대화, 그룹, 알림 및 기록도 함께 전송됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil overføre kontoen din til en ny enhet, og du fortsatt har den gamle, er det å foretrekke å bruke \"kontomigrering\"-operasjonen i stedet for å gjenopprette en sikkerhetskopi, da det også vil overføre samtaler, grupper, varsler og historikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u uw account wilt overzetten naar een nieuw apparaat en u nog steeds het oude hebt, is het beter om de bewerking \"Accountmigratie\" te gebruiken in plaats van een back-up te herstellen, omdat hiermee ook gesprekken, groepen, meldingen en geschiedenis worden overgezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli chcesz przenieść swoje konto na nowe urządzenie, a nadal masz stare, lepiej skorzystać z operacji „migracji konta” niż przywracać kopię zapasową, ponieważ spowoduje to również przeniesienie rozmów, grup, powiadomień i historii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quiser transferir a sua conta para um novo dispositivo e ainda tiver a antiga, é preferível utilizar a operação de \"migração de conta\" em vez de restaurar uma cópia de segurança, pois esta também irá transferir conversas, grupos, notificações e histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы хотите перенести свою учётную запись на новое устройство, а старая у вас осталась, предпочтительнее использовать операцию «миграция учётной записи», а не восстановление резервной копии, так как при этом также будут перенесены беседы, группы, уведомления и история."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill överföra ditt konto till en ny enhet och du fortfarande har den gamla är det att föredra att använda åtgärden \"kontomigrering\" snarare än att återställa en säkerhetskopia, eftersom det också kommer att överföra konversationer, grupper, aviseringar och historik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı yeni bir cihaza aktarmak istiyorsanız ve hala eski hesabınız varsa, yedeklemeyi geri yüklemek yerine \"hesap taşıma\" işlemini kullanmanız tercih edilir, çünkü bu işlem konuşmaları, grupları, bildirimleri ve geçmişi de aktarır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви хочете перенести свій обліковий запис на новий пристрій, а у вас все ще є старий, краще використовувати операцію \"міграції облікового запису\", ніж відновлення резервної копії, оскільки це також перенесе розмови, групи, сповіщення та історію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn muốn chuyển tài khoản của mình sang thiết bị mới và vẫn còn thiết bị cũ, tốt nhất nên sử dụng thao tác \"di chuyển tài khoản\" thay vì khôi phục bản sao lưu, vì thao tác này cũng sẽ chuyển các cuộc trò chuyện, nhóm, thông báo và lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想将帐户转移到新设备，并且您仍然拥有旧帐户，最好使用“帐户迁移”操作，而不是恢复备份，因为迁移操作也会转移对话、群组、通知和历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想將帳戶轉移到新設備，並且您仍然擁有舊帳戶，最好使用「帳戶遷移」操作，而不是恢復備份，因為遷移作業也會轉移對話、群組、通知和歷史記錄。"
          }
        }
      }
    },
    "restore_view_controller_backup_device_always_signed_in_part_two" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في حال استعادة النسخة الاحتياطية إلى هذا الجهاز الجديد، سيتم إلغاء حساب الجهاز الذي أجريت عليه النسخة الاحتياطية تلقائيًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du gendanner sikkerhedskopien til denne nye enhed, bliver kontoen på den enhed, hvor sikkerhedskopien blev foretaget, automatisk ugyldiggjort."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie das Backup auf diesem neuen Gerät wiederherstellen, wird das Konto des Geräts, auf dem das Backup erstellt wurde, automatisch ungültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you restore the backup to this new device, the account of the device on which the backup was made will be automatically invalidated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si restauras la copia de seguridad en este nuevo dispositivo, la cuenta del dispositivo en el que se realizó la copia de seguridad se invalidará automáticamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر نسخه پشتیبان را در این دستگاه جدید بازیابی کنید، حساب دستگاهی که نسخه پشتیبان در آن ایجاد شده است، به"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos palautat varmuuskopion tälle uudelle laitteelle, laitteen tili, jolla varmuuskopio tehtiin, mitätöidään automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous restaurez la sauvegarde sur ce nouvel appareil, le compte de l'appareil sur lequel la sauvegarde a été effectuée sera automatiquement invalidé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם תשחזר את הגיבוי למכשיר החדש, החשבון של המכשיר שבו בוצע הגיבוי יבוטל אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप इस नए डिवाइस पर बैकअप पुनर्स्थापित करते हैं, तो जिस डिवाइस पर बैकअप बनाया गया था उसका खाता स्वतः ही अमान्य हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda memulihkan cadangan ke perangkat baru ini, akun perangkat tempat cadangan dibuat akan otomatis dinonaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ripristini il backup su questo nuovo dispositivo, l'account del dispositivo su cui è stato effettuato il backup verrà automaticamente invalidato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この新しいデバイスにバックアップを復元すると、バックアップを作成したデバイスのアカウントは自動的に無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 새 기기에 백업을 복원하면 백업이 생성된 기기의 계정이 자동으로 무효화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du gjenoppretter sikkerhetskopien til denne nye enheten, blir kontoen til enheten som sikkerhetskopien ble gjort på automatisk ugyldig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u de back-up herstelt naar dit nieuwe apparaat, wordt het account van het apparaat waarop de back-up is gemaakt, automatisch ongeldig gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli przywrócisz kopię zapasową na to nowe urządzenie, konto urządzenia, na którym została utworzona, zostanie automatycznie unieważnione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restaurar o backup neste novo dispositivo, a conta do dispositivo no qual o backup foi feito será automaticamente invalidada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы восстановите резервную копию на этом новом устройстве, учётная запись устройства, на котором была создана резервная копия, будет автоматически аннулирована. "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du återställer säkerhetskopian till den här nya enheten kommer kontot för den enhet som säkerhetskopian gjordes på att automatiskt ogiltigförklaras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeklemeyi bu yeni cihaza geri yüklerseniz, yedeklemenin yapıldığı cihazın hesabı otomatik olarak geçersiz kılınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви відновите резервну копію на цьому новому пристрої, обліковий запис пристрою, на якому було створено резервну копію, буде автоматично анульовано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn khôi phục bản sao lưu sang thiết bị mới này, tài khoản của thiết bị đã tạo bản sao lưu sẽ tự động bị vô hiệu hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您将备份恢复到此新设备，则进行备份的设备的帐户将自动失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您將備份還原到此新設備，則進行備份的設備的帳戶將自動失效。"
          }
        }
      }
    },
    "restore_view_controller_confirm" : {
      "comment" : "RestoreViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من أنك تريد استبدال بيانات الحساب الجاري بالبيانات التالية من النسخ الاحتياطي؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil udskifte de løbende kontodata med følgende data fra sikkerhedskopien?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie die aktuellen Kontodaten durch die folgenden Daten aus der Backup ersetzen möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to replace the current account data with the following data from the backup?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está seguro de que desea reemplazar los datos de la cuenta corriente con los siguientes datos de la copia de seguridad?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئن هستید که می خواهید داده های حساب جاری را با داده های زیر از نسخه پشتیبان جایگزین کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko varma, että haluat korvata nykyiset tilitiedot seuraavilla varmuuskopioilla olevilla tiedoilla?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir remplacer les données actuelles du compte par les données suivantes de la sauvegarde ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שאתה רוצה להחליף את נתוני החשבון הנוכחי בנתונים הבאים מהגיבוי?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप सुनिश्चित हैं कि आप बैकअप से निम्न डेटा के साथ चालू खाता डेटा को बदलना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda yakin ingin mengganti data akun saat ini dengan data berikut dari cadangan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler sostituire i dati dell'account corrente con i seguenti dati dal backup?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアカウントデータをバックアップの次のデータに置き換えたいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 계정 데이터를 백업의 다음 데이터로 바꾸려고합니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil erstatte driftsdataene med følgende data fra sikkerhetskopien?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet u zeker dat u de huidige accountgegevens wilt vervangen door de volgende gegevens van de back -up?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz zastąpić dane o koncie bieżącym następującymi danymi z kopii zapasowej?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja substituir os dados da conta corrente pelos seguintes dados do backup?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите заменить текущие данные учетной записи следующими данными из резервной копии?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill byta ut information om bytesbalansen med följande data från säkerhetskopian?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli hesap verilerini yedeklemeden aşağıdaki verilerle değiştirmek istediğinizden emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені, що хочете замінити поточні дані облікового запису на наступні дані з резервної копії?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc chắn muốn thay thế dữ liệu tài khoản hiện tại bằng dữ liệu sau từ bản sao lưu không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要用备份中的以下数据替换频道数据吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要用備份中的以下數據替換頻道數據嗎？"
          }
        }
      }
    },
