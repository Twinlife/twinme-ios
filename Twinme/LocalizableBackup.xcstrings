    "restore_view_content_profile_reset_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز الدعوة المرتبط بالملف الشخصي الذي تم نسخه احتياطيًا غير صالح. سيتم إنشاء رمز دعوة جديد أثناء عملية الاستعادة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кодът за покана, свързан с архивирания профил, е невалиден. По време на процеса на възстановяване ще бъде генериран нов код за покана."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvánkový kód spojený se zálohovaným profilem je neplatný. Během obnovy bude vygenerován nový pozvánkový kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitationskoden knyttet til den sikkerhedskopierede profil er ugyldig. En ny invitationskode genereres under gendannelsesprocessen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der mit dem gesicherten Profil verknüpfte Einladungscode ist ungültig. Während der Wiederherstellung wird ein neuer Einladungscode generiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός πρόσκλησης που συνδέεται με το αποθηκευμένο προφίλ είναι άκυρος. Θα δημιουργηθεί νέος κωδικός πρόσκλησης κατά τη διαδικασία επαναφοράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The invitation code associated with the backed-up profile is invalid. A new invitation code will be generated during the restore process."
          }
        },
