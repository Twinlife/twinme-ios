        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan berkas cadangan ke perangkat pilihan Anda dan simpan kata sandinya untuk pemulihan nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva il file di backup sul dispositivo che preferisci e conserva le password per un ripristino successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップファイルを任意のデバイスに保存し、後で復元できるようにパスワードを保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업 파일을 원하는 기기에 저장하고 나중에 복원할 수 있도록 비밀번호를 보관하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre sikkerhetskopifilen på enheten du velger, og behold passordene for senere gjenoppretting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla het back-upbestand op het apparaat van uw keuze op en bewaar de wachtwoorden voor later herstel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz plik kopii zapasowej na wybranym urządzeniu i zachowaj hasła do późniejszego przywrócenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde o ficheiro de cópia de segurança no dispositivo da sua escolha e guarde as palavras-passe para restauração posterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните файл резервной копии на выбранном вами устройстве и сохраните пароли для последующего восстановления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara säkerhetskopian på den enhet du väljer och behåll lösenorden för senare återställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
