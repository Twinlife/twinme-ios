    "backup_view_controller_content_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تشمل النسخ الاحتياطية المحادثات، والمجموعات، والإشعارات، وسجل التصفح."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopier inkluderer ikke samtaler, grupper, notifikationer og historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups enthalten keine Konversationen, Gruppen, Benachrichtigungen und den Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups do not include conversations, groups, notifications, and history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad no incluyen conversaciones, grupos, notificaciones ni historial."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبان‌گیری شامل مکالمات، گروه‌ها، اعلان‌ها و تاریخچه نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopiot eivät sisällä keskusteluja, ryhmiä, ilmoituksia ja historiaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes n'incluent pas les conversations, les groupes, les notifications et l'historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גיבויים אינם כוללים שיחות, קבוצות, התראות והיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप में बातचीत, समूह, सूचनाएँ और इतिहास शामिल नहीं होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan tidak mencakup percakapan, grup, notifikasi, dan riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup non includono conversazioni, gruppi, notifiche e cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップには、会話、グループ、通知、履歴は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업에는 대화, 그룹, 알림 및 기록이 포함되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopier inkluderer ikke samtaler, grupper, varsler og historikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back-ups bevatten geen gesprekken, groepen, meldingen en geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie zapasowe nie obejmują rozmów, grup, powiadomień ani historii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups não incluem conversas, grupos, notificações e histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии не включают разговоры, группы, уведомления и историю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopior inkluderar inte konversationer, grupper, aviseringar och historik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeklemeler, konuşmaları, grupları, bildirimleri ve geçmişi içermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервні копії не включають розмови, групи, сповіщення та історію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu không bao gồm các cuộc trò chuyện, nhóm, thông báo và lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份不包括对话、群组、通知和历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份不包括對話、群組、通知和歷史記錄。"
          }
        }
      }
    },
