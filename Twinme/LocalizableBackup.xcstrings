    "backup_view_onboarding" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شئ نسخة احتياطية مشفرة لبيانات حسابك (\"Spaces\"، الملفات الشخصية، جهات الاتصال، \"click-to-call\") التي يمكن استعادتها إلى هذا الجهاز أو جهاز آخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Направете криптирано резервно копие на данните от акаунта (пространства, профили, контакти, групи, click-to-call), което може да бъде възстановено на това или друго устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte šifrovanou zálohu dat účtu (Prostory, profily, kontakty, skupiny, click-to-call), kterou lze obnovit na toto nebo jiné zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav en krypteret sikkerhedskopi af kontodata (\"Spaces\", profiler, kontakter, grupper, \"click-to-call\"), der kan gendannes til denne enhed eller en anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie eine verschlüsselte Sicherung der Kontodaten (Bereiche, Profile, Kontaktpersonen, Gruppen, Click-to-Call), die auf diesem oder einem anderen Gerät wiederhergestellt werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε ένα κρυπτογραφημένο αντίγραφο ασφαλείας των δεδομένων του λογαριασμού (Χώροι, προφίλ, επαφές, ομάδες, click-to-call) που μπορεί να επαναφερθεί σε αυτήν ή σε άλλη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make an encrypted backup of account data (Spaces, profiles, contacts, groups, click-to-call) that can be restored to this device or another one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una copia de seguridad cifrada de los datos de la cuenta (\"Spaces\", perfiles, contactos, grupos, « click-to-call ») que se pueda restaurar en este dispositivo o en otro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از اطلاعات حساب (فضاها، پروفایل‌ها، مخاطبین، گروه‌ها، کلیک برای تماس) یک نسخه پشتیبان رمزگذاری شده تهیه کنید که بتوان آن را در این دستگاه یا دستگاه دیگری بازیابی کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee salattu varmuuskopio tilitiedoista (\"Spaces\", profiilit, ryhmät, yhteystiedot, \"click-to-call\"), joka voidaan palauttaa tähän tai toiseen laitteeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuez une sauvegarde chiffrée des données de votre compte (Spaces, profils, contacts, groupes, click-to-call) qui pourra être restaurée sur cet appareil ou un autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצע גיבוי מוצפן של נתוני חשבון (\"Spaces\", פרופילים, אנשי קשר, \"click-to-call\") שניתן לשחזר למכשיר זה או למכשיר אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाता डेटा (\"Spaces\", प्रोफ़ाइल, संपर्क, \"click-to-call\") का एक एन्क्रिप्टेड बैकअप बनाएँ जिसे इस डिवाइस या किसी अन्य डिवाइस पर पुनर्स्थापित किया जा सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napravite šifriranu sigurnosnu kopiju podataka računa (prostori, profili, kontakti, grupe, click-to-call) koju je moguće obnoviti na ovaj ili drugi uređaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Készítsen titkosított biztonsági mentést a fiókadatairól (Spaces, profilok, névjegyek, csoportok, click-to-call), amely visszaállítható erre vagy egy másik eszközre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat cadangan terenkripsi untuk data akun (\"Spaces\", profil, kontak, kelompok, « click-to-call ») yang dapat dipulihkan ke perangkat ini atau perangkat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui un backup crittografato dei dati dell'account (\"Spaces\", profili, contatti, gruppi, click-to-call) che può essere ripristinato su questo dispositivo o su un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントデータ（「Spaces」、プロフィール、連絡先、グループ、「click-to-call」）の暗号化されたバックアップを作成します。このバックアップは、このデバイスまたは別のデバイスに復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 데이터(\"Spaces\", 프로필, 연락처, 여러 떼, « click-to-call »)를 암호화하여 이 기기 또는 다른 기기에 복원할 수 있는 백업을 만드세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag en kryptert sikkerhetskopi av kontodata (« Spaces », profiler, kontakter, \"click-to-call\") som kan gjenopprettes til denne enheten eller en annen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een versleutelde back-up van accountgegevens (\"Spaces\", profielen, contacten, groepen, « click-to-call ») die kan worden hersteld naar dit apparaat of een ander apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz zaszyfrowaną kopię zapasową danych konta („Spaces”, profile, kontakty, grupy, „click-to-call”), którą można przywrócić na to lub inne urządzenie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça um backup encriptado dos dados da conta (\"Spaces\", perfis, contactos, grupos, \"click-to-call\") que podem ser restaurados neste ou noutro dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creați o copie de rezervă criptată a datelor contului (Space-uri, profiluri, contacte, grupuri, click-to-call) care poate fi restaurată pe acest dispozitiv sau pe altul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте зашифрованную резервную копию данных учётной записи («Spaces», профили, контакты, группы, «Click-to-call»), которую можно будет восстановить на этом или другом устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte šifrovanú zálohu údajov účtu (priestory, profily, kontakty, skupiny, click-to-call), ktorú možno obnoviť na toto alebo iné zariadenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvarite šifrirano varnostno kopijo podatkov računa (prostori, profili, stiki, skupine, click-to-call), ki jo je mogoče obnoviti na to ali drugo napravo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bëni një kopje rezervë të enkriptuar të të dhënave të llogarisë (Spaces, profile, kontakte, grupet, click-to-call) që mund të rikthehet në këtë ose një pajisje tjetër."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napravite šifrovani bekap podataka naloga (prostori, profili, kontakti, grupe, click-to-call) koji može da se vrati na ovaj ili drugi uređaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör en krypterad säkerhetskopia av kontodata (\"Spaces\", profiler, kontakter, grupper, « click-to-call ») som kan återställas till den här enheten eller en annan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap verilerinizin (\"Spaces\", profiller, kişiler, gruplar, « click-to-call ») şifreli bir yedeğini oluşturun ve bu yedek bu cihaza veya başka bir cihaza geri yüklenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть зашифровану резервну копію даних облікового запису (простори, профілі, контакти, групи, функція дзвінка за посиланням), яку можна буде відновити на цьому або іншому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo bản sao lưu được mã hóa dữ liệu tài khoản (\"Spaces\", hồ sơ, danh bạ, các nhóm, \"click-to-call\") để có thể khôi phục sang thiết bị này hoặc thiết bị khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请对帐户数据（“Spaces”、个人资料、团体、 联系人、“click-to-call”）进行加密备份，以便将其恢复到此设备或其他设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
