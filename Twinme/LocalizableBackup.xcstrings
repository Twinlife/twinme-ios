        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמור את קובץ הגיבוי במכשיר שתבחר ושמור את הסיסמאות לשחזור מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप फ़ाइल को अपनी पसंद के डिवाइस पर सेव करें और बाद में पुनर्स्थापित करने के लिए पासवर्ड सुरक्षित रखें।"
