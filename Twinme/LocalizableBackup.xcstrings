          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification doit être effectuée sur le même appareil que celui utilisé pour la sauvegarde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבצע את האימות באותו מכשיר בו נעשה שימוש לגיבוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेरिफिकेशन उसी डिवाइस पर किया जाना चाहिए जिसका इस्तेमाल बैकअप के लिए किया गया था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
