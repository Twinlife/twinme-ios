        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأیید باید روی همان دستگاهی که برای پشتیبان‌گیری استفاده شده است، انجام شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
