    "backup_view_controller_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاستعادة النسخ الاحتياطي ، ستحتاج إلى إدخال 12 كلمة أعلاه في هذا الترتيب ، مما يسمح بفك تشفيرها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at gendanne sikkerhedskopien skal du indtaste de 12 ord ovenfor i denne rækkefølge, så den kan dekrypteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Backup wiederherzustellen, müssen Sie in dieser Reihenfolge die 12 oben genannten Wörter eingeben, sodass sie entschlüsselt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To restore the backup, you will need to enter the 12 words above in that order, allowing it to be decrypted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para restaurar la copia de seguridad, deberá ingresar las 12 palabras anteriores en ese orden, lo que permite descifrarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای بازگرداندن نسخه پشتیبان ، باید 12 کلمه فوق را به آن ترتیب وارد کنید و اجازه می دهد تا رمزگشایی شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopion palauttamiseksi sinun on syötettävä yllä olevat 12 sanaa siinä järjestyksessä, jolloin se voidaan purkaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour restaurer la sauvegarde, vous devrez saisir les 12 mots ci-dessus dans cet ordre, ce qui permettra de la déchiffrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לשחזר את הגיבוי, תצטרך להזין את 12 המילים שלמעלה בסדר הזה, ולאפשר לפענח אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप को पुनर्स्थापित करने के लिए, आपको उस क्रम में उपरोक्त 12 शब्दों को दर्ज करना होगा, जिससे यह डिक्रिप्ट किया जा सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengembalikan cadangan, Anda harus memasukkan 12 kata di atas dalam urutan itu, memungkinkannya untuk didekripsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ripristinare il backup, dovrai inserire le 12 parole sopra in quell'ordine, permettendogli di essere decrittografato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップを復元するには、その順序で上記の12語を入力して、復号化できるようにする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 복원하려면 위의 12 단어를 해당 순서대로 입력하여 해독 할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å gjenopprette sikkerhetskopien, må du oppgi de 12 ordene ovenfor i den rekkefølgen, slik at den kan dekrypteres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de back -up te herstellen, moet u in die volgorde de 12 woorden hierboven invoeren, waardoor deze kan worden gedecodeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przywrócić kopię zapasową, musisz wprowadzić 12 słów powyżej w tej kolejności, umożliwiając jej odszyfrowanie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para restaurar o backup, você precisará inserir as 12 palavras acima nessa ordem, permitindo que ela seja descriptografada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы восстановить резервную копию, вам нужно будет ввести 12 слов выше в этом порядке, что позволит ее расшифровать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att återställa säkerhetskopian måste du ange de 12 orden ovan i den ordningen, så att den kan dekrypteras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeklemeyi geri yüklemek için, yukarıdaki 12 kelimeyi bu sırayla girmeniz ve şifre çözülmesine izin vermeniz gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб відновити резервну копію, вам потрібно буде ввести 12 слів вище в такому порядку, дозволяючи його розшифрувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để khôi phục bản sao lưu, bạn cần nhập 12 từ ở trên theo thứ tự đó, cho phép giải mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要恢复备份，您将需要按该顺序输入上面的12个单词，以解密它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要恢復備份，您將需要按該順序輸入上面的12個單詞，以解密它。"
          }
        }
      }
    },
