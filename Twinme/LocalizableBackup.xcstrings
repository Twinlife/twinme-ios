    "backup_view_controller_save_file_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ ملف النسخة الاحتياطية على الجهاز الذي تختاره، واحتفظ بكلمات المرور لاستعادتها لاحقًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem sikkerhedskopifilen på den valgte enhed, og gem adgangskoderne til senere gendannelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie die Backup-Datei auf dem Gerät Ihrer Wahl und bewahren Sie die Passwörter für eine spätere Wiederherstellung auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the backup file to the device of your choice and keep the passwords for later restoration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la copia de seguridad en el dispositivo que prefieras y conserva las contraseñas para restaurarlas posteriormente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایل پشتیبان را در دستگاه مورد نظر خود ذخیره کنید و رمزهای عبور را برای بازیابی بعدی نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna varmuuskopiotiedosto haluamallesi laitteelle ja säilytä salasanat myöhempää palautusta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
