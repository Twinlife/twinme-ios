        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedskopier inkluderer ikke samtaler, notifikationer og historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen enthalten keine Unterhaltungen, Benachrichtigungen und keinen Verlauf."
