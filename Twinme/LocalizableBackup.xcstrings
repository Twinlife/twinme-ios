    "restore_view_verify_same_account" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إجراء التحقق على نفس الجهاز المستخدم في النسخ الاحتياطي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверката трябва да бъде извършена на същото устройство, използвано за архива."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověření musí být provedeno na stejném zařízení použitém pro zálohu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekræftelsen skal udføres på den samme enhed, der bruges til sikkerhedskopieringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
