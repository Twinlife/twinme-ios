    "backup_view_controller_verify_words" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتحقق من النسخة الاحتياطية، أدخل تسلسل الكلمات المكون من ١٢ كلمة لفك تشفيرها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at bekræfte en sikkerhedskopi skal du indtaste 12-ordssekvensen for at dekryptere den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ein Backup zu verifizieren, geben Sie die 12-Wörter-Sequenz zur Entschlüsselung ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To verify a backup, you need to enter the 12-word sequence to decrypt it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para verificar una copia de seguridad, debe ingresar la secuencia de 12 palabras para descifrarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تأیید نسخه پشتیبان، باید دنباله ۱۲ کلمه‌ای را برای رمزگشایی آن وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvistaaksesi varmuuskopion sinun on annettava 12 sanan sarja sen salauksen purkamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vérifier une sauvegarde, vous devez saisir la séquence de 12 mots pour la déchiffrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לאמת גיבוי, עליך להזין את רצף 12 המילים כדי לפענח אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप सत्यापित करने के लिए, आपको इसे डिक्रिप्ट करने के लिए 12-शब्द अनुक्रम दर्ज करना होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memverifikasi cadangan, Anda perlu memasukkan urutan 12 kata untuk mendekripsinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per verificare un backup, devi inserire la sequenza di 12 parole per decrittografarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップを確認するには、12語の文字列を入力して復号する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 확인하려면 12단어 시퀀스를 입력하여 암호를 해독해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å bekrefte en sikkerhetskopi må du skrive inn 12-ordssekvensen for å dekryptere den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een ​​back-up te verifiëren, moet u de reeks van 12 woorden invoeren om deze te ontsleutelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zweryfikować kopię zapasową, musisz wprowadzić 12-wyrazową sekwencję, aby ją odszyfrować."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para verificar um backup, precisa de introduzir a sequência de 12 palavras para o desencriptar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для проверки резервной копии необходимо ввести последовательность из 12 слов для её расшифровки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att verifiera en säkerhetskopia måste du ange 12-ordssekvensen för att dekryptera den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yedeklemeyi doğrulamak için, şifresini çözmek üzere 12 kelimelik diziyi girmeniz gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб перевірити резервну копію, потрібно ввести послідовність із 12 слів для її розшифрування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để xác minh bản sao lưu, bạn cần nhập chuỗi 12 từ để giải mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要验证备份，您需要输入 12 个单词的序列来解密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要驗證備份，您需要輸入 12 個單字的序列來解密。"
          }
        }
      }
    },
