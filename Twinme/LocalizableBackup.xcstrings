          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请对帐户数据（“Spaces”、个人资料、联系人、“click-to-call”）进行加密备份，以便将其恢复到此设备或其他设备。"
