    "backup_view_verify_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك أيضًا التحقق من سلامة ملف النسخة الاحتياطية، وما إذا كانت البيانات التي يحتوي عليها محدثة من: الحساب/التحقق من النسخة الاحتياطية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете също да проверите целостта на архивен файл и дали данните в него са актуални от: Акаунт/Проверка на архив."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete také zkontrolovat integritu souboru zálohy a zda jsou v něm obsažená data aktuální pomocí: Účet/Ověřit zálohu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan også kontrollere integriteten af ​​en sikkerhedskopifil og om de data, den indeholder, er opdaterede fra: Konto/Bekræft en sikkerhedskopi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können die Integrität einer Sicherungsdatei und die Aktualität der darin enthaltenen Daten auch prüfen unter: Konto/Eine Sicherung verifizieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε επίσης να ελέγξετε την ακεραιότητα ενός αρχείου αντιγράφου ασφαλείας και αν τα δεδομένα που περιέχει είναι ενημερωμένα από: Λογαριασμός/Επαλήθευση αντιγράφου ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also check the integrity of a backup file and whether the data it contains is up-to-date from: Account/Verify a backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes comprobar la integridad de una copia de seguridad y si los datos que contiene están actualizados desde: Cuenta/Verificar copia de seguridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همچنین می‌توانید از طریق حساب کاربری/تأیید نسخه پشتیبان، صحت فایل پشتیبان و به‌روز بودن داده‌های موجود در آن را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit myös tarkistaa varmuuskopiotiedoston eheyden ja sen sisältämien tietojen ajantasaisuuden kohdasta: Tili/Vahvista varmuuskopio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez également vérifier l'intégrité d'un fichier de sauvegarde et la mise à jour de ses données depuis : Compte/Vérifier une sauvegarde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוכל גם לבדוק את תקינות קובץ הגיבוי והאם הנתונים שהוא מכיל מעודכנים מ: חשבון/אמת גיבוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बैकअप फ़ाइल की विश्वसनीयता और उसमें मौजूद डेटा के अप-टू-डेट होने की जाँच निम्न माध्यम से भी कर सकते हैं: खाता/बैकअप सत्यापित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Također možete provjeriti cjelovitost datoteke sigurnosne kopije i jesu li podaci u njoj ažurni putem: Račun/Provjeri sigurnosnu kopiju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonsági mentés fájljának integritását és a benne lévő adatok naprakészségét is ellenőrizheti itt: Fiók/Biztonsági mentés ellenőrzése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda juga dapat memeriksa integritas berkas cadangan dan apakah data di dalamnya mutakhir dari: Akun/Verifikasi cadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi anche verificare l'integrità di un file di backup e se i dati in esso contenuti sono aggiornati da: Account/Verifica un backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "また、「アカウント」>「バックアップを確認」から、バックアップファイルの整合性とデータが最新かどうかを確認することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정/백업 확인을 통해 백업 파일의 무결성과 포함된 데이터가 최신 상태인지 확인할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan også sjekke integriteten til en sikkerhetskopifil og om dataene den inneholder er oppdaterte fra: Konto/Bekreft en sikkerhetskopi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt ook de integriteit van een back-upbestand en de actualiteit van de gegevens controleren via: Account/Een back-up verifiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz również sprawdzić integralność pliku kopii zapasowej i to, czy zawarte w nim dane są aktualne, korzystając z opcji: Konto/Weryfikacja kopii zapasowej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também pode verificar a integridade de um ficheiro de cópia de segurança e se os dados nele contidos estão atualizados em: Conta/Verificar uma cópia de segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puteți verifica și integritatea unui fișier de backup și dacă datele pe care le conține sunt actualizate din: Cont/Verifică o copie de rezervă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы также можете проверить целостность файла резервной копии и актуальность содержащихся в нём данных, выбрав «Учётная запись»/«Проверка резервной копии»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môžete tiež skontrolovať integritu súboru zálohy a či sú údaje v ňom aktuálne z: Účet/Overiť zálohu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preverite lahko tudi celovitost varnostne datoteke in ali so podatki v njej posodobljeni prek: Račun/Preveri varnostno kopijo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mund të kontrolloni gjithashtu integritetin e një skedari rezervë dhe nëse të dhënat që përmban janë të përditësuara nga: Llogaria/Verifiko një kopje rezervë."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takođe možete da proverite integritet fajla bekapa i da li su podaci u njemu ažurni iz: Nalog/Proveri bekap."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan också kontrollera integriteten för en säkerhetskopia och om informationen den innehåller är uppdaterad från: Konto/Verifiera en säkerhetskopia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca, bir yedekleme dosyasının bütünlüğünü ve içerdiği verilerin güncel olup olmadığını şuradan kontrol edebilirsiniz: Hesap/Yedeklemeyi doğrula."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви також можете перевірити цілісність файлу резервної копії та актуальність даних, які він містить, за допомогою: Обліковий запис/Перевірити резервну копію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cũng có thể kiểm tra tính toàn vẹn của tệp sao lưu và xem dữ liệu trong đó có được cập nhật hay không bằng cách: Tài khoản/Xác minh bản sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您还可以通过以下方式检查备份文件的完整性以及其中包含的数据是否为最新：帐户/验证备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您也可以透過以下方式檢查備份檔案的完整性以及其中包含的資料是否為最新：帳戶/驗證備份。"
          }
        }
      }
    },
