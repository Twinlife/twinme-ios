        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेरिफिकेशन उसी डिवाइस पर किया जाना चाहिए जिसका इस्तेमाल बैकअप के लिए किया गया था।"
          }
        },
        "id" : {
