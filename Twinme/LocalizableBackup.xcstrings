        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть файл резервної копії на вибраному пристрої та збережіть паролі для подальшого відновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
