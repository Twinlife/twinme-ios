    "backup_view_beta_message_part_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تهدف هذه الخدمة إلى نسخ بيانات الحساب الوصفية فقط (الملفات الشخصية، جهات الاتصال، المجموعات) إلى وحدة تخزين خارجية، بحيث يمكن استعادتها لاحقًا على جهاز آخر في حال سرقة الجهاز الأصلي أو تلفه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тази услуга е предназначена да архивира само метаданни на акаунта (профили, контакти, групи) във външно хранилище, за да могат по-късно да бъдат възстановени на друго устройство, ако оригиналът бъде откраднат или унищожен."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato služba je určena pouze k zálohování metadat účtu (profily, kontakty, skupiny) do externího úložiště, aby je bylo možné později obnovit na jiném zařízení, pokud je původní ukradeno nebo zničeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tjeneste er beregnet til kun at sikkerhedskopiere kontometadata (profiler, kontakter, grupper) til ekstern lagring, så de kan gendannes senere på en anden enhed, hvis originalen bliver stjålet eller ødelagt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
