    "restore_view_backup_device_always_signed_in_part_three" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت ترغب في نقل حسابك إلى جهاز جديد، ولا يزال لديك الجهاز القديم، فمن الأفضل استخدام عملية \"نقل الحساب\" بدلاً من استعادة نسخة احتياطية، لأنها ستنقل أيضًا المحادثات والإشعارات والسجل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако искате да прехвърлите акаунта си на ново устройство и все още имате стария, за предпочитане е да използвате операцията „миграция на акаунт“, вместо да възстановявате резервно копие, тъй като това ще прехвърли и разговори, известия и история."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chcete přenést účet na nové zařízení a stále máte staré, je vhodnější použít operaci \\\"migrace účtu\\\" namísto obnovení zálohy, protože přenese také konverzace, oznámení a historii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil overføre din konto til en ny enhed, og du stadig har den gamle, er det at foretrække at bruge \"kontomigrering\"-handlingen i stedet for at gendanne en sikkerhedskopi, da det også vil overføre samtaler, notifikationer og historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihr Konto auf ein neues Gerät übertragen möchten und das alte Gerät noch besitzen, ist es besser, die „Kontomigration“ zu nutzen, anstatt eine Sicherung wiederherzustellen. Dabei werden auch Unterhaltungen, Benachrichtigungen und der Verlauf übertragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν θέλετε να μεταφέρετε τον λογαριασμό σας σε μια νέα συσκευή και εξακολουθείτε να έχετε την παλιά, είναι προτιμότερο να χρησιμοποιήσετε τη λειτουργία \"μετεγκατάσταση λογαριασμού\" αντί να επαναφέρετε ένα αντίγραφο ασφαλείας, καθώς θα μεταφέρει επίσης συνομιλίες, ειδοποιήσεις και ιστορικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want to transfer your account to a new device, and you still have the old one, it is preferable to use the \"account migration\" operation, rather than restoring a backup, as it will also transfer conversations, notifications, and history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si desea transferir su cuenta a un nuevo dispositivo y aún conserva el antiguo, es preferible usar la operación de \"migración de cuenta\" en lugar de restaurar una copia de seguridad, ya que también se transferirán las conversaciones, las notificaciones y el historial."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر می‌خواهید حساب خود را به دستگاه جدیدی منتقل کنید و هنوز دستگاه قدیمی خود را دارید، ترجیحاً از عملیات «انتقال حساب» به جای بازیابی نسخه پشتیبان استفاده کنید، زیرا این کار مکالمات، اعلان‌ها و تاریخچه را نیز منتقل می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat siirtää tilisi uudelle laitteelle ja sinulla on vielä vanha laite, on parempi käyttää \"tilin siirtoa\" varmuuskopion palauttamisen sijaan, koska se siirtää myös keskustelut, ilmoitukset ja historian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous souhaitez transférer votre compte vers un nouvel appareil et que vous possédez toujours l'ancien, il est préférable d'utiliser la « migration de compte » plutôt que de restaurer une sauvegarde, car elle transférera également les conversations, les notifications et l'historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ברצונך להעביר את החשבון שלך למכשיר חדש, ועדיין יש לך את הישן, עדיף להשתמש בפעולת \"העברת חשבון\", במקום שחזור גיבוי, מכיוון שהיא תעביר גם שיחות, התראות והיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप अपना अकाउंट किसी नए डिवाइस पर ट्रांसफर करना चाहते हैं, और आपके पास अभी भी पुराना डिवाइस है, तो बैकअप रिस्टोर करने के बजाय \"अकाउंट माइग्रेशन\" ऑपरेशन का इस्तेमाल करना बेहतर है, क्योंकि इससे बातचीत, नोटिफ़िकेशन और हिस्ट्री भी ट्रांसफर हो जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako želite prenijeti svoj račun na novi uređaj i još uvijek imate stari, preporučljivo je koristiti operaciju \\\"migracije računa\\\" umjesto obnove sigurnosne kopije, jer će ona također prenijeti razgovore, obavijesti i povijest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a fiókját új eszközre szeretné átvinni, és még megvan a régi, akkor célszerűbb a \\\"fiókmigráció\\\" műveletet használni a biztonsági mentés visszaállítása helyett, mert az a beszélgetéseket, értesítéseket és előzményeket is átviszi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda ingin mentransfer akun ke perangkat baru, dan Anda masih memiliki perangkat lama, sebaiknya gunakan operasi \"migrasi akun\", daripada memulihkan cadangan, karena tindakan ini juga akan mentransfer percakapan, notifikasi, dan riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desideri trasferire il tuo account su un nuovo dispositivo e hai ancora quello vecchio, è preferibile utilizzare l'operazione di \"migrazione dell'account\", piuttosto che ripristinare un backup, poiché trasferirà anche conversazioni, notifiche e cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを新しいデバイスに移行したい場合で、古いデバイスがまだ手元にある場合は、バックアップを復元するよりも「アカウント移行」操作を使用することをお勧めします。アカウント移行では、会話、通知、履歴も転送されるためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 기기를 유지하면서 계정을 새 기기로 이전하고 싶다면, 백업 복원보다는 \"계정 마이그레이션\" 기능을 사용하는 것이 좋습니다. 계정 마이그레이션을 사용하면 대화 내용, 알림, 사용 기록까지 모두 이전되기 때문입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil overføre kontoen din til en ny enhet, og du fortsatt har den gamle, er det å foretrekke å bruke \"kontomigrering\"-operasjonen i stedet for å gjenopprette en sikkerhetskopi, da det også vil overføre samtaler, varsler og historikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u uw account wilt overzetten naar een nieuw apparaat en u nog steeds het oude hebt, is het beter om de bewerking \"Accountmigratie\" te gebruiken in plaats van een back-up te herstellen, omdat hiermee ook gesprekken, meldingen en geschiedenis worden overgezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli chcesz przenieść swoje konto na nowe urządzenie, a nadal masz stare, lepiej skorzystać z operacji „migracji konta” niż przywracać kopię zapasową, ponieważ spowoduje to również przeniesienie rozmów, powiadomień i historii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quiser transferir a sua conta para um novo dispositivo e ainda tiver a antiga, é preferível utilizar a operação de \"migração de conta\" em vez de restaurar uma cópia de segurança, pois esta também irá transferir conversas, notificações e histórico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă doriți să vă transferați contul pe un dispozitiv nou și îl aveți încă pe cel vechi, este de preferat să folosiți operațiunea \\\"migrare cont\\\" în locul restaurării unei copii de rezervă, deoarece va transfera și conversațiile, notificările și istoricul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы хотите перенести свою учётную запись на новое устройство, а старая у вас осталась, предпочтительнее использовать операцию «миграция учётной записи», а не восстановление резервной копии, так как при этом также будут перенесены беседы, уведомления и история."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete preniesť svoj účet na nové zariadenie a stále máte staré, je vhodnejšie použiť operáciu \\\"migrácie účtu\\\" namiesto obnovenia zálohy, pretože prenesie aj konverzácie, oznámenia a históriu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite prenesti svoj račun na novo napravo in imate še staro, je bolje uporabiti operacijo \\\"migracije računa\\\" namesto obnove varnostne kopije, saj bo prenesla tudi pogovore, obvestila in zgodovino."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nëse dëshironi ta transferoni llogarinë tuaj në një pajisje të re dhe ende e keni të vjetrën, është më mirë të përdorni veprimin \\\"migrim llogarie\\\" në vend të rikthimit të një kopjeje rezervë, pasi do të transferojë gjithashtu bisedat, njoftimet dhe historikun."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako želite da prenesete svoj nalog na novi uređaj, a i dalje imate stari, preporučljivo je da koristite operaciju \\\"migracije naloga\\\" umesto vraćanja bekapa, jer će ona takođe preneti razgovore, obaveštenja i istoriju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill överföra ditt konto till en ny enhet och du fortfarande har den gamla är det att föredra att använda åtgärden \"kontomigrering\" snarare än att återställa en säkerhetskopia, eftersom det också kommer att överföra konversationer, aviseringar och historik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı yeni bir cihaza aktarmak istiyorsanız ve hala eski hesabınız varsa, yedeklemeyi geri yüklemek yerine \"hesap taşıma\" işlemini kullanmanız tercih edilir, çünkü bu işlem konuşmaları, bildirimleri ve geçmişi de aktarır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви хочете перенести свій обліковий запис на новий пристрій, а у вас все ще є старий, краще використовувати операцію \"міграції облікового запису\", ніж відновлення резервної копії, оскільки це також перенесе розмови, сповіщення та історію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn muốn chuyển tài khoản sang thiết bị mới mà vẫn còn thiết bị cũ, tốt hơn hết là nên sử dụng thao tác \"chuyển đổi tài khoản\" thay vì khôi phục bản sao lưu, vì thao tác này cũng sẽ chuyển cả các cuộc trò chuyện, thông báo và lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想将帐户转移到新设备，并且您仍然保留着旧设备，则最好使用“帐户迁移”操作，而不是恢复备份，因为它还会转移对话、通知和历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想將帳戶轉移到新設備，並且您仍然保留舊設備，則最好使用「帳戶遷移」操作，而不是恢復備份，因為它還會轉移對話、通知和歷史記錄。"
          }
        }
      }
    },
    "restore_view_backup_device_always_signed_in_part_two" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في حال استعادة النسخة الاحتياطية إلى هذا الجهاز الجديد، سيتم إلغاء حساب الجهاز الذي أجريت عليه النسخة الاحتياطية تلقائيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако възстановите архива на това ново устройство, акаунтът на устройството, на което е направен архивът, ще бъде автоматично обезсилен."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud obnovíte zálohu na toto nové zařízení, účet zařízení, na kterém byla záloha vytvořena, bude automaticky zneplatněn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du gendanner sikkerhedskopien til denne nye enhed, bliver kontoen på den enhed, hvor sikkerhedskopien blev foretaget, automatisk ugyldiggjort."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Sicherung auf diesem neuen Gerät wiederherstellen, wird das Konto auf dem Gerät, auf dem das Backup erstellt wurde, automatisch ungültig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν επαναφέρετε το αντίγραφο ασφαλείας σε αυτή τη νέα συσκευή, ο λογαριασμός της συσκευής στην οποία δημιουργήθηκε το αντίγραφο ασφαλείας θα καταστεί αυτόματα άκυρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you restore the backup to this new device, the account of the device on which the backup was made will be automatically invalidated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si restauras la copia de seguridad en este nuevo dispositivo, la cuenta del dispositivo en el que se realizó la copia de seguridad se invalidará automáticamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر نسخه پشتیبان را در این دستگاه جدید بازیابی کنید، حساب دستگاهی که نسخه پشتیبان در آن ایجاد شده است، به"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos palautat varmuuskopion tälle uudelle laitteelle, laitteen tili, jolla varmuuskopio tehtiin, mitätöidään automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous restaurez la sauvegarde sur ce nouvel appareil, le compte de l'appareil sur lequel la sauvegarde a été effectuée sera automatiquement invalidé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם תשחזר את הגיבוי למכשיר החדש, החשבון של המכשיר שבו בוצע הגיבוי יבוטל אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप इस नए डिवाइस पर बैकअप पुनर्स्थापित करते हैं, तो जिस डिवाइस पर बैकअप बनाया गया था उसका खाता स्वतः ही अमान्य हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako obnovite sigurnosnu kopiju na ovom novom uređaju, račun uređaja na kojem je sigurnosna kopija napravljena bit će automatski poništen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a biztonsági mentést erre az új eszközre állítja vissza, a mentést készítő eszköz fiókja automatikusan érvénytelenné válik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda memulihkan cadangan ke perangkat baru ini, akun perangkat tempat cadangan dibuat akan otomatis dinonaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ripristini il backup su questo nuovo dispositivo, l'account del dispositivo su cui è stato effettuato il backup verrà automaticamente invalidato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この新しいデバイスにバックアップを復元すると、バックアップを作成したデバイスのアカウントは自動的に無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 새 기기에 백업을 복원하면 백업이 생성된 기기의 계정이 자동으로 무효화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du gjenoppretter sikkerhetskopien til denne nye enheten, blir kontoen til enheten som sikkerhetskopien ble gjort på automatisk ugyldig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u de back-up herstelt naar dit nieuwe apparaat, wordt het account van het apparaat waarop de back-up is gemaakt, automatisch ongeldig gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli przywrócisz kopię zapasową na to nowe urządzenie, konto urządzenia, na którym została utworzona, zostanie automatycznie unieważnione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restaurar o backup neste novo dispositivo, a conta do dispositivo no qual o backup foi feito será automaticamente invalidada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă restaurați copia de rezervă pe acest dispozitiv nou, contul dispozitivului pe care a fost făcută copia de rezervă va fi invalidat automat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы восстановите резервную копию на этом новом устройстве, учётная запись устройства, на котором была создана резервная копия, будет автоматически аннулирована. "
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak obnovíte zálohu na toto nové zariadenie, účet zariadenia, na ktorom bola záloha vytvorená, bude automaticky zneplatnený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če obnovite varnostno kopijo na to novo napravo, bo račun naprave, na kateri je bila varnostna kopija narejena, samodejno razveljavljen."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nëse e riktheni kopjen rezervë në këtë pajisje të re, llogaria e pajisjes në të cilën u bë kopja rezervë do të çaktivizohet automatikisht."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako vratite bekap na ovaj novi uređaj, nalog uređaja na kojem je bekap napravljen biće automatski poništen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du återställer säkerhetskopian till den här nya enheten kommer kontot för den enhet som säkerhetskopian gjordes på att automatiskt ogiltigförklaras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeklemeyi bu yeni cihaza geri yüklerseniz, yedeklemenin yapıldığı cihazın hesabı otomatik olarak geçersiz kılınır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви відновите резервну копію на цьому новому пристрої, обліковий запис пристрою, на якому було створено резервну копію, буде автоматично анульовано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn khôi phục bản sao lưu sang thiết bị mới này, tài khoản của thiết bị đã tạo bản sao lưu sẽ tự động bị vô hiệu hóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您将备份恢复到此新设备，则进行备份的设备的帐户将自动失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您將備份還原到此新設備，則進行備份的設備的帳戶將自動失效。"
          }
        }
      }
    },
    "restore_view_confirm" : {
      "comment" : "RestoreViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من أنك تريد استبدال بيانات الحساب الجاري بالبيانات التالية من النسخ الاحتياطي؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурни ли сте, че искате да замените текущите данни на акаунта със следните данни от архива?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jisti, že chcete nahradit aktuální data účtu následujícími daty ze zálohy?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil udskifte de løbende kontodata med følgende data fra sikkerhedskopien?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie die aktuellen Kontodaten durch die folgenden Daten aus der Sicherung ersetzen möchten?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε βέβαιοι ότι θέλετε να αντικαταστήσετε τα τρέχοντα δεδομένα λογαριασμού με τα ακόλουθα δεδομένα από το αντίγραφο ασφαλείας;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to replace the current account data with the following data from the backup?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está seguro de que desea reemplazar los datos de la cuenta corriente con los siguientes datos de la copia de seguridad?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئن هستید که می خواهید داده های حساب جاری را با داده های زیر از نسخه پشتیبان جایگزین کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko varma, että haluat korvata nykyiset tilitiedot seuraavilla varmuuskopioilla olevilla tiedoilla?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir remplacer les données actuelles du compte par les données suivantes de la sauvegarde ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שאתה רוצה להחליף את נתוני החשבון הנוכחי בנתונים הבאים מהגיבוי?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप सुनिश्चित हैं कि आप बैकअप से निम्न डेटा के साथ चालू खाता डेटा को बदलना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeste li sigurni da želite zamijeniti trenutne podatke računa sljedećim podacima iz sigurnosne kopije?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan ki szeretné cserélni a jelenlegi fiókadatokat a biztonsági mentés alábbi adataira?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda yakin ingin mengganti data akun saat ini dengan data berikut dari cadangan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler sostituire i dati dell'account corrente con i seguenti dati dal backup?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアカウントデータをバックアップの次のデータに置き換えたいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 계정 데이터를 백업의 다음 데이터로 바꾸려고합니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil erstatte driftsdataene med følgende data fra sikkerhetskopien?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet u zeker dat u de huidige accountgegevens wilt vervangen door de volgende gegevens van de back -up?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz zastąpić dane o koncie bieżącym następującymi danymi z kopii zapasowej?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja substituir os dados da conta corrente pelos seguintes dados do backup?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigur doriți să înlocuiți datele curente ale contului cu următoarele date din copia de rezervă?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите заменить текущие данные учетной записи следующими данными из резервной копии?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ste si istí, že chcete nahradiť aktuálne údaje účtu nasledujúcimi údajmi zo zálohy?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali ste prepričani, da želite zamenjati trenutne podatke računa z naslednjimi podatki iz varnostne kopije?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jeni i sigurt që dëshironi t\\'i zëvendësoni të dhënat aktuale të llogarisë me të dhënat e mëposhtme nga kopja rezervë?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da li ste sigurni da želite da zamenite trenutne podatke naloga sledećim podacima iz bekapa?"
          }
