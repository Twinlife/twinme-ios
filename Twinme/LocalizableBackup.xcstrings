    "restore_view_controller_verify_same_account" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إجراء التحقق على نفس الجهاز المستخدم في النسخ الاحتياطي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
