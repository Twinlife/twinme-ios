    "backup_view_controller_security_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تمثيل مفتاح التشفير الاحتياطي بسلسلة من 12 كلمة ستكون ضرورية للاستعادة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup -krypteringsnøglen er repræsenteret af en serie på 12 ord, der kræves til restaurering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
