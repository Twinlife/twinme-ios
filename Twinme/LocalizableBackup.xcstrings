          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de cifrado de respaldo está representada por una serie de 12 palabras que se requerirán para la restauración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید رمزگذاری پشتیبان توسط یک سری از 12 کلمه نشان داده شده است که برای ترمیم مورد نیاز است."
