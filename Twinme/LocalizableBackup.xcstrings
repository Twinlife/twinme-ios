    "restore_view_controller_content_profile_reset_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز الدعوة المرتبط بالملف الشخصي الذي تم نسخه احتياطيًا غير صالح. سيتم إنشاء رمز دعوة جديد أثناء عملية الاستعادة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitationskoden knyttet til den sikkerhedskopierede profil er ugyldig. En ny invitationskode genereres under gendannelsesprocessen."
