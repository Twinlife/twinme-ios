    "backup_view_verify_words" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتحقق من النسخة الاحتياطية، أدخل تسلسل الكلمات المكون من ١٢ كلمة لفك تشفيرها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да проверите архив, трябва да въведете последователността от 12 думи, за да го декриптирате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K ověření zálohy je třeba zadat sekvenci 12 slov, aby ji bylo možné dešifrovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at bekræfte en sikkerhedskopi skal du indtaste 12-ordssekvensen for at dekryptere den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um eine Sicherung zu verifizieren, müssen Sie die 12-Wörter-Sequenz zur Entschlüsselung eingeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να επαληθεύσετε ένα αντίγραφο ασφαλείας, πρέπει να εισαγάγετε τη σειρά των 12 λέξεων για να το αποκρυπτογραφήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To verify a backup, you need to enter the 12-word sequence to decrypt it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para verificar una copia de seguridad, debe ingresar la secuencia de 12 palabras para descifrarla."
