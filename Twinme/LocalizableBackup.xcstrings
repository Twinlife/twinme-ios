    "backup_view_content_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تشمل النسخ الاحتياطية المحادثات والإشعارات وسجل التصفح."
          }
        },
        "bg" : {
          "stringUnit" : {
