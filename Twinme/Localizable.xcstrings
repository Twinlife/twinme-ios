    "add_contact_view_share_message_part_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred هي خدمة مراسلة مشفرة من طرف إلى طرف من نظير إلى نظير تسمح بإجراء مكالمات صوتية/مرئية عالية الدقة (HD). لا يتطلب التسجيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred е peer-to-peer услуга за съобщения с крайно криптиране и HD гласови/видео разговори. Не е необходима регистрация."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred je peer-to-peer služba pro zasílání zpráv s end-to-end šifrováním a HD hlasovými/video hovory. Není nutná registrace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred er en peer-to-peer end-to-end krypteret beskedtjeneste og High-Definition (HD) tale-/videoopkald. Ingen registrering er påkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred ist ein Peer-to-Peer Ende-zu-Ende verschlüsselter Messaging-Dienst und High-Definition (HD) Sprach-/Videoanrufe. Keine Registrierung erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Skred είναι μια peer-to-peer υπηρεσία ανταλλαγής μηνυμάτων με κρυπτογράφηση από άκρο σε άκρο και κλήσεις φωνής/βίντεο HD. Δεν απαιτείται εγγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred is a peer-to-peer end-to-end encrypted messaging service and High-Definition (HD) voice/video calls. No registration is required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred es un servicio de mensajería peer-to-peer con cifrado de extremo a extremo y llamadas de voz/video de alta definición (HD). No es necesario registrarse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred یک سرویس پیام‌رسانی رمزگذاری‌شده‌ی سرتاسری و همتا به همتا و تماس‌های صوتی/تصویری با کیفیت بالا (HD) است. نیازی به ثبت‌نام نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred on vertaisverkon kautta salattu viestintäpalvelu ja teräväpiirtoääni-/videopuhelut. Rekisteröitymistä ei vaadita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred est une messagerie en peer-to-peer chiffrée de bout en bout, permettant les appels audio/vidéo en haute définition (HD). Aucune inscription n'est requise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred הוא שירות הודעות מוצפן מקצה לקצה של עמית לעמית ושיחות קול/וידאו באיכות High-Definition (HD). אין צורך ברישום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
