    "fullscreen_qrcode_view_generate_code_message" : {
      "comment" : "FullScreenQRCodeViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا الإجراء إلى إبطال رمز الدعوة الحالي المرتبط بهذا التشكيل الجانبي. هل تريد بالتأكيد إنشاء رمز جديد؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това действие анулира текущия код за покана, свързан с този профил. Сигурни ли сте, че искате да генерирате нов код?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato akce zneplatní aktuální pozvánkový kód přiřazený tomuto profilu. Opravdu chcete vygenerovat nový kód?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne handling ugyldiggør den aktuelle invitationskode, der er knyttet til denne profil. Er du sikker på, at du vil generere en ny kode?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion macht den aktuellen Einladungscode, der mit diesem Profil verknüpft ist, ungültig. Sind Sie sicher, dass Sie einen neuen Code generieren möchten?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ενέργεια ακυρώνει τον τρέχοντα κωδικό πρόσκλησης που σχετίζεται με αυτό το προφίλ. Θέλετε να δημιουργήσετε νέο κωδικό;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This action invalidates the current invitation code associated with this profile. Are you sure you want to generate a new code?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción invalida el código de invitación actual asociado con este perfil. ¿Seguro que quieres generar un nuevo código?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این عملکرد کد دعوت فعلی مرتبط با این نمایه را باطل می کند. آیا مطمئن هستید که می خواهید یک کد جدید تولید کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä toimenpide mitätöi tämän profiilin nykyisen kutsukoodin. Haluatko varmasti luoda uuden koodin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action invalide le code d’invitation actuel associé à ce profil. Voulez-vous vraiment générer un nouveau code ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו מבטלת את קוד ההזמנה הנוכחי המשויך לפרופיל זה. האם אכן ליצור קוד חדש?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह क्रिया इस प्रोफ़ाइल से संबद्ध वर्तमान आमंत्रण कोड को अमान्य कर देती है। क्या आप वाकई एक नया कोड बनाना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova radnja poništava trenutni pozivni kôd povezan s ovim profilom. Jeste li sigurni da želite generirati novi kôd?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a művelet érvényteleníti az ehhez a profilhoz tartozó jelenlegi meghívókódot. Biztosan szeretnél új kódot generálni?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini membatalkan kode undangan saat ini yang terkait dengan profil ini. Anda yakin ingin membuat kode baru?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione annulla il codice di invito corrente associato a questo profilo. Sei sicuro di voler generare un nuovo codice?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作により、このプロファイルに関連付けられている現在の招待コードが無効になります。新しいコードを生成してもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 조치는이 프로파일과 연관된 현재 초대 코드를 무효화합니다. 새 코드를 생성 하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne handlingen ugyldiggjør den gjeldende invitasjonskoden tilknyttet denne profilen. Er du sikker på at du vil generere en ny kode?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze actie maakt de huidige uitnodigingscode die aan dit profiel is gekoppeld ongeldig. Weet u zeker dat u een nieuwe code wilt genereren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta czynność unieważnia bieżący kod zaproszenia powiązany z tym profilem. Czy na pewno chcesz wygenerować nowy kod?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar na galeria de fotos"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această acțiune invalidează codul actual de invitație asociat acestui profil. Sigur doriți să generați un cod nou?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это действие делает недействительным текущий код приглашения, связанный с этим профилем. Вы уверены, что хотите создать новый код?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto akcia zneplatní aktuálny pozývací kód priradený k tomuto profilu. Ste si istí, že chcete vytvoriť nový kód?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To dejanje razveljavi trenutno kodo povabila, povezano s tem profilom. Ali ste prepričani, da želite ustvariti novo kodo?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ky veprim e bën të pavlefshëm kodin aktual të ftesës të lidhur me këtë profil. A jeni i sigurt që dëshironi të gjeneroni një kod të ri?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova radnja poništava trenutni pozivni kod povezan sa ovim profilom. Da li ste sigurni da želite da generišete novi kod?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här åtgärden ogiltar den aktuella inbjudningskoden som är kopplad till den här profilen. Är du säker på att du vill skapa en ny kod?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, bu profille ilişkili geçerli davet kodunu geçersiz kılar. Yeni bir kod oluşturmak istediğinizden emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця дія анулює поточний код запрошення, пов’язаний з цим профілем. Ви дійсно хочете створити новий код?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ vô hiệu hóa mã mời hiện tại liên kết với hồ sơ này. Bạn có chắc muốn tạo mã mới không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会使与此个人资料关联的当前邀请代码无效。 您确定要生成新代码吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作會使與此個人資料關聯的當前邀請代碼無效。 您確定要生成新代碼嗎？"
          }
        }
      }
    },
