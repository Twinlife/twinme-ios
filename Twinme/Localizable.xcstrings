    "account_migration_view_cancel_message" : {
      "comment" : "AccountMigrationViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق التطبيق وأعد تشغيله للوصول إلى بياناتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затворете приложението и го стартирайте отново, за да получите достъп до вашите данни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavřete aplikaci a restartujte ji pro přístup k vašim datům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luk applikationen, og genstart den for at få adgang til dine data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie die Anwendung und starten Sie sie neu, um auf Ihre Daten zuzugreifen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείστε την εφαρμογή και επανεκκινήστε την για πρόσβαση στα δεδομένα σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close the application and restart it to access your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierre la aplicación y reiníciela para acceder a sus datos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه را ببندید و دوباره راه اندازی کنید تا به داده های خود دسترسی پیدا کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulje sovellus ja käynnistä se uudelleen päästäksesi tietoihisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermez l’application et redémarrez la pour accéder à vos données."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סגור את היישום והפעל אותו מחדש כדי לגשת לנתונים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप्लिकेशन को बंद करें और अपने डेटा तक पहुंचने के लिए इसे पुनरारंभ करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvorite aplikaciju i ponovno je pokrenite kako biste pristupili svojim podacima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
