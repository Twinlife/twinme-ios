    "create_external_call_view_message" : {
      "comment" : "CreateExternalCallViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل الاسم والصورة ووصف موضوع المكالمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този профил се показва на гостите, които ще ви се обаждат чрез този „кликни за обаждане“ линк."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento profil se zobrazí hostům, kteří vám budou volat přes tento „click‑to‑call“ odkaz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast navn, billede og beskrivelse af opkaldsemnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil wird Gästen angezeigt, die Sie über diesen „Click-to-Call“-Link anrufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το προφίλ εμφανίζεται στους επισκέπτες που θα σας καλέσουν μέσω του συνδέσμου «click‑to‑call»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the name, image and description of the call subject."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrese el nombre, imagen y descripción del asunto de la llamada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام، تصویر و توضیحات موضوع تماس را وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna puhelun aiheen nimi, kuva ja kuvaus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le nom, l'image et la description du sujet de l'appel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
