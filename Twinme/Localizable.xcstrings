    "cleanup_view_medias_and_files_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتم إزالة الصور المصغرة للوسائط من المحادثة ؛ فقط الملفات الأصلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Миниатюрите на медиите не се премахват от разговора; изтриват се само оригиналните файлове."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniatury médií nejsou z konverzace odstraněny; odstraní se pouze původní soubory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medieminiaturer fjernes ikke fra samtalen; kun originale filer er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medien-Vorschaubilder werden nicht aus der Unterhaltung entfernt; nur Originaldateien werden gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μικρογραφίες πολυμέσων δεν αφαιρούνται από τη συνομιλία· διαγράφονται μόνο τα αρχικά αρχεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media thumbnails are not removed from the conversation; only original files are deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las miniaturas de medios no se eliminan de la conversación; solo se eliminan los archivos originales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصاویر کوچک رسانه از مکالمه حذف نمی شوند. فقط فایل های اصلی حذف می شوند"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Median pikkukuvia ei poisteta keskustelusta. vain alkuperäiset tiedostot ovat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les miniatures des médias ne sont pas supprimées de la conversation ; seuls les fichiers originaux le sont."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונות ממוזערות של מדיה אינן מוסרות מהשיחה; רק קבצים מקוריים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बातचीत से मीडिया थंबनेल नहीं निकाले जाते; केवल मूल फ़ाइलें हटाई जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minijature medija ne uklanjaju se iz razgovora; brišu se samo izvorne datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A média-előnézetek nem kerülnek törlésre, csak az eredeti fájlok."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar mini media tidak dihapus dari percakapan; hanya file asli yang dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le miniature multimediali non vengono rimosse dalla conversazione; vengono eliminati solo i file originali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディア サムネイルは会話から削除されません。 元のファイルのみが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미디어 섬네일은 대화에서 제거되지 않습니다. 원본 파일만 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medieminiatyrbilder fjernes ikke fra samtalen; bare originalfiler slettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediaminiaturen worden niet uit het gesprek verwijderd; alleen originele bestanden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniatury multimediów nie są usuwane z konwersacji; usuwane są tylko oryginalne pliki."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As miniaturas de mídia não são removidas da conversa; apenas os arquivos originais são excluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniaturile media nu sunt eliminate din conversație; sunt șterse doar fișierele originale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Миниатюры мультимедиа не удаляются из беседы; удаляются только исходные файлы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miniatúry médií sa z konverzácie neodstránia; odstránia sa iba pôvodné súbory."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sličice medijev se ne odstranijo iz pogovora; izbrišejo se le izvirne datoteke."
