        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exclusão de um Space remove todos os contatos, grupos e conversas desse Space. Tem certeza de que deseja excluir este Space?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ștergerea unui Space elimină toate contactele, grupurile și conversațiile din acel Space. Sigur doriți să ștergeți acest Space?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление Space удаляет все контакты, группы и разговоры из этого Space. Вы уверены, что хотите удалить это Space?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymazanie Priestoru odstráni všetky kontakty, skupiny a konverzácie z tohto Priestoru. Ste si istí, že chcete vymazať tento Priestor?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brisanje Prostora odstrani vse stike, skupine in pogovore iz tega Prostora. Ali ste prepričani, da želite izbrisati ta Prostor?"
          }
