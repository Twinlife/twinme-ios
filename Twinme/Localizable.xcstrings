    "call_view_certify_error_message" : {
      "comment" : "CallViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتحقق %@ من صحة الكلمة. فشلت عملية إثبات العلاقة وستحتاج إلى المحاولة مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не валидира думата. Сертифицирането на връзката се провали и трябва да опитате отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nepotvrdil slovo. Certifikace vztahu selhala a budete to muset zkusit znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har ikke valideret ordet. Certificeringen af forbindelsen mislykkedes. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat das Wort nicht validiert. Die Zertifizierung der Verbindung ist fehlgeschlagen und Sie müssen es erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο/Η %@ δεν επαλήθευσε τη λέξη. Η πιστοποίηση απέτυχε και πρέπει να ξαναδοκιμάσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ did not validate the word. The certification of the relation failed and you will need to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no validó la palabra. La certificación de la relación falló y deberá volver a intentarlo."
