    "account_view_message_first_part" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إنشاء حساب جديد عند تثبيت التطبيق لأول مرة ، بعد إعادة تثبيت التطبيق ، أو إعادة ضبط الجهاز ، أو حذف الحساب الحالي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нов акаунт се създава при първа инсталация на приложението, след преинсталация, нулиране на устройството или изтриване на текущия акаунт."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový účet se vytvoří při první instalaci aplikace, po reinstalaci aplikace, resetování zařízení nebo odstranění aktuálního účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny konto oprettes, når du installerer appen for første gang, efter geninstallation af appen eller nulstilling af enheden eller sletning af den aktuelle konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Konto wird erstellt, wenn die App zum ersten Mal installiert wird, nach einer Neuinstallation der App, beim Zurücksetzen des Geräts oder beim Löschen des aktuellen Kontos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νέος λογαριασμός δημιουργείται κατά την πρώτη εγκατάσταση της εφαρμογής, μετά από επανεγκατάσταση, επαναφορά συσκευής ή διαγραφή του τρέχοντος λογαριασμού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new account is created when installing the app for the first time, after re-installing the app, or resetting the device, or deleting the current account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se crea una nueva cuenta al instalar la aplicación por primera vez, después de volver a instalar la aplicación, restablecer el dispositivo o eliminar la cuenta actual."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام نصب برنامه برای اولین بار، پس از نصب مجدد برنامه، یا تنظیم مجدد دستگاه یا حذف حساب جاری، یک حساب جدید ایجاد می شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi tili luodaan, kun sovellus asennetaan ensimmäisen kerran, sovelluksen uudelleenasennuksen, laitteen nollauksen tai nykyisen tilin poistamisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau compte est créé lors de l’installation de l’application pour la première fois, après la réinstallation de l’application, ou la réinitialisation de l’appareil, ou la suppression du compte actuel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבון חדש נוצר בעת התקנת האפליקציה בפעם הראשונה, לאחר התקנה מחדש של האפליקציה, או איפוס המכשיר, או מחיקת החשבון הנוכחי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को पहली बार इंस्टॉल करने, ऐप को फिर से इंस्टॉल करने, या डिवाइस को रीसेट करने, या मौजूदा खाते को हटाने के बाद एक नया खाता बनाया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi račun stvara se pri prvom instaliranju aplikacije, nakon ponovne instalacije aplikacije, resetiranja uređaja ili brisanja trenutnog računa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új fiók jön létre az alkalmazás első telepítésekor, újratelepítésekor, az eszköz visszaállításakor vagy a jelenlegi fiók törlésekor."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun baru dibuat saat menginstal aplikasi untuk pertama kalinya, setelah menginstal ulang aplikasi, atau mengatur ulang perangkat, atau menghapus akun saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuovo account viene creato quando si installa l’app per la prima volta, dopo aver reinstallato l’app, reimpostato il dispositivo o eliminato l’account corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初めてアプリをインストールしたとき、アプリを再インストールしたとき、デバイスをリセットしたとき、または現在のアカウントを削除したときに、新しいアカウントが作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최초 앱 설치 시, 앱 재설치 시, 단말기 초기화 시, 기존 계정 삭제 시 새로운 계정이 생성됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny konto opprettes når du installerer appen for første gang, etter at appen er installert på nytt, eller enheten er tilbakestilt eller den gjeldende kontoen slettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt een nieuw account aangemaakt bij de eerste installatie van de app, na het opnieuw installeren van de app, het resetten van het apparaat of het verwijderen van het huidige account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe konto jest tworzone podczas pierwszej instalacji aplikacji, po ponownej instalacji aplikacji, zresetowaniu urządzenia lub usunięciu bieżącego konta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova conta é criada ao instalar o aplicativo pela primeira vez, após reinstalar o aplicativo, redefinir o dispositivo ou excluir a conta atual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cont nou este creat la instalarea aplicației pentru prima dată, după reinstalare, resetarea dispozitivului sau ștergerea contului curent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая учетная запись создается при первой установке приложения, после переустановки приложения, перезагрузки устройства или удаления текущей учетной записи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nový účet sa vytvorí pri prvom nainštalovaní aplikácie, po opätovnej inštalácii, po resetovaní zariadenia alebo odstránení súčasného účtu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nov račun se ustvari ob prvi namestitvi aplikacije, po ponovni namestitvi aplikacije, ponastavitvi naprave ali izbrisu trenutnega računa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një llogari e re krijohet kur instaloni aplikacionin për herë të parë, pas ri-instalimit të aplikacionit, ose rivendosjes së pajisjes, ose fshirjes së llogarisë aktuale."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi nalog se kreira prilikom prve instalacije aplikacije, nakon ponovne instalacije aplikacije, ili resetovanja uređaja, ili brisanja trenutnog naloga."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett nytt konto skapas när du installerar appen för första gången, efter att du har installerat om appen eller återställt enheten eller tagit bort det aktuella kontot."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı ilk kez yüklerken, uygulamayı yeniden yükledikten veya cihazı sıfırladıktan veya mevcut hesabı sildikten sonra yeni bir hesap oluşturulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий обліковий запис створюється під час першого встановлення програми, після повторної інсталяції програми, скидання налаштувань пристрою чи видалення поточного облікового запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tài khoản mới được tạo khi bạn cài đặt ứng dụng lần đầu, hoặc sau khi cài đặt lại ứng dụng, đặt lại thiết bị, hoặc xóa tài khoản hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次安装应用程序、重新安装应用程序、重置设备或删除当前帐户后，都会创建一个新帐户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次安裝應用程序、重新安裝應用程序、重置設備或刪除當前帳戶後，都會創建一個新帳戶。"
          }
        }
      }
    },
    "account_view_message_second_part" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتبق أي أثر للحساب والبيانات السابقة ، لذا سيتعين عليك إعادة دعوة جهات الاتصال الخاصة بك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не остава никаква следа от предишния акаунт и данни, така че ще трябва да поканите отново контактите си."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezůstane žádná stopa po předchozím účtu a datech, takže budete muset znovu pozvat své kontakty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen spor af tidligere konto og data tilbage, så du bliver nødt til at invitere dine kontakter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es bleiben keine Spuren des vorherigen Kontos und der Daten zurück, daher müssen Sie Ihre Kontaktpersonen neu einladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν παραμένει κανένα ίχνος προηγούμενου λογαριασμού ή δεδομένων, οπότε θα χρειαστεί να καλέσετε ξανά τις επαφές σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No trace of previous account and data remains, so you’ll have to re-invite your contacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda ningún rastro de la cuenta y los datos anteriores, por lo que tendrá que volver a invitar a sus contactos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ اثری از حساب و داده های قبلی باقی نمی ماند، بنابراین باید مخاطبین خود را دوباره دعوت کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiemmasta tilistä ja tiedoista ei jää jälkiä, joten sinun on kutsuttava yhteystietosi uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune trace du compte et des données précédents ne subsiste, vous devrez donc ré-inviter vos contacts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נשאר זכר לחשבון ונתונים קודמים, אז תצטרך להזמין מחדש את אנשי הקשר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले खाते और डेटा का कोई निशान नहीं बचा है, इसलिए आपको अपने संपर्कों को फिर से आमंत्रित करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ostaje nikakav trag prethodnog računa i podataka, pa ćete morati ponovno pozvati svoje kontakte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A korábbi fióknak és adatainak semmilyen nyoma nem marad, ezért újra meg kell hívnod a kapcsolataidat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada jejak akun dan data sebelumnya, jadi Anda harus mengundang kembali kontak Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non rimane alcuna traccia dell’account e dei dati precedenti, quindi dovrai invitare nuovamente i tuoi contatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のアカウントとデータの痕跡は残っていないため、連絡先を再度招待する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 계정 및 데이터의 흔적이 남지 않으므로 연락처를 다시 초대해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen spor av tidligere konto og data gjenstår, så du må invitere kontaktene dine på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er blijft geen spoor van vorig account en gegevens over, dus u moet uw contacten opnieuw uitnodigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po poprzednim koncie i danych nie pozostanie żaden ślad, więc będziesz musiał ponownie zaprosić swoje kontakty."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum vestígio de conta e dados anteriores permanece, então você terá que convidar novamente seus contatos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu rămâne nicio urmă a contului anterior și a datelor, deci va trebui să vă reinvitați contactele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никаких следов предыдущей учетной записи и данных не остается, поэтому вам придется повторно пригласить свои контакты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezostane žiadna stopa predchádzajúceho účtu a údajov, takže budete musieť svojich kontaktov znova pozvať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prejšnji račun in podatki ne ostanejo shranjeni, zato boste morali znova povabiti svoje stike."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk mbetet asnjë gjurmë e llogarisë dhe të dhënave të mëparshme, prandaj do t’ju duhet t’i ftoni sërish kontaktet tuaja."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ostaje nikakav trag prethodnog naloga i podataka, pa ćete morati ponovo da pozovete svoje kontakte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga spår av tidigare konto och data finns kvar, så du måste bjuda in dina kontakter igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki hesap ve verilerden hiçbir iz kalmaz, bu nedenle kişilerinizi yeniden davet etmeniz gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від попереднього облікового запису та даних не залишилося жодних слідів, тому вам доведеться повторно запросити своїх контактів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không còn dấu vết nào của tài khoản và dữ liệu cũ, vì vậy bạn sẽ cần mời lại các liên hệ của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前的帐户和数据不会留下任何痕迹，因此您必须重新邀请您的联系人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前的帳戶和數據不會留下任何痕跡，因此您必須重新邀請您的聯繫人。"
          }
        }
      }
    },
    "account_view_migration_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتوفر خدمة ترحيل الحساب لنقل حسابك بجميع البيانات المرتبطة (جهات الاتصال ، والرسائل ، والمجموعات ، وما إلى ذلك) من جهاز  إلى آخر في الوقت الفعلي. يمكنك بالتالي تبديل الحسابات بين جهاز قديم وآخر جديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услугата за миграция на акаунт позволява да прехвърлите вашия акаунт с всички свързани данни (контакти, съобщения, групи и др.) от едно Android устройство на друго в реално време. Така можете да превключвате акаунти между старо и ново устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dostupná služba migrace účtu, která umožňuje přenést váš účet a všechna data (kontakty, zprávy, skupiny atd.) mezi zařízeními Android v reálném čase. Můžete tak přepínat účet mezi starým a novým zařízením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontomigreringstjeneste er tilgængelig til at overføre din konto med alle tilknyttede data (kontakter, meddelelser, grupper osv.) Fra en enhed til en anden i realtid. Du kan således skifte konto mellem en gammel enhed og en ny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kontomigrationsdienst steht zur Verfügung, um Ihr Konto mit allen zugehörigen Daten (Kontaktpersonen, Nachrichten, Gruppen usw.) in Echtzeit von einem Android-Gerät auf ein anderes zu übertragen. So können Sie Konten zwischen einem alten und einem neuen Gerät wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει διαθέσιμη υπηρεσία μεταφοράς λογαριασμού που επιτρέπει τη μεταφορά του λογαριασμού σας με όλα τα δεδομένα (επαφές, μηνύματα, ομάδες κ.λπ.) από μια συσκευή Android σε άλλη σε πραγματικό χρόνο. Έτσι μπορείτε να αλλάξετε λογαριασμό μεταξύ παλιάς και νέας συσκευής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An account migration service is available to transfer your account with all associated data (contacts, messages, groups, etc.) from one device to another in real-time. You can thus switch accounts between an old device and a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servicio de migración de cuenta está disponible para transferir su cuenta con todos los datos asociados (contactos, mensajes, grupos, etc.) de un dispositivo a otro en tiempo real. Por lo tanto, puede cambiar de cuenta entre un dispositivo antiguo y uno nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک سرویس انتقال حساب برای انتقال حساب شما با تمام داده های مرتبط (مخاطبین ، پیام ها ، گروه ها و …) از یک دستگاه  به دستگاه دیگر در زمان واقعی در دسترس است. بنابراین می توانید حساب ها را بین یک دستگاه قدیمی و یک دستگاه جدید تغییر دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilinsiirtopalvelu on käytettävissä tilisi ja siihen liittyvien tietojen (yhteystiedot, viestit, ryhmät jne.) Siirtämiseksi yhdestä laitteesta reaaliajassa. Voit siis vaihtaa tiliä vanhan laitteen ja uuden välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un service de migration de compte est disponible pour transférer votre compte avec toutes les données associées (contacts, messages, groupes, etc.) d’un appareil à un autre en temps réel. Vous pouvez ainsi basculer de compte entre un ancien appareil et un nouveau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שירות העברת חשבונות זמין להעברת חשבונך עם כל הנתונים המשויכים (אנשי קשר, הודעות, קבוצות וכו …) ממכשיר אחד לאחר בזמן אמת. כך תוכלו להחליף חשבונות בין מכשיר ישן למכשיר חדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके खाते को सभी संबद्ध डेटा (संपर्क, संदेश, समूह, आदि) के साथ एक डिवाइस से दूसरे में रीयल-टाइम में स्थानांतरित करने के लिए एक खाता माइग्रेशन सेवा उपलब्ध है। इस प्रकार आप पुराने डिवाइस और नए के बीच खातों को स्विच कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupna je usluga migracije računa za prijenos vašeg računa sa svim povezanim podacima (kontakti, poruke, grupe itd.) s jednog Android uređaja na drugi u stvarnom vremenu. Tako možete prebaciti račun sa starog uređaja na novi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elérhető egy fiókmigrációs szolgáltatás, amely valós időben képes átvinnie a fiókodat és minden hozzá tartozó adatot (névjegyek, üzenetek, csoportok stb.) egyik Android-eszközről a másikra. Így átválthatsz régi készülékről újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan migrasi akun tersedia untuk mentransfer akun Anda dengan semua data terkait (kontak, pesan, grup, dll.) dari satu perangkat ke perangkat lain secara real-time. Dengan demikian, Anda dapat beralih akun antara perangkat lama dan perangkat baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È disponibile un servizio di migrazione dell’account per trasferire il tuo account con tutti i dati associati (contatti, messaggi, gruppi, ecc.) da un dispositivo a un altro in tempo reale. Puoi quindi cambiare account tra un vecchio dispositivo e uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント移行サービスを利用して、関連するすべてのデータ（連絡先、メッセージ、グループなど）を含むアカウントを1つのデバイスから別のデバイスにリアルタイムで転送できます。 したがって、古いデバイスと新しいデバイスの間でアカウントを切り替えることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 이전 서비스를 사용하여 모든 관련 데이터 (연락처, 메시지, 그룹 등)가있는 계정을 한 기기에서 다른 기기로 실시간으로 전송할 수 있습니다. 따라서 이전 장치와 새 장치간에 계정을 전환 할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontooverføringstjeneste er tilgjengelig for å overføre kontoen din med alle tilknyttede data (kontakter, meldinger, grupper osv.) Fra en enhet til en annen i sanntid. Du kan dermed bytte konto mellom en gammel enhet og en ny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een accountmigratieservice beschikbaar om uw account met alle bijbehorende gegevens (contacten, berichten, groepen, enz.) in realtime van het ene apparaat naar het andere over te zetten. U kunt dus van account wisselen tussen een oud apparaat en een nieuw apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępna jest usługa migracji konta, która umożliwia przeniesienie konta wraz ze wszystkimi powiązanymi danymi (kontaktami, wiadomościami, grupami itp.) z jednego urządzenia z systemem na drugie w czasie rzeczywistym. W ten sposób możesz przełączać konta między starym a nowym urządzeniem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um serviço de migração de conta está disponível para transferir sua conta com todos os dados associados (contatos, mensagens, grupos, etc.) de um dispositivo para outro em tempo real. Você pode, portanto, alternar contas entre um dispositivo antigo e um novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un serviciu de migrare a contului este disponibil pentru transferul contului împreună cu toate datele asociate (contacte, mesaje, grupuri etc.) între două dispozitive Android în timp real. Astfel puteți comuta conturile între un dispozitiv vechi și unul nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Служба переноса учетной записи доступна для переноса вашей учетной записи со всеми связанными данными (контактами, сообщениями, группами и т. Д.) С одного устройства на другое в режиме реального времени. Таким образом, вы можете переключать учетные записи между старым устройством и новым."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Služba migrácie účtu umožňuje preniesť váš účet so všetkými súvisiacimi údajmi (kontakty, správy, skupiny atď.) z jedného zariadenia so systémom Android do druhého v reálnom čase. Môžete tak prepnúť účet zo starého zariadenia na nové."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na voljo je storitev migracije računa za prenos vašega računa z vsemi povezanimi podatki (stiki, sporočila, skupine itd.) z ene naprave Android na drugo v realnem času. Tako lahko preklapljate med računi na stari in novi napravi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një shërbim migrimi llogarie është i disponueshëm për të transferuar llogarinë tuaj me të gjitha të dhënat e lidhura (kontakte, mesazhe, grupe, etj.) nga një pajisje Android në një tjetër në kohë reale. Kështu mund të kaloni llogarinë nga një pajisje e vjetër në një të re."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupna je usluga migracije naloga za prenos vašeg naloga sa svim povezanim podacima (kontakti, poruke, grupe itd.) sa jednog Android uređaja na drugi u realnom vremenu. Tako možete da prebacite nalog između starog i novog uređaja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontomigreringstjänst är tillgänglig för att överföra ditt konto med all associerad data (kontakter, meddelanden, grupper etc.) från en enhet till en annan i realtid. Du kan alltså växla konton mellan en gammal enhet och en ny."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı tüm ilişkili verilerle (kişiler, mesajlar, gruplar vb.) bir cihazdan diğerine gerçek zamanlı olarak aktarmak için bir hesap taşıma hizmeti mevcuttur. Böylece eski bir cihaz ile yeni bir cihaz arasında hesaplar arasında geçiş yapabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для перенесення облікового запису з усіма пов’язаними з ним даними (контакти, повідомлення, групи і т.д.) з одного пристрою на інший в режимі реального часу доступна послуга переносу даних облікового запису. Таким чином, ви можете переносити облікові записи зі старого пристрою на новий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ di chuyển tài khoản có sẵn để chuyển toàn bộ tài khoản của bạn, bao gồm tất cả dữ liệu liên quan (liên hệ, tin nhắn, nhóm, v.v.), từ thiết bị này sang thiết bị khác theo thời gian thực. Nhờ đó, bạn có thể chuyển tài khoản giữa thiết bị cũ và thiết bị mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帐户迁移服务可用于将您的帐户以及所有相关数据（联系人、消息、群组等）从一台 设备实时转移到另一台。 因此，您可以在旧设备和新设备之间切换帐户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳戶遷移服務可用於將您的帳戶以及所有相關數據（聯繫人、消息、群組等）從一台 設備實時轉移到另一台。 因此，您可以在舊設備和新設備之間切換帳戶。"
          }
        }
      }
    },
