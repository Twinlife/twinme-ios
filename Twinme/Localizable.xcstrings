    "show_group_view_leave_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من أنك تريد مغادرة هذه المجموعة؟"
          }
        },
        "bg" : {
          "stringUnit" : {
