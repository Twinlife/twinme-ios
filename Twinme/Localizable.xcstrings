    "spaces_view_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساحة هي المكان الذي تلتقي فيه شخصياتك المختلفة بدوائرك الاجتماعية المتعددة، بما في ذلك الدوائر الأكثر سرية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пространството е мястото, където вашите различни личности срещат различните ви социални кръгове, включително най‑тайните."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor je místo, kde se vaše různé osobnosti setkávají s vašimi sociálními okruhy, včetně těch nejvíce tajných."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et Space er, hvor dine forskellige personligheder møder dine mange sociale cirkler, inklusive de mest hemmelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Space ist der Ort, an dem Ihre verschiedenen Identitäten auf Ihre vielfältigen sozialen Kreise treffen – selbst auf die geheimsten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας Χώρος είναι εκεί όπου οι διαφορετικές προσωπικότητές σας συναντούν τους πολλούς κοινωνικούς σας κύκλους, ακόμη και τους πιο μυστικούς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Space is where your different personalities meet your multiple social circles, including the most secret ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Space es donde tus diferentes personalidades se encuentran con tus múltiples círculos sociales, incluidos los más secretos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فضا جایی است که شخصیت‌های مختلف شما با حلقه‌های اجتماعی متعدد شما، از جمله محرمانه‌ترین حلقه‌ها، ملاقات می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space on paikka, jossa erilaiset persoonallisuutesi kohtaavat useita sosiaalisia piirejä, mukaan lukien salaisimmat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Space est l’endroit où vos différentes personnalités rencontrent vos multiples cercles sociaux, y compris les plus secrets."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלל הוא המקום שבו האישיות השונות שלך פוגשת את המעגלים החברתיים המרובים שלך, כולל הסודיים ביותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक \"अंतरिक्ष\" वह जगह है जहां आपके विभिन्न व्यक्तित्व आपके कई सामाजिक मंडलों से मिलते हैं, जिनमें सबसे गुप्त लोग भी शामिल हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor je mjesto gdje se vaše različite osobnosti susreću s vašim mnogobrojnim društvenim krugovima, uključujući i one najtajnije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Space az a hely, ahol a különböző személyiségeid találkoznak a többféle társasági köröddel, beleértve a legtitkosabbakat is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebuah Space adalah tempat berbagai kepribadian Anda bertemu dengan berbagai lingkaran sosial, termasuk yang paling rahasia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno Space è il luogo in cui le tue diverse personalità incontrano i tuoi molteplici circoli sociali, compresi quelli più segreti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「スペース」とは、あなたのさまざまな個性が、最も秘密のサークルを含む複数の社会的サークルと出会う場所です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간은 당신의 다양한 성격이 가장 비밀스러운 사람들을 포함하여 여러 소셜 서클을 만나는 곳입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et Space er der de forskjellige personlighetene dine møter dine sosiale sirkler, inkludert de mest hemmelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Space is waar uw verschillende persoonlijkheden uw meerdere sociale kringen ontmoeten, inclusief de meest geheime."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space to miejsce, w którym twoje różne osobowości spotykają się z twoimi wieloma kręgami społecznymi, w tym tymi najbardziej tajnymi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Space é onde suas diferentes personalidades encontram seus múltiplos círculos sociais, incluindo os mais secretos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Spațiu este locul unde personalitățile tale diferite întâlnesc multiplele cercuri sociale, inclusiv pe cele mai secrete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пространство — это место, где ваши разные личности встречаются с вашими многочисленными кругами общения, включая самые секретные."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priestor je miesto, kde sa vaše rôzne identity stretávajú s vašimi sociálnymi okruhmi, vrátane tých najtajnejších."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor je kraj, kjer se vaše različne osebnosti srečajo z vašimi različnimi družbenimi krogi, vključno z najbolj skrivnimi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një Hapësirë është vendi ku personalitetet tuaja të ndryshme takojnë rrethet tuaja të shumta shoqërore, përfshirë edhe më sekretet."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space je mesto gde se vaše različite ličnosti susreću sa vašim brojnim društvenim krugovima, uključujući i one najtajnovitije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett Space är där dina olika personligheter möter dina många sociala cirklar, inklusive de mest hemliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Space, farklı kişiliklerinizin, en gizli olanlar da dahil olmak üzere birden fazla sosyal çevrenizle buluştuğu yerdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простір - це місце, де ваші різні особистості зустрічаються з вашими численними колами спілкування, включаючи найтаємніші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một Không gian là nơi các vai trò khác nhau của bạn gặp gỡ các vòng xã hội đa dạng, bao gồm cả những mối quan hệ bí mật nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“空间”是您的不同个性与多个社交圈（包括最秘密的社交圈）相遇的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「空間」是您的不同個性與多個社交圈（包括最秘密的社交圈）相遇的地方。"
          }
        }
      }
    },
