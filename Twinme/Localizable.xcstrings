        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo se ime i slika koriste za pozivanje vaših kontakata i inicijalizaciju vaših odnosa. Moći ćete ih mijenjati i prilagođavati za svaki odnos."
