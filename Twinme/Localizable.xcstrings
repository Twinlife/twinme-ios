    "add_contact_view_invite_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على %1$@ من جهازك الجوّال للاتصال بشكل خاص على تطبيق Skred مع “%2$@”"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете уеб адреса %1$@ с Skred на вашето мобилно устройство или сканирайте QR-кода, за да се свържете лично с „%2$@“"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete webovou adresu %1$@ pomocí Skred na svém mobilním zařízení nebo naskenujte QR kód pro soukromé propojení s „%2$@“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn web-adressen %1$@ med Skred på din mobilenhed for at oprette privat forbindelse til ”%2$@”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie die Webadresse %1$@ mit Skred auf Ihrem Mobilgerät oder scannen Sie den QR-Code, um sich privat mit „%2$@“ zu verbinden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε τη διεύθυνση %1$@ με το Skred στη συσκευή σας ή σαρώστε τον QR‑κώδικα για ιδιωτική σύνδεση με τον/την «%2$@»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap %1$@ on your mobile device to connect privately on Skred with “%2$@”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca %1$@ en tu dispositivo móvil para conectarte de forma privada en Skred con “%2$@”"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای اتصال خصوصی به “%2$@” با Skred ٬ روی آدرس وب %1$@ در دستگاه تلفن همراه خود ضربه بزنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa verkko-osoite %1$@ Skredllä mobiililaitteessa pitääksesi yhteyttä yksityisesti ”%2$@” kanssa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
