    "edit_space_view_delete_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي حذف Space إلى إزالة جميع جهات الاتصال والمجموعات والمحادثات من هذا Space.  هل تريد بالتأكيد حذف هذه Space؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтриването на Space премахва всички контакти, групи и разговори от този Space. Сигурни ли сте, че искате да изтриете този Space?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazání Prostoru odstraní z tohoto Prostoru všechny kontakty, skupiny a konverzace. Opravdu chcete tento Prostor smazat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletning af et Space fjerner alle kontakter, grupper og samtaler fra det Space. Er du sikker på, at du vil slette dette Space?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Löschen eines Space werden alle Kontakte, Gruppen und Konversationen aus diesem Space entfernt. A Sind Sie sicher, dass Sie dieses Space löschen möchten?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή ενός Χώρου αφαιρεί όλες τις επαφές, ομάδες και συνομιλίες από αυτόν τον Χώρο. Είστε βέβαιοι ότι θέλετε να διαγράψετε αυτόν τον Χώρο;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting a Space removes all contacts, groups and conversations from that Space. Are you sure you want to delete this Space?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar un Space elimina todos los contactos, grupos y conversaciones de ese Space. ¿Estás seguro de que deseas eliminar este Space?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف Space همه مخاطبین ، گروه ها و مکالمات را از آن Space حذف می کند. آیا مطمئن هستید که می خواهید این Space را حذف کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space poistaminen poistaa kaikki yhteystiedot, ryhmät ja keskustelut kyseisestä Space. Haluatko varmasti poistaa tämän Space?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression d’un Space supprime tous les contacts, groupes et conversations de ce Space. Voulez-vous vraiment supprimer ce Space ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיקת Space תסיר את כל אנשי הקשר, הקבוצות והשיחות מSkredboard זה. האם אכן למחוק Space זה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space हटाने से इस “स्पेस“ से सभी संपर्क, समूह और वार्तालाप हटा दिए जाते हैं। क्या आप वाकई इस Space को हटाना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brisanje Prostora uklanja sve kontakte, grupe i razgovore iz tog Prostora. Jeste li sigurni da želite izbrisati ovaj Prostor?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Space törlése eltávolít minden névjegyet, csoportot és beszélgetést abból a Space-ből. Biztosan törölni szeretné ezt a Space-et?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus Space akan menghapus semua kontak, grup, dan percakapan dari Space tersebut. Anda yakin ingin menghapus Space ini?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione di uno Space rimuove tutti i contatti, i gruppi e le conversazioni da quello Space. Sei sicuro di voler eliminare questo Space?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceを削除すると、そのSpaceからすべての連絡先、グループ、会話が削除されます。このSkredboardを削除してもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skredboard을 삭제하면 해당 “공간“에서 모든 연락처, 그룹 및 대화가 제거됩니다. 이 Skredboard을 삭제 하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sletter et Space, fjernes alle kontakter, grupper og samtaler fra det Space. Er du sikker på at du vil slette denne Space?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u een Space verwijdert, worden alle contacten, groepen en gesprekken uit die Space verwijderd. Weet u zeker dat u deze Space wilt verwijderen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie Space usuwa wszystkie kontakty, grupy i rozmowy z tej Space. Czy na pewno chcesz usunąć to Space?"
          }
