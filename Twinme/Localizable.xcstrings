    "application_network_status_connected_no_internet" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد وصول شبكة إلى الخدمة Skred.\nتحقق من اتصال شبكة الإنترنت الخاص بك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма достъп до услугата Skred."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný přístup ke službě Skred."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen netværksadgang til Skred tjeneste.\nTjek din netværksforbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Netzwerkzugriff auf den Skred-Dienst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει πρόσβαση στην υπηρεσία Skred."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No network access to the Skred service.\nCheck your Internet network connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay acceso de red al servicio Skred.\nRevisa tu conexión de red a Internet."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرویس Skred به شبکه دسترسی ندارد. \nاتصال شبکه اینترنت خود را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei verkkopääsyä Skred-palveluun.\nTarkista internet-yhteys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d’accès réseau au service Skred.\nVérifiez votre connexion réseau Internet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין לשירות Skred גישה לרשת.\nנא לבדוק את החיבור לרשת האינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skred सेवा के लिए कोई नेटवर्क पहुंच नहीं है।\nअपने इंटरनेट नेटवर्क कनेक्शन की जाँच करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema mrežnog pristupa usluzi Skred."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs hálózati hozzáférés a Skred szolgáltatáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
