    "accept_invitation_view_local_twincode" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنك إقامة علاقة مع نفسك داخل نفس الحساب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можете да установите връзка със себе си в рамките на един и същ акаунт."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemůžete navázat vztah sami se sebou v rámci stejného účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke etablere et forhold til dig selv inden for den samme konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können keine Verbindung mit sich selbst innerhalb desselben Kontos aufbauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορείτε να δημιουργήσετε σχέση με τον εαυτό σας στον ίδιο λογαριασμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You cannot establish a relationship with yourself within the same account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes establecer una relación contigo mismo dentro de la misma cuenta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما نمی توانید در یک حساب کاربری با خودتان رابطه برقرار کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et voi luoda suhdetta itseesi samalla tilillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas établir de relation avec vous-même au sein du même compte."
