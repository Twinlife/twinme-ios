            "value" : "שירותי המיקום של המכשיר שלך מושבתים. עליך להפעיל אותם כדי להשתמש בשיתוף מיקום בתוך האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके डिवाइस की स्थान सेवाएँ अक्षम हैं। ऐप के भीतर स्थान साझाकरण का उपयोग करने के लिए आपको उन्हें सक्रिय करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usluge lokacije na vašem uređaju su onemogućene. Morate ih aktivirati kako biste koristili dijeljenje lokacije unutar aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A készülék helymeghatározási szolgáltatásai ki vannak kapcsolva. Az alkalmazáson belüli helymegosztás használatához aktiválnod kell őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan lokasi perangkat Anda dinonaktifkan. Anda harus mengaktifkannya untuk menggunakan berbagi lokasi dalam aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I servizi di localizzazione del tuo dispositivo sono disabilitati. Devi attivarli per utilizzare la condivisione della posizione all'interno dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの位置情報サービスが無効になっています。アプリ内で位置情報の共有を使用するには、位置情報サービスを有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 위치 서비스가 비활성화되었습니다. 앱 내에서 위치 공유를 사용하려면 활성화해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhetens posisjonstjenester er deaktivert. Du må aktivere dem for å bruke posisjonsdeling i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De locatieservices van uw apparaat zijn uitgeschakeld. Je moet ze activeren om locatie delen binnen de app te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługi lokalizacyjne na Twoim urządzeniu są wyłączone. Aby móc korzystać z udostępniania lokalizacji w aplikacji, musisz je aktywować."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os serviços de localização do seu dispositivo estão desativados. Deve ativá-los para usar a partilha de localização na aplicação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviciile de localizare ale dispozitivului dvs. sunt dezactivate. Trebuie să le activați pentru a utiliza partajarea locației în aplicație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Службы определения местоположения вашего устройства отключены. Вы должны активировать их, чтобы использовать совместное использование местоположения в приложении."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Služby určovania polohy vo vašom zariadení sú vypnuté. Ak chcete v aplikácii používať zdieľanie polohy, musíte ich aktivovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokacijske storitve v vaši napravi so onemogočene. Za uporabo deljenja lokacije v aplikaciji jih morate omogočiti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shërbimet e vendndodhjes së pajisjes suaj janë çaktivizuar. Duhet t'i aktivizoni ato për të përdorur ndarjen e vendndodhjes brenda aplikacionit."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usluge lokacije na vašem uređaju su onemogućene. Morate ih aktivirati da biste koristili deljenje lokacije u aplikaciji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din enhets platstjänster är inaktiverade. Du måste aktivera dem för att använda platsdelning i appen."
