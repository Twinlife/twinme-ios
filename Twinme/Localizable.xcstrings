    "spaces_view_move_group_no_profile" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلنقل مجموعة إلى Space ، يجب عليك إكمال ملف التعريف الذي يمثلك في هذه المجموعة. هل تريد إكماله؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да преместите група в Space, трябва да завършите профила, който ви представя пред тази група. Искате ли да го завършите?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li přesunout skupinu do Prostoru, musíte dokončit profil, který vás této skupině představuje. Chcete jej dokončit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at flytte en gruppe til et Space, skal du udfylde den profil, der repræsenterer dig for denne gruppe. Vil du fuldføre det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um eine Gruppe in ein Space zu verschieben, müssen Sie das Profil vervollständigen, das Sie für diese Gruppe darstellt. Möchten Sie es vervollständigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να μετακινήσετε μια ομάδα σε έναν Χώρο, πρέπει να ολοκληρώσετε το προφίλ που σας αντιπροσωπεύει σε αυτήν την ομάδα. Θέλετε να το ολοκληρώσετε;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To move a group to a Space, you must complete the profile that represents you to this group. Do you want to complete it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mover un grupo a un Space, debe completar el perfil que lo representa a este grupo. ¿Quieres completarlo?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتقال گروه به Spaceی ، باید نمایه ای را ارائه دهید که نمایانگر شما در این گروه باشد. آیا می خواهید آن را تکمیل کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat siirtää ryhmän Space, sinun on suoritettava profiili, joka edustaa sinua tähän ryhmään. Haluatko suorittaa sen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour déplacer un groupe vers un Space, vous devez compléter le profil qui vous représente dans ce groupe. Voulez-vous le compléter?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להעביר קבוצה לSpace, עליך להשלים את הפרופיל שמייצג אותך מול איש קשר זה. האם ברצונך להשלים זאת?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समूह को Space में ले जाने के लिए, आपको उस प्रोफ़ाइल को पूरा करना होगा जो आपको इस समूह का प्रतिनिधित्व करती है। क्या आप इसे पूरा करना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za premještanje grupe u Prostor morate dovršiti profil koji vas predstavlja toj grupi. Želite li ga dovršiti?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy csoport Space-be helyezéséhez ki kell töltenie azt a profilt, amely Önt ennél a csoportnál képviseli. Szeretné kitölteni?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memindahkan grup ke Space, Anda harus melengkapi profil yang mewakili Anda ke grup ini. Apakah Anda ingin melengkapinya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per spostare un gruppo in uno Space, è necessario completare il profilo che rappresenta questo gruppo. Vuoi completarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループをSpaceに移動するには、このグループを表すプロファイルを完成させる必要があります。完了しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹을 Skredboard으로 이동하려면이 그룹에 대한 프로필을 작성해야합니다. 완료 하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å flytte en gruppe til et Space, må du fullføre profilen som representerer deg for denne gruppen. Vil du fullføre det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een groep naar een Space te verplaatsen, moet u het profiel invullen dat u voor deze groep vertegenwoordigt. Wil je het voltooien?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przenieść grupę do Space, musisz wypełnić profil, który reprezentuje Cię w tej grupie w tej Space. Chcesz to zakończyć?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mover um grupo para um Space, você deve preencher o perfil que representa você para este grupo. Deseja completá-lo?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a muta un grup într-un Space, trebuie să completați profilul care vă reprezintă pentru acest grup. Doriți să îl completați?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы переместить группу в Space, вы должны заполнить профиль, который представляет вас в этой группе. Вы хотите завершить это?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete presunúť skupinu do Priestoru, musíte dokončiť profil, ktorý vás predstavuje tejto skupine. Chcete ho dokončiť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za premik skupine v Prostor morate dokončati profil, ki vas predstavlja tej skupini. Želite ga dokončati?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Për të lëvizur një grup në një Space, duhet të plotësoni profilin që ju përfaqëson për atë grup. A dëshironi ta plotësoni?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da biste premestili grupu u Space, morate da dovršite profil koji vas predstavlja toj grupi. Želite li da ga dovršite?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att flytta en grupp till ett Space måste du fylla i profilen som representerar dig för denna grupp. Vill du slutföra det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir grubu Space a taşımak için, sizi bu gruba temsil eden profili tamamlamanız gerekir. Tamamlamak ister misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб перемістити групу в Space, ви повинні заповнити профіль, який представляє вас у цій групі. Ви хочете його завершити?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để chuyển nhóm, bạn cần hoàn tất hồ sơ đại diện. Bạn có muốn hoàn tất không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将组移动到Space，您必须完成代表您进入该组的配置文件。您要完成吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要將組人移至Skredboard，您必須完成定義個人資料以便為您組人標識自己。您要完成嗎？"
          }
        }
      }
    },
