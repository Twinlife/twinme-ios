        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitukset näkyvät vain, kun kyseinen Space on tällä hetkellä aktiivinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
