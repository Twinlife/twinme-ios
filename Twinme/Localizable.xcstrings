    "create_profile_view_incomplete_profile_message" : {
      "comment" : "CreateProfileViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعد كل من الاسم والصورة ضروريين لجهات الاتصال الخاصة بك للتعرف عليك وتمييزك عن الآخرين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Името И изображението са задължителни, за да могат контактите ви да ви разпознаят и различават."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro vaše kontakty jsou jméno A obrázek nezbytné, aby vás poznaly a odlišily od ostatních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både navn OG billede er afgørende for, at dine kontakter kan genkende og adskille dig fra andre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sowohl Name ALS AUCH Bild sind unerlässlich, damit Ihre Kontaktpersonen Sie erkennen und von anderen unterscheiden können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όνομα ΚΑΙ η εικόνα είναι απαραίτητα για να σας αναγνωρίζουν και να σας ξεχωρίζουν οι επαφές σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both name AND image are essential for your contacts to recognize and differentiate you from others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanto el nombre COMO la imagen son esenciales para que tus contactos te reconozcan y te diferencien de los demás."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام و تصویر هر دو برای مخاطبین شما ضروری است تا شما را از دیگران تشخیص دهند و متمایز کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekä nimi että kuva ovat tärkeitä, jotta yhteyshenkilösi tunnistavat ja erottavat sinut muista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom ET une image sont tous deux nécessaires, pour que vos contacts puissent vous distinguer des autres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גם השם וגם התמונה חיוניים לאנשי הקשר שלך כדי לזהות ולהבדיל אותך מאחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके संपर्कों को पहचानने और आपको दूसरों से अलग करने के लिए नाम और छवि दोनों आवश्यक हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ime I slika ključni su kako bi vas kontakti prepoznali i razlikovali od drugih."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
