          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação invalida o código de convite atual associado a este link \"click-to-call\". Confirme?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această acțiune invalidează codul actual de invitație asociat acestui link „click-to-call”. Confirmați?"
