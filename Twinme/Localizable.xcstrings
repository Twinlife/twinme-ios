        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med din kjæres tillatelse kan du kontrollere kameraet deres under en samtale for å hjelpe dem eksternt, enkelt og sikkert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met toestemming van uw dierbare kunt u zijn of haar camera tijdens een gesprek bedienen om hem of haar op afstand, eenvoudig en veilig te helpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za zgodą bliskiej osoby możesz sterować jej kamerą podczas rozmowy, aby pomóc jej zdalnie, łatwo i bezpiecznie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a permissão do seu ente querido, pode controlar a sua câmara durante uma chamada para o ajudar remotamente, de forma fácil e segura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu permisiunea persoanei apropiate, puteți controla camera acesteia pentru a o ajuta de la distanță, ușor și în siguranță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С разрешения близкого человека вы можете управлять его камерой во время разговора, чтобы помочь ему удалённо, легко и безопасно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S povolením blízkej osoby môžete počas hovoru ovládať jej kameru, aby ste jej mohli jednoducho a bezpečne pomôcť na diaľku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z dovoljenjem vašega bližnjega lahko med klicem nadzorujete njegovo/njeno kamero ter mu/ji na daljavo pomagate enostavno in varno."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me lejen e të dashurit tuaj, mund të kontrolloni kamerën e tij/saj gjatë një thirrjeje për ta ndihmuar nga larg, lehtësisht dhe në mënyrë të sigurt."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz dozvolu vaše bliske osobe, možete kontrolisati njenu kameru tokom poziva kako biste joj pomogli na daljinu, lako i bezbedno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med din närståendes tillåtelse kan du styra deras kamera under ett samtal för att hjälpa dem på distans, enkelt och säkert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sevdiğiniz kişinin izniyle, görüşme sırasında kamerasını kontrol ederek ona uzaktan, kolay ve güvenli bir şekilde yardımcı olabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З дозволу вашої близької людини ви можете керувати її камерою під час дзвінка, щоб допомогти їй дистанційно, легко та безпечно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với sự cho phép của người thân, bạn có thể điều khiển camera của họ trong khi gọi điện để hỗ trợ họ từ xa, dễ dàng và an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在获得亲人许可的情况下，您可以在通话期间控制他们的摄像头，以便远程、轻松、安全地为他们提供帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在獲得親人許可的情況下，您可以在通話期間控制他們的攝像頭，以便遠端、輕鬆、安全地為他們提供幫助。"
          }
        }
      }
    },
