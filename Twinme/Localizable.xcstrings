    "main_view_reset_conversation_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستؤدي إعادة تعيين هذه المحادثة إلى حذف جميع الرسائل ، بما في ذلك تلك الموجودة على جهاز جهة الاتصال الخاصة بك. يتأكد؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нулирането на този разговор ще изтрие всички съобщения, включително тези на устройството на вашия контакт. Потвърждавате ли?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetování této konverzace odstraní všechny zprávy, včetně těch na zařízení vašeho kontaktu. Potvrdit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du nulstiller denne samtale, slettes alle beskeder, inklusive dem på din kontakts enhed. Bekræfte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zurücksetzen dieser Unterhaltung löscht alle Nachrichten, auch die auf dem Gerät Ihrer Kontaktperson. Bestätigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαναφορά αυτής της συνομιλίας θα διαγράψει όλα τα μηνύματα, συμπεριλαμβανομένων αυτών στη συσκευή της επαφής σας. Επιβεβαίωση;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetting this conversation will delete all messages, including those on your contact’s device. Confirm?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablecer esta conversación eliminará todos los mensajes, incluidos los del dispositivo de su contacto. ¿Confirmar?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازنشانی این مکالمه همه پیام‌ها، از جمله پیام‌های موجود در دستگاه مخاطب شما را حذف می‌کند. تایید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän keskustelun nollaaminen poistaa kaikki viestit, myös yhteystietosi laitteelta. Vahvistaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime tous les messages de cette conversation, y compris sur l’appareil de votre contact. Confirmer ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איפוס שיחה זו ימחק את כל ההודעות, כולל אלה במכשיר של איש הקשר שלך. האם לאשר?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वार्तालाप को रीसेट करने से आपके संपर्क के उपकरण सहित सभी संदेश हट जाएंगे. पुष्टि करना?"
