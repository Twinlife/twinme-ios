        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人資料可讓您邀請聯絡人在應用程式上與您建立關係。 您可以擁有任意數量的個人資料（角色），每個個人資料都與特定的「空間」相關聯。"
          }
        }
      }
    },
    "create_profile_view_onboarding_message_part_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح لك الملفات الشخصية دعوة جهات الاتصال لإنشاء علاقات معك على التطبيق. يمكنك الحصول على أي عدد تريده من الملفات الشخصية (الشخصيات)، يرتبط كل منها بـ مساحة معينة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки „Профил“ има „Име“ и „Изображение“ (задължителни), виждани от контактите, които каните, и използвани като началния ви профил за новосъздадените връзки в това Пространство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý profil má „Jméno“ a „Obrázek“ (povinné), které vidí kontakty, které zvete, a používá se jako počáteční profil pro nové vztahy v daném Prostoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler giver dig mulighed for at invitere kontakter til at skabe relationer med dig i applikationen. Du kan have så mange profiler (persona), som du vil, hver tilknyttet et bestemt Space."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes „Profil“ hat einen „Namen“ und ein „Bild“ (erforderlich). Diese sind für die von Ihnen eingeladenen Kontaktpersonen sichtbar und dienen als Ihr Startprofil für neu erstellte Verbindungen in diesem „Bereich“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε Προφίλ έχει Όνομα και Εικόνα (απαραίτητα), τα οποία βλέπουν οι επαφές που προσκαλείτε και χρησιμοποιούνται ως αρχική ταυτότητά σας για τις σχέσεις αυτού του Χώρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each “Profile” has a “Name” and an “Image” (required), seen by the contacts you invite, and used as your initial Profile associated with the newly created relationships of that Space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada “Perfil” tiene un “Nombre” y una “Imagen” (obligatoria), que ven los contactos que invitas y se utilizan como tu Perfil inicial asociado con las relaciones recién creadas de ese Space."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر «نمایه» یک «نام» و یک «تصویر» (الزامی) دارد که توسط مخاطبینی که دعوت می‌کنید دیده می‌شوند و به‌عنوان نمایه اولیه مرتبط با روابط جدید ایجاد شده آن فضا استفاده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisella profiililla on nimi ja kuva (pakollinen), jotka kutsumasi yhteyshenkilöt näkevät ja joita käytetään alkuperäisenä profiilina, joka liittyy kyseisen Space äskettäin luotuihin suhteisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque « Profil » a un « Nom » et une « Image » (obligatoire), vus par les contacts que vous invitez, et utilisés comme votre Profil initial associé aux relations nouvellement créées de ce « Space »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכל פרופיל יש שם ותמונה (חובה), הנראים על ידי אנשי הקשר שאתה מזמין, ומשמשים כפרופיל הראשוני שלך המשויך למערכות היחסים החדשות שנוצרו באותו חלל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक प्रोफ़ाइल में एक नाम और एक छवि (आवश्यक) होती है, जो आपके द्वारा आमंत्रित संपर्कों द्वारा देखी जाती है, और उस स्पेस के नव निर्मित संबंधों से जुड़ी आपकी प्रारंभिक प्रोफ़ाइल के रूप में उपयोग की जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki „Profil” ima „Ime” i „Sliku” (obavezno), koje vide kontakti koje pozivate i koje se koristi kao vaš početni Profil povezan s novostvorenim odnosima tog „Prostora”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden „Profilhoz” tartozik egy „Név” és egy „Kép” (kötelező), amit a meghívott kapcsolatok látnak, és amely a \"Tér\" új kapcsolataihoz tartozó kezdeti profilod lesz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap Profil memiliki Nama dan Gambar (wajib), dilihat oleh kontak yang Anda undang, dan digunakan sebagai Profil awal Anda yang terkait dengan hubungan yang baru dibuat di Space tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni “Profilo” ha un “Nome” e una “Immagine” (obbligatoria), vista dai contatti che inviti, e utilizzata come tuo Profilo iniziale associato alle relazioni appena create di quello “Space”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各「プロファイル」には「名前」と「画像」（必須）があり、招待した連絡先に表示され、その「スペース」の新しく作成された関係に関連付けられた最初のプロファイルとして使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 프로필에는 이름과 이미지(필수)가 있으며, 이는 귀하가 초대한 연락처에서 볼 수 있으며 해당 스페이스의 새로 생성된 관계와 연결된 초기 프로필로 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver Profil har et Navn og et Bilde (obligatorisk), sett av kontaktene du inviterer, og brukt som din første profil knyttet til de nyopprettede relasjonene til det Space."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk “Profiel” heeft een “Naam” en een “Afbeelding” (vereist), gezien door de contactpersonen die u uitnodigt, en gebruikt als uw initiële profiel geassocieerd met de nieuw gemaakte relaties van die Space."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy „Profil” ma „Nazwę” i „Obraz” (wymagane), widoczne dla zaproszonych przez Ciebie kontaktów i używany jako Twój początkowy Profil powiązany z nowo utworzonymi relacjami w tej „Space”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada “Perfil” possui um “Nome” e uma “Imagem” (obrigatório), vistos pelos contatos que você convida, e utilizados como seu Perfil inicial associado aos relacionamentos recém-criados daquele “Space”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare „Profil” are un „Nume” și o „Imagine” (obligatorii), vizibile contactelor invitate și utilizate ca Profil inițial pentru relațiile noi din acel „Spațiu”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый «Профиль» имеет «Имя» и «Изображение» (обязательно), которые видят приглашенные вами контакты и которые используются в качестве исходного профиля, связанного с вновь созданными отношениями в этом «Пространстве»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý profil má „Meno“ a „Obrázok“ (povinné), ktoré vidia pozvané kontakty a používajú sa na prvotné nastavenie vzťahu v Priestore."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak »Profil« ima »Ime« in »Sliko« (obvezno), ki ju vidijo stiki, ki jih povabite, in se uporabljata kot vaš začetni Profil, povezan z novo ustvarjenimi odnosi tega »Prostora«."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çdo “Profil” ka një “Emër” dhe një “Imazh” (të domosdoshëm), që shihen nga kontaktet që ftoni dhe përdoren si Profili juaj fillestar i lidhur me marrëdhëniet e sapokrijuara të atij \\\"Space\\\"."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki „Profil“ ima „Ime“ i „Sliku“ (obavezno), koje vide kontakti koje pozivate, i koristi se kao vaš početni Profil povezan sa novokreiranim odnosima tog \\\"Space\\\"-a."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje Profil har ett Namn och en Bild (obligatoriskt), som ses av de kontakter du bjuder in, och används som din första profil kopplad till de nyskapade relationerna i det Space."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her Profil, davet ettiğiniz kişiler tarafından görülen ve o Space ın yeni oluşturulan ilişkileriyle ilişkili ilk Profiliniz olarak kullanılan bir Ad ve bir Resim e (gerekli) sahiptir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен Профіль має Ім'я та Зображення (обов'язково), які бачать запрошені вами контакти і які використовуються як вихідний профіль, пов'язаний із новоствореними відносинами в цьому Просторі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi \"Hồ sơ\" có \"Tên\" và \"Ảnh\" (bắt buộc), được liên hệ thấy khi được mời, và dùng làm Hồ sơ khởi đầu của bạn trong các mối quan hệ mới của Không gian đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个人资料允许您邀请联系人在应用程序上与您建立关系。 您可以拥有任意数量的个人资料（角色），每个个人资料都与特定的“空间”相关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人資料可讓您邀請聯絡人在應用程式上與您建立關係。 您可以擁有任意數量的個人資料（角色），每個個人資料都與特定的「空間」相關聯。"
          }
        }
      }
    },
