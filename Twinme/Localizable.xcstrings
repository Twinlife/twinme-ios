        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε στους παραλήπτες να αντιγράψουν/αποθηκεύσουν/κοινοποιήσουν τα περιεχόμενά σας"
