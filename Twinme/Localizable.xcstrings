        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ לא אימת את המילה. האישור של הקשר נכשל ותצטרך לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने शब्द को मान्य नहीं किया। संबंध का प्रमाणन विफल हो गया और आपको फिर से प्रयास करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nije potvrdio/la riječ. Potvrđivanje odnosa nije uspjelo i morat ćete pokušati ponovno."
