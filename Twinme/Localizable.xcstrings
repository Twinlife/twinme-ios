    "create_profile_view_onboarding_message_part_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح لك الملفات الشخصية دعوة جهات الاتصال لإنشاء علاقات معك على التطبيق. يمكنك الحصول على أي عدد تريده من الملفات الشخصية (الشخصيات)، يرتبط كل منها بـ مساحة معينة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилите ви позволяват да каните контакти да създават връзки с вас в приложението. Можете да имате толкова профили (персони), колкото желаете, всеки асоцииран с конкретно „Пространство“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profily vám umožňují pozvat kontakty k vytvoření vztahů v aplikaci. Můžete mít tolik profilů (person), kolik chcete, každý přiřazený ke konkrétnímu „Prostoru“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler giver dig mulighed for at invitere kontakter til at skabe relationer med dig i applikationen. Du kan have så mange profiler (persona), som du vil, hver tilknyttet et bestemt Space."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile ermöglichen es Ihnen, Kontaktpersonen einzuladen, um Verbindungen mit Ihnen in der Anwendung einzugehen. Sie können so viele Profile (Personas) haben, wie Sie möchten, wobei jedes einem bestimmten „Bereich“ zugeordnet ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα προφίλ σάς επιτρέπουν να προσκαλείτε επαφές ώστε να δημιουργούν σχέσεις μαζί σας στην εφαρμογή. Μπορείτε να έχετε όσες «προσωπικότητες» θέλετε, καθεμία συνδεδεμένη με έναν συγκεκριμένο Χώρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiles allow you to invite contacts to create relationships with you on the application. You can have as many Profiles (persona) as you want, each associated with a particular Space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles le permiten invitar contactos para crear relaciones con usted en la aplicación. Puedes tener tantos Perfiles (persona) como quieras, cada uno asociado a un Space particular."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایه ها به شما امکان می دهند از مخاطبین دعوت کنید تا در برنامه با شما ارتباط برقرار کنند. شما می توانید به تعداد دلخواه پروفایل (شخصیت) داشته باشید که هر کدام با یک فضا خاص مرتبط هستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiilien avulla voit kutsua yhteyshenkilöitä luomaan suhteita kanssasi sovelluksessa. Sinulla voi olla niin monta profiilia (persona) kuin haluat, jokainen liitettynä tiettyyn Space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils vous permettent d'inviter des contacts à créer des relations avec vous sur l'application. Vous pouvez avoir autant de Profils (persona) que vous le souhaitez, chacun associé à un « Space » particulier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרופילים מאפשרים לך להזמין אנשי קשר ליצור איתך קשרים באפליקציה. אתה יכול לקבל כמה פרופילים (פרסונה) שתרצה, כל אחד משויך למרחב מסוים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल आपको एप्लिकेशन पर आपके साथ संबंध बनाने के लिए संपर्कों को आमंत्रित करने की अनुमति देती है। आप जितनी चाहें उतनी प्रोफ़ाइल (व्यक्तित्व) रख सकते हैं, प्रत्येक एक विशेष स्पेस से संबद्ध है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profili vam omogućuju da pozovete kontakte kako bi stvorili odnose s vama u aplikaciji. Možete imati koliko god želite profila (persona), svaki povezan s određenim „Prostorom”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilok lehetővé teszik, hogy kapcsolataidat meghívd az alkalmazásban. Annyi profilt (szerepet) hozhatsz létre, amennyit szeretnél, mindegyik egy adott „Térhez” kapcsolódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil memungkinkan Anda mengundang kontak untuk menjalin hubungan dengan Anda di aplikasi. Anda dapat memiliki Profil (persona) sebanyak yang Anda inginkan, masing-masing dikaitkan dengan Space tertentu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili ti consentono di invitare i contatti a creare relazioni con te sull'applicazione. Puoi avere quanti Profili (persona) desideri, ciascuno associato ad un particolare Space."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールを使用すると、連絡先を招待してアプリケーション上であなたとの関係を築くことができます。 プロファイル (ペルソナ) は必要なだけ持つことができ、それぞれが特定の「スペース」に関連付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 사용하면 연락처를 초대하여 애플리케이션에서 귀하와 관계를 만들 수 있습니다. 원하는 만큼 많은 프로필(페르소나)을 가질 수 있으며, 각 프로필은 특정 스페이스과 연결되어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler lar deg invitere kontakter til å opprette relasjoner med deg på applikasjonen. Du kan ha så mange profiler (persona) du vil, hver tilknyttet et bestemt Space."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met profielen kunt u contacten uitnodigen om relaties met u op te bouwen in de applicatie. Je kunt zoveel profielen (persona) hebben als je wilt, elk gekoppeld aan een bepaalde Space."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile umożliwiają zapraszanie kontaktów do tworzenia relacji z Tobą w aplikacji. Możesz mieć dowolną liczbę profili (persona), każdy powiązany z konkretną „Space”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis permitem que você convide contatos para criar relacionamentos com você no aplicativo. Você pode ter quantos Perfis (persona) quiser, cada um associado a um determinado “Space”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilurile vă permit să invitați contacte pentru a crea relații cu dvs. în aplicație. Puteți avea câte Profile (persona) doriți, fiecare asociat unui anumit „Spațiu”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили позволяют вам приглашать контакты для создания отношений с вами в приложении. Вы можете иметь столько Профилей (персонажей), сколько захотите, каждый из которых связан с определенным «Пространством»."
          }
