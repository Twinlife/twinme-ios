          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị tên liên hệ trong thông báo, và không ghi lại cuộc gọi trong lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
