    "show_space_view_secret_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تظهر \"Spaces\" السرية في قائمة \"Spaces\" ولا يمكن فتحها إلا عن طريق كتابة اسمها في شريط البحث. لا تنسَ هذا الاسم أبدًا!"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайните Spaces не се появяват в списъка със Spaces и могат да бъдат отворени само чрез въвеждане на името им в лентата за търсене. Никога не забравяйте това име!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajné Prostory se v seznamu Prostorů nezobrazují a lze je otevřít pouze zadáním jejich názvu do vyhledávacího pole. Nikdy na ten název nezapomeňte!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemmelige Spaces vises ikke på listen over Spaces og kan kun åbnes ved at indtaste deres navn i søgefeltet. Glem aldrig det navn!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheime Spaces erscheinen nicht in der Liste der Spaces und können nur geöffnet werden, indem man ihren Namen in die Suchleiste eingibt. Vergessen Sie diesen Namen nie!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Μυστικοί Χώροι δεν εμφανίζονται στη λίστα των Χώρων και μπορούν να ανοιχτούν μόνο πληκτρολογώντας το όνομά τους στη γραμμή αναζήτησης. Ποτέ μην ξεχάσετε αυτό το όνομα!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret Spaces do not appear in the list of Spaces and can only be opened by typing their name in the search bar. Never forget that name !"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Spaces secretos no aparecen en la lista de Spaces y solo se pueden abrir escribiendo su nombre en la barra de búsqueda. ¡No olvide nunca ese nombre!"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces مخفی در لیست \"Spaces\" ظاهر نمی شود و تنها با تایپ نام آنها در نوار جستجو باز می شود. هرگز این نام را فراموش نکنید!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salaiset Spaces eivät näy Spaces-luettelossa, ja ne voidaan avata vain kirjoittamalla niiden nimi hakupalkkiin. Älä koskaan unohda sitä nimeä!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Spaces secrets n'apparaissent pas dans la liste des Spaces et ne peuvent être ouverts qu'en tapant leur nom dans la barre de recherche. N'oubliez jamais ce nom !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces סודיים אינם מופיעים ברשימת ה \"Spaces\" וניתן לפתוח אותם רק על ידי הקלדת שמם בשורת החיפוש. לעולם אל תשכח את השם הזה!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गुप्त \"Spaces\" \"Spaces\" की सूची में दिखाई नहीं देते हैं और उन्हें केवल खोज बार में उनका नाम लिखकर खोला जा सकता है. उस नाम को कभी न भूलें!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajni Prostori ne prikazuju se na popisu Prostora i mogu se otvoriti samo upisivanjem njihovog naziva u traku za pretraživanje. Nikada ne zaboravite taj naziv!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A titkos Space-ek nem jelennek meg a Space-ek listájában, és csak a nevük keresősávba történő beírásával nyithatók meg. Soha ne felejtse el azt a nevet!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces rahasia tidak muncul dalam daftar Spaces dan hanya dapat dibuka dengan mengetikkan namanya di bilah pencarian. Jangan pernah lupa nama itu!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli Spaces segreti non compaiono nell'elenco degli Spaces e possono essere aperti solo digitandone il nome nella barra di ricerca. Non dimenticare mai quel nome!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密の「Spaces」は「Spaces」のリストに表示されず、検索バーに名前を入力してのみ開くことができます。名前を忘れないようにしてください!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀 \"Spaces\"는 \"Spaces\" 목록에 나타나지 않으며 검색 창에 이름을 입력해야만 열 수 있습니다. 그 이름을 절대 잊지 마세요!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemmelige Spaces vises ikke i listen over Spaces og kan bare åpnes ved å skrive navnet deres i søkefeltet. Glem aldri det navnet!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheime Spaces verschijnen niet in de lijst met Spaces en kunnen alleen worden geopend door hun naam in de zoekbalk te typen. Vergeet die naam nooit!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajne „Spaces” nie pojawiają się na liście „Spaces” i można je otworzyć tylko poprzez wpisanie ich nazwy w pasku wyszukiwania. Nigdy nie zapomnij tej nazwy!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Spaces secretos não aparecem na lista de Spaces e só podem ser abertos escrevendo o seu nome na barra de pesquisa. Nunca se esqueça deste nome!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space-urile secrete nu apar în lista de Space-uri și pot fi deschise doar tastând numele lor în bara de căutare. Nu uitați niciodată acel nume!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретные «Spaces» не отображаются в списке «Spaces» и могут быть открыты только путем ввода их имени в строке поиска. Никогда не забывайте это имя!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajné Priestory sa nezobrazujú v zozname Priestorov a dajú sa otvoriť iba zadaním ich názvu do vyhľadávacieho poľa. Nikdy na ten názov nezabudnite!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivni Prostori se ne pojavijo na seznamu Prostorov in jih je mogoče odpreti samo z vnosom njihovega imena v iskalno vrstico. Nikoli ne pozabite tega imena!"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space-et sekrete nuk shfaqen në listën e Space-ve dhe mund të hapen vetëm duke shtypur emrin e tyre në shiritin e kërkimit. Mos e harroni kurrë atë emër!"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajni Space-ovi se ne pojavljuju na listi Space-ova i mogu se otvoriti samo upisivanjem njihovog naziva u polje za pretragu. Nikada ne zaboravite to ime!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemliga Spaces visas inte i listan över Spaces och kan bara öppnas genom att skriva deras namn i sökfältet. Glöm aldrig det namnet!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli Spaces, Spaces listesinde görünmez ve yalnızca arama çubuğuna adlarını yazarak açılabilir. Bu adı asla unutmayın!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретні Spaces не відображаються в списку Spaces, і їх можна відкрити, лише ввівши їх назву в рядок пошуку. Ніколи не забувайте цього імені!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gian bí mật không xuất hiện trong danh sách và chỉ có thể mở bằng cách nhập tên chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密「Spaces」不会出现在「Spaces」清单中，只能透过在搜寻栏中输入其名称来开启。永远不要忘记那个名字！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密「Spaces」不會出現在「Spaces」清單中，只能透過在搜尋欄中輸入其名稱來開啟。永遠不要忘記那個名字！"
          }
        }
      }
    },
