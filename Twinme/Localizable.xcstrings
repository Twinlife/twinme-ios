    "account_migration_scanner_view_message" : {
      "comment" : "AccountMigrationScannerViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض هذه الشاشة على كل جهاز ويقوم أحدهم بمسح رمز الاستجابة السريعة الخاص بالآخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажете този екран на всяко устройство и едното да сканира QR-кода на другото."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazte tuto obrazovku na obou zařízeních a jedno naskenuje QR kód druhého."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis denne skærm på hver enhed, og den ene scanner den andens QR-kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen Sie diesen Bildschirm auf jedem Gerät an, und eines scannt den QR-Code des anderen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίστε αυτή την οθόνη σε κάθε συσκευή και η μία σαρώστε τον QR‑κώδικα της άλλης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display this screen on each device, and one scans the other’s QR-Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestre esta pantalla en cada dispositivo y uno escanea el código QR del otro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این صفحه را روی هر دستگاه نمایش دهید و یکی QR-Code دیگری را اسکن کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä tämä näyttö jokaisessa laitteessa ja toinen skannaa toisen QR-koodin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez cet écran sur chaque appareil et l’un scanne le QR-Code de l’autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג מסך זה בכל מכשיר, ואחד סורק את קוד ה- QR של השני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक डिवाइस पर इस स्क्रीन को प्रदर्शित करें, और एक दूसरे के QR- कोड को स्कैन करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite ovaj zaslon na svakom uređaju, a zatim jedan uređaj skenira QR-kôd drugoga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelenítsd meg ezt a képernyőt mindkét eszközön, és az egyik olvassa be a másik QR-kódját."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan layar ini di setiap perangkat, dan yang satu memindai Kode QR lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza questa schermata su ogni dispositivo e uno esegue la scansione del codice QR dell’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面を各デバイスに表示し、一方が他方のQRコードをスキャンします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 화면을 각 장치에 표시하고 하나는 다른 장치의 QR 코드를 스캔합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis denne skjermen på hver enhet, og den ene skanner den andre QR-koden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef dit scherm weer op elk apparaat en de een scant de QR-code van de ander."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetl ten ekran na każdym urządzeniu, a jedno zeskanuje kod QR drugiego."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiba essa tela em cada dispositivo, e um fará a varredura do código QR do outro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați acest ecran pe fiecare dispozitiv, iar unul va scana codul QR al celuilalt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отобразите этот экран на каждом устройстве, и одно будет сканировать QR-код другого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazte túto obrazovku na oboch zariadeniach a jedno nech naskenuje QR‑kód druhého."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite ta zaslon na vsaki napravi, nato ena naprava skenira QR-kodo druge."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shfaqni këtë ekran në secilën pajisje dhe njëra skanon QR-Code të tjetrës."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite ovaj ekran na oba uređaja, a jedan skenira QR-kod drugog."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa den här skärmen på varje enhet och den ena genomsöker den andra QR-koden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ekranı her cihazda görüntüleyin ve biri diğerinin QR Kodunu tarar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканувати"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị màn hình này trên mỗi thiết bị, và một thiết bị sẽ quét mã QR của thiết bị kia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每台设备上显示此屏幕，一个扫描另一台的QR码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每台設備上顯示此屏幕，一個掃描另一台的QR碼。"
          }
        }
      }
    },
    "account_migration_scanner_view_message_older_version" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم هذا الجهاز إصدارًا قديمًا غير متوافق من نظام التشغيل، مما سيؤدي إلى فقدان جميع العلاقات الموجودة على الجهاز المستهدف أثناء عملية النقل. هل مازلت تريد متابعة عملية النقل؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство използва стара, несъвместима версия на ОС, което ще доведе до загуба на всички връзки на целевото устройство по време на прехвърлянето. Искате ли въпреки това да продължите?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení používá starou nekompatibilní verzi OS, což způsobí ztrátu všech vztahů na cílovém zařízení během přenosu. Chcete i přesto pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed bruger en gammel inkompatibel OS-version, som vil medføre, at alle relationer på målenheden går tabt under overførslen. Vil du stadig fortsætte med overførslen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät verwendet eine alte inkompatible Betriebssystemversion, was dazu führt, dass alle Verbindungen auf dem Zielgerät während der Übertragung verloren gehen. Möchten Sie trotzdem mit der Übertragung fortfahren?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή χρησιμοποιεί παλιά, μη συμβατή έκδοση λειτουργικού συστήματος, η οποία θα προκαλέσει απώλεια όλων των σχέσεων στη συσκευή‑στόχο κατά τη μεταφορά. Θέλετε ακόμη να συνεχίσετε;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device is using an old incompatible OS version, which will cause all the relations on the target device to be lost during the transfer. Do you still want to proceed with the transfer?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo utiliza una versión antigua del sistema operativo incompatible, lo que provocará que todas las relaciones en el dispositivo de destino se pierdan durante la transferencia. ¿Aún deseas continuar con la transferencia?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این دستگاه از یک نسخه قدیمی سیستم عامل ناسازگار استفاده می کند که باعث می شود تمام روابط روی دستگاه مورد نظر در حین انتقال از بین برود. آیا هنوز می خواهید به انتقال ادامه دهید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite käyttää vanhaa yhteensopimatonta käyttöjärjestelmäversiota, minkä vuoksi kaikki kohdelaitteen suhteet menetetään siirron aikana. Haluatko silti jatkaa siirtoa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil utilise une ancienne version du système d’exploitation incompatible, ce qui entraînera la perte de toutes les relations sur l’appareil cible lors du transfert. Souhaitez-vous quand même procéder au transfert ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכשיר זה משתמש בגרסת מערכת הפעלה ישנה שאינה תואמת, אשר תגרום לאיבוד כל היחסים במכשיר היעד במהלך ההעברה. האם אתה עדיין רוצה להמשיך בהעברה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डिवाइस एक पुराने असंगत ओएस संस्करण का उपयोग कर रहा है, जिसके कारण स्थानांतरण के दौरान लक्ष्य डिवाइस पर सभी संबंध नष्ट हो जाएंगे। क्या आप अब भी स्थानांतरण के साथ आगे बढ़ना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj koristi staru nekompatibilnu verziju operativnog sustava, što će uzrokovati gubitak svih odnosa na ciljnom uređaju tijekom prijenosa. Želite li ipak nastaviti s prijenosom?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz egy régi, inkompatibilis OS-verziót használ, amely miatt az összes kapcsolat elveszik az átvitel során. Folytatod?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini menggunakan versi OS lama yang tidak kompatibel, yang akan menyebabkan semua hubungan pada perangkat target hilang selama transfer. Apakah Anda masih ingin melanjutkan transfer?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo utilizza una vecchia versione del sistema operativo incompatibile, che causerà la perdita di tutte le relazioni sul dispositivo di destinazione durante il trasferimento. Vuoi comunque procedere con il trasferimento?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは互換性のない古いバージョンの OS を使用しているため、転送中にターゲット デバイス上のすべての関係が失われます。 まだ転送を続行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 장치는 호환되지 않는 이전 OS 버전을 사용하고 있어 전송 중에 대상 장치의 모든 관계가 손실됩니다. 그래도 이전을 진행하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten bruker en gammel inkompatibel OS-versjon, som vil føre til at alle relasjoner på målenheten går tapt under overføringen. Vil du fortsatt fortsette med overføringen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat gebruikt een oude, incompatibele besturingssysteemversie, waardoor alle relaties op het doelapparaat verloren gaan tijdens de overdracht. Wilt u toch doorgaan met de overdracht?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie używa starej, niezgodnej wersji systemu operacyjnego, co spowoduje utratę wszystkich relacji na urządzeniu docelowym podczas przesyłania. Czy nadal chcesz kontynuować transfer?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo está usando uma versão antiga do sistema operacional incompatível, o que fará com que todas as relações no dispositivo de destino sejam perdidas durante a transferência. Você ainda deseja prosseguir com a transferência?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest dispozitiv folosește o versiune mai veche de OS incompatibilă, ceea ce va duce la pierderea tuturor relațiilor de pe dispozitivul țintă în timpul transferului. Doriți totuși să continuați?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве используется старая несовместимая версия ОС, что приведет к потере всех связей на целевом устройстве во время передачи. Вы все еще хотите продолжить перенос?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie používa starú nekompatibilnú verziu OS, čo spôsobí stratu všetkých vzťahov na cieľovom zariadení počas prenosu. Chcete napriek tomu pokračovať?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta naprava uporablja staro, nezdružljivo različico OS, zaradi česar bodo med prenosom izgubljeni vsi odnosi na ciljni napravi. Ali želite kljub temu nadaljevati s prenosom?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo pajisje përdor një version të vjetër të papajtueshëm të OS, gjë që do të shkaktojë humbjen e të gjitha marrëdhënieve në pajisjen e synuar gjatë transferimit. Dëshironi ende të vazhdoni me transferimin?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj koristi staru nekompatibilnu verziju operativnog sistema, što će dovesti do gubitka svih odnosa na ciljnom uređaju tokom prenosa. Da li i dalje želite da nastavite sa prenosom?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten använder en gammal inkompatibel OS-version, vilket gör att alla relationer på målenheten går förlorade under överföringen. Vill du fortfarande fortsätta med överföringen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz eski, uyumsuz bir işletim sistemi sürümünü kullanıyor ve bu da aktarım sırasında hedef cihazdaki tüm ilişkilerin kaybolmasına neden olacak. Hala aktarıma devam etmek istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій використовує стару несумісну версію ОС, через що всі зв’язки на цільовому пристрої будуть втрачені під час передачі. Ви все ще хочете продовжити перенесення?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này đang sử dụng phiên bản hệ điều hành cũ không tương thích, điều này sẽ khiến tất cả các liên hệ bị mất trên thiết bị đích khi chuyển. Bạn vẫn muốn tiếp tục?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该设备使用旧的不兼容的操作系统版本，这将导致目标设备上的所有关系在传输过程中丢失。 您还想继续进行转移吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該設備使用舊的不相容的作業系統版本，這將導致目標設備上的所有關係在傳輸過程中遺失。 您還想繼續進行轉移嗎？"
          }
        }
      }
    },
    "account_migration_scanner_view_message_older_version_target" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم الجهاز المستهدف إصدارًا قديمًا غير متوافق من نظام التشغيل، مما سيؤدي إلى فقدان جميع علاقاتك أثناء عملية النقل. هل مازلت تريد متابعة عملية النقل؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целевото устройство използва стара, несъвместима версия на ОС, което ще доведе до загуба на всички ваши връзки по време на прехвърлянето. Искате ли въпреки това да продължите?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cílové zařízení používá starou nekompatibilní verzi OS, což způsobí ztrátu všech vašich vztahů během přenosu. Chcete i přesto pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målenheden bruger en gammel inkompatibel OS-version, som vil medføre, at alle dine relationer går tabt under overførslen. Vil du stadig fortsætte med overførslen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zielgerät verwendet eine alte inkompatible Betriebssystemversion, was dazu führt, dass alle Ihre Verbindungen während der Übertragung verloren gehen. Möchten Sie trotzdem mit der Übertragung fortfahren?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συσκευή‑στόχος χρησιμοποιεί παλιά μη συμβατή έκδοση λειτουργικού συστήματος, η οποία θα προκαλέσει απώλεια όλων των σχέσεών σας κατά τη μεταφορά. Θέλετε ακόμη να συνεχίσετε;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The target device is using an old incompatible OS version, which will cause all your relations to be lost during the transfer. Do you still want to proceed with the transfer?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo de destino utiliza una versión antigua del sistema operativo incompatible, lo que provocará que se pierdan todas sus relaciones durante la transferencia. ¿Aún deseas continuar con la transferencia?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستگاه مورد نظر از یک نسخه قدیمی سیستم عامل ناسازگار استفاده می کند که باعث می شود تمام روابط شما در حین انتقال از بین برود. آیا هنوز می خواهید به انتقال ادامه دهید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohdelaite käyttää vanhaa yhteensopimatonta käyttöjärjestelmäversiota, minkä vuoksi kaikki suhteesi menetetään siirron aikana. Haluatko silti jatkaa siirtoa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil cible utilise une ancienne version du système d’exploitation incompatible, ce qui entraînera la perte de toutes vos relations lors du transfert. Souhaitez-vous quand même procéder au transfert ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכשיר היעד משתמש בגרסת מערכת הפעלה ישנה שאינה תואמת, מה שיגרום לאיבוד כל הקשרים שלך במהלך ההעברה. האם אתה עדיין רוצה להמשיך בהעברה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य डिवाइस पुराने असंगत OS संस्करण का उपयोग कर रहा है, जिसके कारण स्थानांतरण के दौरान आपके सभी संबंध नष्ट हो जाएंगे। क्या आप अब भी स्थानांतरण के साथ आगे बढ़ना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciljni uređaj koristi staru nekompatibilnu verziju operativnog sustava, što će uzrokovati gubitak svih vaših odnosa tijekom prijenosa. Želite li ipak nastaviti s prijenosom?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cél eszköz régi, inkompatibilis OS-t használ, ami minden kapcsolat elvesztését okozza. Folytatod?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat target menggunakan versi OS lama yang tidak kompatibel, yang akan menyebabkan semua hubungan Anda hilang selama transfer. Apakah Anda masih ingin melanjutkan transfer?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo di destinazione utilizza una vecchia versione del sistema operativo incompatibile, che causerà la perdita di tutte le relazioni durante il trasferimento. Vuoi comunque procedere con il trasferimento?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターゲットデバイスは互換性のない古いバージョンの OS を使用しているため、転送中にすべての関係が失われます。 まだ転送を続行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 장치가 호환되지 않는 오래된 OS 버전을 사용하고 있어 전송 중에 모든 관계가 손실됩니다. 그래도 이전을 진행하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målenheten bruker en gammel inkompatibel OS-versjon, som vil føre til at alle relasjonene dine går tapt under overføringen. Vil du fortsatt fortsette med overføringen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het doelapparaat gebruikt een oude, incompatibele versie van het besturingssysteem, waardoor al uw relaties tijdens de overdracht verloren gaan. Wilt u toch doorgaan met de overdracht?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie docelowe używa starej, niezgodnej wersji systemu operacyjnego, co spowoduje utratę wszystkich Twoich relacji podczas transferu. Czy nadal chcesz kontynuować transfer?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo de destino está usando uma versão antiga do sistema operacional incompatível, o que fará com que todas as suas relações sejam perdidas durante a transferência. Você ainda deseja prosseguir com a transferência?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivul țintă folosește o versiune veche de OS incompatibilă, ceea ce va duce la pierderea tuturor relațiilor dvs. în timpul transferului. Doriți totuși să continuați?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На целевом устройстве используется старая несовместимая версия ОС, что приведет к потере всех ваших связей во время передачи. Вы все еще хотите продолжить перенос?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieľové zariadenie používa starú nekompatibilnú verziu OS, čo spôsobí stratu všetkých vašich vzťahov počas prenosu. Chcete napriek tomu pokračovať?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciljna naprava uporablja staro, nezdružljivo različico OS, zaradi česar bodo med prenosom izgubljeni vsi vaši odnosi. Ali želite kljub temu nadaljevati s prenosom?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pajisja e synuar përdor një version të vjetër të papajtueshëm të OS, gjë që do të shkaktojë humbjen e të gjitha marrëdhënieve tuaja gjatë transferimit. Dëshironi ende të vazhdoni me transferimin?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciljni uređaj koristi staru nekompatibilnu verziju operativnog sistema, što će dovesti do gubitka svih vaših odnosa tokom prenosa. Da li i dalje želite da nastavite sa prenosom?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målenheten använder en gammal inkompatibel OS-version, vilket gör att alla dina relationer går förlorade under överföringen. Vill du fortfarande fortsätta med överföringen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef cihaz eski, uyumsuz bir işletim sistemi sürümü kullanıyor ve bu da aktarım sırasında tüm ilişkilerinizin kaybolmasına neden olacak. Hala aktarıma devam etmek istiyor musunuz?"
          }
