    "create_external_call_view_notification_setting" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقي إشعار فور انضمام أول مشارك إلى المكالمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получавайте известие веднага щом първият участник се присъедини."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornit, jakmile se první účastník připojí ke konferenci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få besked, så snart den første deltager deltager i konferencen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigt werden, sobald die erste teilnehmende Person der Konferenz beitritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβετε ειδοποίηση μόλις ο πρώτος συμμετέχων συνδεθεί στην τηλεδιάσκεψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be notified as soon as the first participant joins the conference."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reciba una notificación en cuanto el primer participante se una a la conferencia. "
