    "call_view_certify_onboarding_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح مكالمة الفيديو التعرف المتبادل وتبادل مفاتيح الأمان المرتبطة بالعلاقة المعتمدة وتبادلاتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видеоразговорът ви позволява да се идентифицирате взаимно и да размените ключовете за сигурност, свързани със сертифицираната връзка и нейните обменни данни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videohovor vám umožňuje se vzájemně identifikovat a vyměnit si bezpečnostní klíče spojené s certifikovaným vztahem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoopkaldet giver jer mulighed for at identificere hinanden og udveksle de sikkerhedsnøgler, der er knyttet til en certificeret relation og dens udvekslinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Videoanruf ermöglicht es Ihnen, sich gegenseitig zu identifizieren und die Sicherheitsschlüssel auszutauschen, die mit einer zertifizierten Verbindungen und deren Austausch verbunden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βιντεοκλήση σας επιτρέπει να αναγνωρίσετε ο ένας τον άλλο και να ανταλλάξετε τα κλειδιά ασφαλείας μιας πιστοποιημένης σχέσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The video call allows you to identify each other and exchange the security keys associated with a certified relation and its exchanges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La videollamada permite identificarse e intercambiar las claves de seguridad asociadas a una relación certificada y sus intercambios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تماس ویدیویی به شما امکان می دهد یکدیگر را شناسایی کرده و کلیدهای امنیتی مرتبط با یک رابطه تایید شده و مبادلات آن را مبادله کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videopuhelun avulla voit tunnistaa toisensa ja vaihtaa sertifioituun suhteeseen ja sen vaihtoihin liittyviä suojausavaimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'appel vidéo permet de s'identifier mutuellement et d'échanger les clés de sécurité associées à une relation certifiée et à ses échanges."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיחת הווידאו מאפשרת לכם לזהות אחד את השני ולהחליף את מפתחות האבטחה הקשורים לקשר מוסמך ולחילופיות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो कॉल आपको एक दूसरे को पहचानने और प्रमाणित संबंध और उसके आदान-प्रदान से जुड़ी सुरक्षा कुंजियों का आदान-प्रदान करने की अनुमति देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videopoziv vam omogućuje da se međusobno identificirate i razmijenite sigurnosne ključeve povezane s potvrđenim odnosom i njegovim razmjenama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A videohívás lehetővé teszi az egymás azonosítását és a hitelesített kapcsolathoz tartozó biztonsági kulcsok cseréjét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilan video memungkinkan Anda untuk saling mengidentifikasi dan bertukar kunci keamanan yang terkait dengan relasi tersertifikasi dan pertukarannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La videochiamata consente di identificarsi a vicenda e di scambiare le chiavi di sicurezza associate a una relazione certificata e ai suoi scambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ通話では、お互いを識別し、認証された関係とその交換に関連付けられたセキュリティ キーを交換できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상 통화를 통해 상호 식별이 가능하며, 인증 관계 및 교환과 관련된 보안 키를 교환할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videosamtalen lar dere identifisere hverandre og utveksle sikkerhetsnøklene knyttet til en sertifisert relasjon og dens sentraler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met het videogesprek kunt u elkaar identificeren en de beveiligingssleutels uitwisselen die zijn gekoppeld aan een gecertificeerde relatie en de uitwisselingen daarvan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie wideo umożliwia identyfikację i wymianę kluczy bezpieczeństwa powiązanych z certyfikowaną relacją i jej wymianami."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A videochamada permite identificar-se e trocar as chaves de segurança associadas a uma relação certificada e às suas trocas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apelul video permite identificarea reciprocă și schimbul cheilor de securitate asociate unei relații certificate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видеозвонок позволяет вам идентифицировать друг друга и обмениваться ключами безопасности, связанными с сертифицированным отношением и его обменами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videohovor vám umožňuje vzájomne sa identifikovať a vymeniť si bezpečnostné kľúče asociované s certifikovaným vzťahom a jeho výmenami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video klic vam omogoča, da se medsebojno prepoznate in izmenjate varnostne ključe, povezane s certificiranim odnosom in njegovimi izmenjavami."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirrja video ju lejon të identifikoni njëri-tjetrin dhe të shkëmbeni çelësat e sigurisë të lidhur me një marrëdhënie të certifikuar dhe shkëmbimet e saj."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video poziv vam omogućava da se međusobno identifikujete i razmenite bezbednosne ključeve povezane sa sertifikovanim odnosom i njegovom razmenom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videosamtalet låter er identifiera varandra och utbyta säkerhetsnycklar som är kopplade till en certifierad relation och dess utbyten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntülü görüşme, birbirinizi tanımlamanıza ve onaylı bir ilişki ve onun değişimleriyle ilişkili güvenlik anahtarlarını değiştirmenize olanak tanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відеодзвінок дозволяє ідентифікувати один одного та обмінюватися ключами безпеки, пов’язаними із сертифікованим зв’язком і його обміном."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc gọi video cho phép bạn nhận diện nhau và trao đổi các khóa bảo mật gắn với mối quan hệ đã xác thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频通话允许相互识别和交换与经过认证的关系及其交换相关的安全密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視訊通話允許相互識別和交換與經過認證的關係及其交換相關的安全密鑰。"
          }
        }
      }
    },
    "call_view_certify_onboarding_start_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل بدوره ، تهجئة الكلمة المعروضة على شاشتك التي يمكن للآخر التحقق منها. بمجرد التحقق من جميع الكلمات ، سيتم اعتماد علاقتك مع %@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На свой ред изговаряйте думата, показана на екрана ви, която другият може да провери. След като всички думи бъдат проверени, връзката ви с %@ ще бъде сертифицирана."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postupně vyslovujte slovo zobrazené na vaší obrazovce tak, aby jej druhá osoba mohla ověřit. Po ověření všech slov bude váš vztah s %@ certifikován."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav hver især det ord, der vises på skærmen, og som den anden kan bekræfte. Når alle ord er verificeret, vil din relation med %@ være certificeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buchstabieren Sie abwechselnd das auf Ihrem Bildschirm angezeigte Wort, das die andere Person verifizieren kann. Sobald alle Wörter verifiziert sind, wird Ihre Verbindung mit %@ zertifiziert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο καθένας, με τη σειρά του, προφέρει τη λέξη που εμφανίζεται στην οθόνη ώστε ο άλλος να την επαληθεύσει. Όταν όλες οι λέξεις επαληθευτούν, η σχέση σας με τον/την %@ θα πιστοποιηθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each in turn, spell the word displayed on your screen that the other can verify. Once all the words are verified, your relation with %@ will be certified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno por turno, deletrea la palabra que aparece en tu pantalla y que el otro puede verificar. Una vez verificadas todas las palabras, tu relación con %@ quedará certificada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کدام به نوبت، کلمه نمایش داده شده روی صفحه نمایش خود را که دیگری می‌تواند تأیید کند، هجی کنید. پس از تأیید همه کلمات، رابطه شما با %@ تأیید خواهد شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen vuorotellen sanoa näytölle näytetty sana, jonka toinen voi tarkistaa. Kun kaikki sanat on varmennettu, suhteesi %@ on sertifioitu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun à votre tour, épelez le mot affiché sur votre écran que l'autre pourra vérifier. Une fois tous les mots vérifiés, votre relation avec %@ sera certifiée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر کدام به نوبه خود ، کلمه نمایش داده شده در صفحه شما را هجی می کنند که دیگری می تواند آن را تأیید کند. پس از تأیید همه کلمات ، رابطه شما با%@ تأیید می شود."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे की जाँच के लिए अपनी स्क्रीन पर प्रदर्शित शब्द की वर्तनी बारी-बारी से रखें। एक बार सभी शब्द सत्यापित हो जाने पर, %@ के साथ आपका संबंध प्रमाणित हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naizmjence slovkajte riječ prikazanu na zaslonu, koju druga osoba može provjeriti. Kada su sve riječi provjerene, vaš odnos s %@ bit će potvrđen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felváltva mondd ki a képernyőn megjelenő szót, amelyet a másik fél ellenőrizni tud. Miután minden szót ellenőriztetek, a kapcsolatod %@ személlyel hitelesítve lesz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergiliranlah mengeja kata yang ditampilkan di layar Anda agar orang lain dapat memeriksanya. Setelah semua kata diverifikasi, hubungan Anda dengan %@ akan disertifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno, a turno, scrive la parola visualizzata sullo schermo che l'altro può verificare. Una volta verificate tutte le parole, la relazione con %@ sarà certificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面に表示された単語のスペルを交代で入力し、他の人にチェックしてもらいます。すべての単語が検証されると、%@ との関係が証明されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사람이 확인할 수 있도록 화면에 표시된 단어의 철자를 번갈아 가며 입력하세요. 모든 단어가 확인되면 %@와의 관계가 인증됩니다."
