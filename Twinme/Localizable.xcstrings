    "application_create_group_no_profile" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب عليك إكمال ملف تعريف يمثلك في هذه المجموعة. يتابع؟"
