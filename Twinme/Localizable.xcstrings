        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da li ste sigurni da želite da obrišete ovaj odnos?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill ta bort denna relation?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ilişkiyi silmek istediğinizden emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені, що бажаєте видалити цей зв’язок?"
