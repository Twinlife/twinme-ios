    "space_appearance_view_preview_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسيت حذاء الباليه الخاص بي ... هل يمكنك اصطحابه معك؟ 😘"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забравих си балетните обувки… Можеш ли да ми ги донесеш, моля?😘"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomněla jsem si baletní boty… Můžeš mi je prosím vzít s sebou?😘"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg har glemt mine balletsko ... kan du tage dem med dig? 😘"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe meine Ballettschuhe vergessen… Kannst du sie mir bitte mitbringen?😘"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξέχασα τα παπούτσια μπαλέτου μου… Μπορείς να μου τα φέρεις;😘"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I forgot my ballet shoes… Can you bring them with you please?😘"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidé mis zapatillas de ballet ... ¿Puedes llevarlas contigo por favor? 😘"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کفش های باله خودم را فراموش کردم ... می توانی آنها را با خودت بر داری؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unohdin balettikenkäni ... Voitko tuoda ne mukaasi? 😘"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai oublié mes chaussons de danse… Tu peux les prendre avec toi ?😘"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שכחתי את נעלי הבלט שלי ... אתה יכול להביא אותם איתך בבקשה? 😘"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं अपने बैले जूते भूल गया ... क्या आप उन्हें अपने साथ ले जा सकते हैं? 😘"
