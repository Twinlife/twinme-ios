        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naizmenično izgovorite slovo po slovo reč prikazanu na vašem ekranu, koju druga osoba može da proveri. Kada sve reči budu proverene, vaš odnos sa %@ biće sertifikovan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var och en i tur och ordning stavar det ord som visas på skärmen och som den andre kan verifiera. När alla ord har verifierats kommer din relation med %@ att certifieras."
