    "deleted_account_view_message" : {
      "comment" : "DeletedAccountViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف حسابك وإزالة جميع البيانات المرتبطة به من جهازك وخوادمك.\nيجب عليك إغلاق التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашият акаунт беше изтрит и всички свързани данни бяха унищожени.<br />Трябва да затворите приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet byl smazán a všechna související data byla zničena. Musíte aplikaci zavřít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto er blevet slettet, og alle tilknyttede data er blevet fjernet fra din enhed og fra serverne.\nDu skal lukke programmet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Konto wurde gelöscht und alle zugehörigen Daten wurden vernichtet.<br />\n        Sie müssen die Anwendung nun schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός σας έχει διαγραφεί και όλα τα συσχετισμένα δεδομένα έχουν καταστραφεί.&lt;br /&gt;\n            Πρέπει να κλείσετε την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account has been deleted and all associated data removed from your device and from the servers.\nYou must close the application."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuenta ha sido eliminada y todos los datos asociados se eliminaron de su dispositivo y de los servidores.\nDebe cerrar la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ">حساب کاربری شما حذف شده است و تمام اطلاعا مرتبط از دستگاه شما و از سرور حذف شده است.\nشما باید برنامه را ببندید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilisi on poistettu ja kaikki siihen liittyvät tiedot poistettu laitteesta ja palvelimista.\nYou sulkee sovelluksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte a été supprimé et toutes les données associées éliminées de votre appareil et des serveurs.\nVous devez fermer l’application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונך נמחק וכל המידע המשויך לו הוסר מהמכשיר ומהשרתים שלך.\nאנא סגור את האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका खाता हटा दिया गया है और सभी संबंधित डेटा आपके डिवाइस से और सर्वर से हटा दिए गए हैं।\nआपको एप्लिकेशन को बंद करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš je račun izbrisan i svi povezani podaci su uništeni.<br />\n        Morate zatvoriti aplikaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiókod törlésre került, és minden kapcsolódó adat megsemmisült.Be kell zárnod az alkalmazást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun Anda akan dihapus dan semua data terkait dihapus dari perangkat Anda dan dari server.\nAnda harus menutup aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è stato cancellato e tutti i dati associati sono stati rimossi dal tuo dispositivo e dai server.\nÈ necessario chiudere l’applicazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのアカウントは削除され、関連付けられているすべてのデータは、デバイスやサーバーから削除されました。\nアプリケーションを終了する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 계정이 삭제되었으며 모든 관련 데이터가 장치 및 서버에서 제거되었습니다.\n응용 프로그램을 닫아야합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen din er slettet og alle tilknyttede data er fjernet fra enheten din og fra serverne.\nDu må stenge programmet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw account is verwijderd en alle bijbehorende gegevens zijn van uw apparaat en servers verwijderd.\nU moet de toepassing sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto zostało usunięte, a wszystkie powiązane dane z urządzenia i serwerów. \nMusisz zamknąć aplikację."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta foi excluída e todos os dados associados foram removidos do seu dispositivo e dos servidores.\nVocê deve fechar o aplicativo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contul dvs. a fost șters, iar toate datele asociate au fost distruse. Trebuie să închideți aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша учетная запись была удалена, и все связанные данные удалены с вашего устройства и с серверов.\nВы должны закрыть приложение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet bol odstránený a všetky súvisiace údaje boli zničené. Musíte zavrieť aplikáciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš račun je bil izbrisan in vsi povezani podatki so bili uničeni.<br />\n        Zapreti morate aplikacijo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llogaria juaj është fshirë dhe të gjitha të dhënat e lidhura janë shkatërruar.<br />\n            Duhet të mbyllni aplikacionin."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš nalog je obrisan i svi povezani podaci su uništeni.<br />\n        Morate zatvoriti aplikaciju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto har tagits bort och alla associerade data har tagits bort från din enhet och från servrarna.\nDu måste stänga programmet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız silindi ve tüm ilişkili veriler cihazınızdan ve sunuculardan kaldırıldı.\nUygulamayı kapatmanız gerekiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш обліковий запис видалено, а всі пов’язані з ним дані знищено. Користувачу.&lt;br /&gt;необхідно закрити додаток."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản của bạn đã bị xóa và toàn bộ dữ liệu liên quan đã được gỡ khỏi thiết bị và máy chủ.\nBạn phải đóng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的帐户已被删除，所有相关数据已从您的设备和服务器中删除。\n您必须关闭该应用程序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的帳戶已被刪除，所有相關數據已從您的設備和服務器中刪除\n您必須關閉該應用程序。"
          }
        }
      }
    },
