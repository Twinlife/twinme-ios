    "create_profile_view_onboarding_message_part_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك بعد ذلك تعديل الطريقة التي تريد أن تكون معروفة بها لكل جهة اتصال لديك، في كل علاقة، بشكل مستقل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След това можете да персонализирате как бихте искали да бъдете представени пред всеки контакт, за всяка връзка поотделно."
