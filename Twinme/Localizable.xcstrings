    "conversations_view_no_conversation_message" : {
      "comment" : "ConversationsViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تبادل الرسائل ، المشفرة من طرف إلى طرف ، في نظير إلى نظير ، مباشرة من جهاز إلى آخر ، بدون خادم توزيع وسيط = لا توجد آثار في السحابة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съобщенията с криптиране от край до край се обменят peer‑to‑peer, директно между устройствата, без междинен сървър = без следи в облака."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zprávy šifrované end‑to‑end jsou vyměňovány peer‑to‑peer, přímo mezi zařízeními, bez prostředního serveru = žádné stopy v cloudu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende-til-ende krypterede meddelelser udveksles i peer-to-peer, direkte fra enhed til enhed, uden en mellemliggende distributionsserver = ingen spor i skyen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende-zu-Ende verschlüsselte Nachrichten werden per Peer-to-Peer ausgetauscht, direkt von Gerät zu Gerät, ohne zwischengeschalteten Verteilungsserver = keine Spuren in der Cloud."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μηνύματα με κρυπτογράφηση άκρο‑σε‑άκρο ανταλλάσσονται peer‑to‑peer, απευθείας από συσκευή σε συσκευή, χωρίς ενδιάμεσο διακομιστή — χωρίς ίχνη στο cloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End-to-end encrypted messages are exchanged in peer-to-peer, directly from device to device, without an intermediate distribution server = no traces in the cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes cifrados de extremo a extremo se intercambian de igual a igual, directamente de un dispositivo a otro, sin un servidor de distribución intermedio = sin rastros en la nube."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیام های رمزگذاری شده انتهای انتها به صورت همتا ، مستقیماً از دستگاه به دستگاه دیگر ، بدون سرور توزیع میانی = هیچ اثری در ابر رد و بدل می شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päästä päähän salatut viestit vaihdetaan vertaisverkkoina, suoraan laitteesta toiseen, ilman välijakelupalvelinta = ei jälkiä pilvessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages, chiffrés de bout-en-bout, sont échangés en pair-à-pair, directement de terminal à terminal, sans serveur de distribution intermédiaire = pas de traces dans le nuage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסרים מוצפנים מקצה לקצה מוחלפים בין משתמש למשתמש, ישירות ממכשיר למכשיר, ללא שרת ביניים של הפצה = ללא עקבות בענן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंत-से-अंत एन्क्रिप्टेड संदेशों को सहकर्मी से सहकर्मी में आदान-प्रदान किया जाता है, सीधे डिवाइस से डिवाइस तक, एक मध्यवर्ती वितरण सर्वर के बिना = बादल में कोई निशान नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End-to-end šifrirane poruke razmjenjuju se peer-to-peer, izravno s uređaja na uređaj, bez posrednog poslužitelja za distribuciju = bez tragova u oblaku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A végponttól végpontig titkosított üzenetek közvetlenül eszközről eszközre kerülnek továbbításra, köztes szerver nélkül = nincs nyom a felhőben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan terenkripsi end-to-end dipertukarkan secara peer-to-peer, langsung dari perangkat ke perangkat, tanpa server distribusi perantara = tidak ada jejak di awan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi crittografati end-to-end vengono scambiati in peer-to-peer, direttamente da dispositivo a dispositivo, senza un server di distribuzione intermedio = nessuna traccia nel cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンドツーエンドの暗号化されたメッセージは、ピアツーピアで、デバイスからデバイスに直接交換されます。中間の配信サーバーはありません=クラウドにトレースはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔드-투-엔드 암호화 된 메시지는 중간 분배 서버없이 클라우드에서 추적없이 피어 투 피어로 장치 간 직접 교환됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende-til-ende krypterte meldinger utveksles i peer-to-peer, direkte fra enhet til enhet, uten en mellomliggende distribusjonsserver = ingen spor i skyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End-to-end versleutelde berichten worden peer-to-peer uitgewisseld, rechtstreeks van apparaat naar apparaat, zonder tussenliggende distributieserver = geen sporen in de cloud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaszyfrowane wiadomości od końca do końca są wymieniane w sieci peer-to-peer, bezpośrednio z urządzenia na urządzenie, bez pośredniego serwera dystrybucji = brak śladów w chmurze."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens criptografadas de ponta a ponta são trocadas peer-to-peer, diretamente de dispositivo para dispositivo, sem um servidor de distribuição intermediário = nenhum rastreio na nuvem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajele criptate end-to-end sunt schimbate direct între dispozitive, peer-to-peer, fără un server intermediar = fără urme în cloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сквозные зашифрованные сообщения обмениваются в одноранговой сети напрямую с устройства на устройство без промежуточного сервера распространения = никаких трассировок в облаке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správy šifrované end-to-end sa vymieňajú peer-to-peer, priamo medzi zariadeniami, bez distribučného servera = žiadne stopy v cloude."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporočila, šifrirana od konca do konca, se izmenjujejo neposredno med napravami (peer-to-peer), brez vmesnega distribucijskega strežnika = brez sledi v oblaku."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesazhet e enkriptuara nga skaji në skaj shkëmbehen peer-to-peer, drejtpërdrejt nga pajisja në pajisje, pa server shpërndarës të ndërmjetëm = pa gjurmë në cloud."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End-to-end šifrovane poruke se razmenjuju peer-to-peer, direktno sa uređaja na uređaj, bez posrednog distributivnog servera = bez tragova u oblaku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End-to-end-krypterade meddelanden utbyts i peer-to-peer, direkt från enhet till enhet, utan en mellanliggande distributionsserver = inga spår i molnet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçtan uca şifrelenmiş iletiler, ara dağıtım sunucusu olmadan doğrudan aygıttan aygıta eşler arası olarak değiştirilir = bulutta iz yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кінцеві закодовані повідомлення передаються в одноранговому режимі не через сервер поширення, а безпосередньо з одного пристрою на інший, не зберігаючись у хмарі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn được mã hóa đầu-cuối được trao đổi trực tiếp từ thiết bị này đến thiết bị kia, không qua máy chủ trung gian = không để lại dấu vết trên đám mây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端到端加密的消息直接在终端之间进行点对点交换，而无需中间分发服务器=云中没有任何痕迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端到端加密的消息直接在終端之間進行點對點交換，而無需中間分發服務器=雲中沒有任何痕跡。"
          }
        }
      }
    },
