    "template_click_to_call_view_template_classified_ad_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدرج رابطًا في إعلان مبوب يسمح للمشترين المحتملين بالاتصال بك دون تثبيت التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете линк в обява, който позволява на потенциални купувачи да ви се обадят без да инсталират приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vložte odkaz do inzerátu, aby vám potenciální kupci mohli zavolat bez instalace aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsæt et link i en rubrikannonce, der giver potentielle købere mulighed for at ringe til dig uden at installere appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie einen Link in eine Kleinanzeige ein, über den potenzielle Käufer Sie anrufen können, ohne die App zu installieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε έναν σύνδεσμο στην αγγελία που επιτρέπει σε πιθανούς αγοραστές να σας καλέσουν χωρίς να εγκαταστήσουν την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insert a link in a classified ad allowing potential buyers to call you without installing the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un enlace en un anuncio clasificado para que los compradores potenciales te llamen sin instalar la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لینکی را در یک آگهی طبقه‌بندی‌شده قرار دهید که به خریداران بالقوه اجازه می‌دهد بدون نصب برنامه با شما تماس بگیرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ilmoitukseen linkki, jonka avulla potentiaaliset ostajat voivat soittaa sinulle ilman sovelluksen asentamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insérer un lien dans une petite annonce permettant aux acheteurs potentiels de vous appeler, sans installer l'application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף קישור במודעה מסווגת המאפשר לקונים פוטנציאליים להתקשר אליך מבלי להתקין את האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लासिफ़ाइड ऐड में एक लिंक डालें जिससे संभावित खरीदार ऐप इंस्टॉल किए बिना आपको कॉल कर सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umetnite poveznicu u mali oglas koja potencijalnim kupcima omogućuje da vas nazovu bez instaliranja aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illesszen be egy linket az apróhirdetésbe, amely lehetővé teszi az érdeklődőknek, hogy az alkalmazás telepítése nélkül felhívják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisipkan tautan di iklan baris yang memungkinkan calon pembeli untuk menghubungi Anda tanpa menginstal aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un link in un annuncio che consenta ai potenziali acquirenti di chiamarti senza installare l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラシファイド広告にリンクを挿入すると、見込み客はアプリをインストールしなくても電話をかけることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고에 링크를 삽입하여 잠재 구매자가 앱을 설치하지 않고도 전화할 수 있도록 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett inn en lenke i en rubrikkannonse som lar potensielle kjøpere ringe deg uten å installere appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een link toe aan een advertentie zodat potentiële kopers u kunnen bellen zonder de app te installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieść link w ogłoszeniu, umożliwiając potencjalnym klientom kontakt telefoniczny bez instalowania aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira um link num anúncio classificado permitindo que potenciais compradores lhe liguem sem instalar a aplicação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți un link într-un anunț care permite potențialilor cumpărători să vă apeleze fără să instaleze aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте ссылку в объявление, позволяющую потенциальным покупателям позвонить вам без установки приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vložte odkaz do inzerátu, ktorý umožní potenciálnym kupujúcim zavolať vám bez inštalácie aplikácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V mali oglas vstavite povezavo, ki potencialnim kupcem omogoča, da vas pokličejo brez namestitve aplikacije."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendosni një lidhje në një shpallje që u lejon blerësve potencialë t’ju telefonojnë pa instaluar aplikacionin."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umetnite link u mali oglas koji potencijalnim kupcima omogućava da vas pozovu bez instaliranja aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Infoga en länk i en annons som gör det möjligt för potentiella köpare att ringa dig utan att installera appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potansiyel alıcıların uygulamayı yüklemeden sizi aramasına olanak tanıyan bir bağlantıyı ilana ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставте посилання в оголошення, що дозволяє потенційним покупцям зателефонувати вам без встановлення програми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chèn liên kết vào quảng cáo rao vặt cho phép người mua tiềm năng gọi cho bạn mà không cần cài đặt ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分类广告中插入链接，让潜在买家无需安装应用程式即可联系您。"
