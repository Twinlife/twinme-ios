    "show_group_view_remove_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف هذه المجموعة لجميع أعضائها وسيتم مسح محادثاتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Групата ще бъде изтрита за всички нейни членове и разговорите ще бъдат премахнати."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato skupina bude odstraněna pro všechny její členy a její konverzace budou vymazány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne gruppe vil blive slettet for alle dens medlemmer, og dens samtaler vil blive slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe wird für alle Mitglieder gelöscht und die zugehörigen Unterhaltungen werden entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ομάδα θα διαγραφεί για όλα τα μέλη της και οι συνομιλίες της θα σβηστούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group will be deleted for all its members and its conversations will be erased."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo se eliminará para todos sus miembros y se borrarán sus conversaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این گروه برای همه اعضایش حذف می شود و مکالمات آن پاک می شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä ryhmä poistetaan kaikilta sen jäseniltä ja sen keskustelut poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce groupe sera supprimé pour tous ses membres et ses conversations seront effacées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקבוצה הזו תימחק עבור כל חבריה והשיחות שלה יימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह समूह अपने सभी सदस्यों के लिए हटा दिया जाएगा और इसकी बातचीत मिटा दी जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova će grupa biti izbrisana za sve članove, a njezini razgovori bit će izbrisani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A csoport minden tag számára törlődik, és a beszélgetései törlődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grup ini akan dihapus untuk semua anggotanya dan percakapannya akan terhapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gruppo verrà eliminato per tutti i suoi membri e le sue conversazioni verranno cancellate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループはメンバー全員に対して削除され、会話は消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹은 모든 멤버에 대해 삭제되고 대화는 지워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne gruppen vil bli slettet for alle medlemmene, og samtalene vil bli slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze groep wordt voor alle leden verwijderd en de gesprekken worden gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta grupa zostanie usunięta dla wszystkich jej członków, a jej konwersacje zostaną wymazane."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo será eliminado para todos os seus membros e as suas conversas serão apagadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest grup va fi șters pentru toți membrii săi, iar conversațiile vor fi eliminate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта группа будет удалена для всех ее участников, а ее разговоры будут стерты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto skupina bude odstránená pre všetkých jej členov a jej konverzácie budú vymazané."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta skupina bo izbrisana za vse člane, njeni pogovori pa bodo izbrisani."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ky grup do të fshihet për të gjithë anëtarët e tij dhe bisedat e tij do të fshihen."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova grupa će biti obrisana za sve svoje članove i njeni razgovori će biti izbrisani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här gruppen kommer att raderas för alla dess medlemmar och dess konversationer kommer att raderas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu grup tüm üyelerinden silinecek ve konuşmaları silinecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю групу буде видалено для всіх її учасників, а її розмови – видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc muốn xóa nhóm này không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此群组的所有成员将被删除，其对话也将被清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此群組的所有成員將被刪除，其對話也將被清除。"
