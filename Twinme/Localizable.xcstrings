    "application_migration_no_storage_space" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مساحة كافية على جهازك لإكمال عملية الترحيل. أغلق التطبيق، وقم بتحرير بعض المساحة، ثم أعد تشغيل التطبيق لإكمال التحديث."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Няма достатъчно място на устройството, за да завършите миграцията. Затворете приложението, освободете пространство и го стартирайте отново, за да приключите обновяването."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vašem zařízení není dostatek místa pro dokončení migrace. Zavřete aplikaci, uvolněte místo a poté ji znovu spusťte pro dokončení aktualizace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke nok plads på din enhed til at fuldføre migreringen. Luk applikationen, frigør noget plads, og genstart appen for at fuldføre opdateringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist nicht genügend Speicherplatz auf Ihrem Gerät vorhanden, um die Migration abzuschließen. Schließen Sie die Anwendung, geben Sie Speicherplatz frei und starten Sie die App erneut, um das Update abzuschließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει αρκετός χώρος στη συσκευή για να ολοκληρωθεί η μεταφορά. Κλείστε την εφαρμογή, ελευθερώστε χώρο και επανεκκινήστε την για να ολοκληρωθεί η ενημέρωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is not enough space on your device to complete the migration. Close the application, free up some space, and relaunch the app to complete the update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente espacio en su dispositivo para completar la migración. Cierre la aplicación, libere algo de espacio y reiníciela para completar la actualización."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فضای کافی برای تکمیل انتقال در دستگاه شما وجود ندارد. برنامه را ببندید، مقداری فضا آزاد کنید و برای تکمیل به"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteessa ei ole tarpeeksi tilaa siirron suorittamiseen. Sulje sovellus, vapauta tilaa ja käynnistä sovellus uudelleen päivityksen viimeistelemiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas assez d'espace sur votre appareil pour terminer la migration. Fermez l'application, libérez de l'espace et relancez l'application pour terminer la mise à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין מספיק מקום במכשיר שלך כדי להשלים את ההעברה. סגור את האפליקציה, פנה מקום והפעל מחדש את האפליקציה כדי להשלים את העדכון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइग्रेशन पूरा करने के लिए आपके डिवाइस पर पर्याप्त जगह नहीं है। एप्लिकेशन को बंद करें, कुछ स्थान खाली करें और अपडेट पूरा करने के लिए ऐप को फिर से लॉन्च करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema dovoljno prostora na uređaju za dovršetak migracije. Zatvorite aplikaciju, oslobodite nešto prostora i ponovno pokrenite aplikaciju kako biste dovršili ažuriranje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs elegendő hely az eszközön a migráció befejezéséhez. Zárd be az alkalmazást, szabadíts fel helyet, majd indítsd újra az alkalmazást a frissítés befejezéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang di perangkat Anda tidak cukup untuk menyelesaikan migrasi. Tutup aplikasi, kosongkan sebagian ruang, dan luncurkan kembali aplikasi untuk menyelesaikan pembaruan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è abbastanza spazio sul tuo dispositivo per completare la migrazione. Chiudi l'applicazione, libera spazio e riavvia l'app per completare l'aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移行を完了するのに十分なスペースがデバイスにありません。 アプリケーションを閉じて空き容量を増やし、アプリを再起動してアップデートを完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에 마이그레이션을 완료할 공간이 부족합니다. 애플리케이션을 닫고 공간을 확보한 후 앱을 다시 실행하여 업데이트를 완료하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke nok plass på enheten til å fullføre migreringen. Lukk applikasjonen, frigjør plass og start appen på nytt for å fullføre oppdateringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is onvoldoende ruimte op uw apparaat om de migratie te voltooien. Sluit de applicatie, maak wat ruimte vrij en start de app opnieuw om de update te voltooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Twoim urządzeniu nie ma wystarczającej ilości miejsca, aby ukończyć migrację. Zamknij aplikację, zwolnij trochę miejsca i uruchom ją ponownie, aby dokończyć aktualizację."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há espaço suficiente no seu dispositivo para concluir a migração. Feche o aplicativo, libere espaço e reinicie-o para concluir a atualização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu există suficient spațiu pe dispozitivul dvs. pentru a finaliza migrarea. Închideți aplicația, eliberați spațiu și relansați aplicația pentru a finaliza actualizarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем устройстве недостаточно места для завершения миграции. Закройте приложение, освободите место и перезапустите приложение, чтобы завершить обновление."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na dokončenie migrácie nemáte v zariadení dostatok miesta. Zatvorte aplikáciu, uvoľnite miesto a znova ju spustite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na vaši napravi ni dovolj prostora za dokončanje migracije. Zaprite aplikacijo, sprostite nekaj prostora in jo znova zaženite, da dokončate posodobitev."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk ka hapësirë të mjaftueshme në pajisjen tuaj për të përfunduar migrimin. Mbyllni aplikacionin, lironi pak hapësirë dhe rihapeni për të përfunduar përditësimin."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema dovoljno prostora na uređaju da se migracija završi. Zatvorite aplikaciju, oslobodite prostor i ponovo pokrenite aplikaciju da biste završili ažuriranje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inte tillräckligt med utrymme på din enhet för att slutföra migreringen. Stäng applikationen, frigör lite utrymme och starta om appen för att slutföra uppdateringen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazınızda taşıma işlemini tamamlamak için yeterli alan yok. Uygulamayı kapatın, biraz yer açın ve güncellemeyi tamamlamak için uygulamayı yeniden başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашому пристрої недостатньо місця для завершення міграції. Закрийте програму, звільніть місце та перезапустіть програму, щоб завершити оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị của bạn không đủ dung lượng để hoàn tất việc di chuyển. Hãy đóng ứng dụng, giải phóng một phần bộ nhớ, và khởi động lại ứng dụng để hoàn tất cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的设备上没有足够的空间来完成迁移。 关闭应用程序，释放一些空间，然后重新启动应用程序以完成更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的裝置上沒有足夠的空間來完成遷移。 關閉應用程序，釋放一些空間，然後重新啟動應用程式以完成更新。"
          }
        }
      }
    },
    "application_migration_no_storage_space_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحد الجهازين لا يحتوي على مساحة تخزين كافية. أفرغ مساحة على هذا الجهاز قبل إعادة تشغيل عملية الترحيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Едно от двете устройства няма достатъчно място за съхранение. Освободете място и стартирайте миграцията отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno ze dvou zařízení nemá dostatek úložiště. Uvolněte místo na daném zařízení před restartem migrace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En af de to enheder har ikke nok lagerplads. Frigør plads på den enhed, før du genstarter migreringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eines der beiden Geräte hat nicht genügend Speicherplatz. Geben Sie Speicherplatz auf diesem Gerät frei, bevor Sie die Migration neu starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία από τις δύο συσκευές δεν έχει αρκετό χώρο αποθήκευσης. Ελευθερώστε χώρο πριν επανεκκινήσετε τη μεταφορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of the two devices does not have enough storage space. Free up space on that device before restarting the migration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de los dos dispositivos no tiene suficiente espacio de almacenamiento. Libera espacio en ese dispositivo antes de reiniciar la migración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یکی از دو دستگاه فضای ذخیره"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toisella laitteista ei ole tarpeeksi tallennustilaa. Vapauta tilaa kyseisellä laitteella ennen siirron uudelleenkäynnistystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'un des deux appareils ne dispose pas de suffisamment d'espace de stockage. Libérez de l'espace sur cet appareil avant de relancer la migration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחד משני המכשירים אין מספיק מקום אחסון. פנה מקום במכשיר זה לפני שתתחיל מחדש את ההעברה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों में से एक डिवाइस में पर्याप्त संग्रहण स्थान नहीं है। माइग्रेशन को पुनः आरंभ करने से पहले उस डिवाइस पर स्थान खाली करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedan od dva uređaja nema dovoljno prostora za pohranu. Oslobodite prostor na tom uređaju prije ponovnog pokretanja migracije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A két eszköz egyike nem rendelkezik elegendő tárhellyel. Szabadíts fel helyet azon az eszközön, mielőtt újraindítod a migrációt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu dari dua perangkat tidak memiliki cukup ruang penyimpanan. Kosongkan ruang di perangkat tersebut sebelum memulai ulang migrasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno dei due dispositivi non dispone di spazio di archiviazione sufficiente. Libera spazio su quel dispositivo prima di riavviare la migrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2台のデバイスのうち1台に十分なストレージ容量がありません。移行を再開する前に、そのデバイスの空き容量を増やしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 기기 중 하나에 저장 공간이 부족합니다. 마이그레이션을 다시 시작하기 전에 해당 기기의 저장 공간을 확보하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En av de to enhetene har ikke nok lagringsplass. Frigjør plass på den enheten før du starter overføringen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een van de twee apparaten heeft onvoldoende opslagruimte. Maak ruimte vrij op dat apparaat voordat je de migratie opnieuw start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno z dwóch urządzeń nie ma wystarczającej ilości miejsca. Zwolnij miejsce na tym urządzeniu przed ponownym uruchomieniem migracji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dos dois dispositivos não tem espaço de armazenamento suficiente. Liberte espaço nesse dispositivo antes de reiniciar a migração."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unul dintre cele două dispozitive nu are suficient spațiu de stocare. Eliberați spațiu pe acel dispozitiv înainte de a relua migrarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На одном из двух устройств недостаточно места на диске. Освободите место на этом устройстве перед повторным запуском миграции."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno z dvoch zariadení nemá dostatok úložného priestoru. Uvoľnite miesto a reštartujte migráciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ena od obeh naprav nima dovolj prostora za shranjevanje. Pred ponovnim zagonom migracije sprostite prostor na tej napravi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Njëra nga dy pajisjet nuk ka hapësirë të mjaftueshme ruajtjeje. Lironi hapësirë në atë pajisje përpara se të rifilloni migrimin."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedan od dva uređaja nema dovoljno prostora za skladištenje. Oslobodite prostor na tom uređaju pre nego što ponovo pokrenete migraciju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En av de två enheterna har inte tillräckligt med lagringsutrymme. Frigör utrymme på den enheten innan du startar om migreringen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki cihazdan birinde yeterli depolama alanı yok. Göçü yeniden başlatmadan önce o cihazda yer açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На одному з двох пристроїв недостатньо місця для зберігання. Звільніть місце на цьому пристрої, перш ніж перезапускати міграцію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một trong hai thiết bị không có đủ dung lượng lưu trữ. Giải phóng dung lượng trên thiết bị đó trước khi khởi động lại quá trình di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两台设备中，有一台的存储空间不足。请释放该设备的空间，然后再重新开始迁移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩台設備中，有一台的儲存空間不足。請釋放該裝置的空間，然後再重新開始遷移。"
          }
        }
      }
    },
