    "profile_view_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لك ملف التعريف هذا دعوة جهات الاتصال الخاصة بك لإقامة علاقة خاصة معك ، تحت سيطرتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този профил ви позволява да каните контакти да установят лична връзка с вас под ваш контрол."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento profil vám umožňuje zvát kontakty k navázání soukromého vztahu s vámi, pod vaší kontrolou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne profil giver dig mulighed for at invitere dine kontakter til at etablere et privat forhold til dig, under din kontrol."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil ermöglicht es Ihnen, Ihre Kontaktpersonen einzuladen, eine private Verbindung mit Ihnen aufzubauen – unter Ihrer vollen Kontrolle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το προφίλ σας επιτρέπει να προσκαλείτε επαφές ώστε να δημιουργήσουν ιδιωτική σχέση μαζί σας, υπό τον έλεγχό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This profile allows you to invite your contacts to establish a private relationship with you, under your control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil te permite invitar a tus contactos a establecer una relación privada contigo, bajo tu control."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این نمایه به شما این امکان را می دهد که از مخاطبین خود دعوت کنید تا تحت کنترل شما با شما رابطه خصوصی برقرار کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän profiilin avulla voit kutsua yhteyshenkilösi luomaan kanssasi yksityisen suhteen hallinnassasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil vous permet d’inviter vos contacts à établir avec vous une relation privée, sous votre contrôle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרופיל זה מאפשר לך להזמין את אנשי הקשר שלך ליצור איתך קשר פרטי, בשליטתך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रोफ़ाइल आपको अपने आपके साथ एक निजी संबंध स्थापित करने के लिए अपने संपर्कों को आमंत्रित करने की अनुमति देती है, नियंत्रण में।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj vam profil omogućuje da pozovete kontakte kako biste s vama uspostavili privatni odnos, pod vašom kontrolom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a profil lehetővé teszi, hogy privát kapcsolatot hozz létre és tarts fenn a kapcsolataiddal, teljes irányítás mellett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil ini memungkinkan Anda mengundang kontak Anda untuk menjalin hubungan pribadi dengan Anda, di bawah kendali Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo profilo ti permette di invitare i tuoi contatti a stabilire con te un rapporto privato, sotto il tuo controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルを使用すると、連絡先を招待して、管理下であなたとのプライベートな関係を確立できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필을 사용하면 연락처를 초대하여 제어할 수 있는 비공개 관계를 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne profilen lar deg invitere kontaktene dine til å etablere et privat forhold med deg, under din kontroll."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met dit profiel kunt u uw contacten uitnodigen om een privérelatie met u aan te gaan, onder uw controle."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten profil umożliwia zapraszanie kontaktów do nawiązania z Tobą prywatnej relacji, pod Twoją kontrolą."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil permite-lhe convidar os seus contactos para estabelecer uma relação privada consigo, sob o seu controlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest profil vă permite să invitați contacte pentru a stabili o relație privată, sub controlul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль позволяет вам пригласить свои контакты для установления личных отношений с вами под вашим контролем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento profil vám umožňuje pozývať kontakty na vytvorenie súkromného vzťahu pod vašou kontrolou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta profil vam omogoča, da povabite svoje stike k vzpostavitvi zasebnega odnosa z vami, pod vašim nadzorom."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ky profil ju lejon të ftoni kontaktet tuaja për të krijuar një marrëdhënie private me ju, nën kontrollin tuaj."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj profil vam omogućava da pozovete svoje kontakte da uspostave privatni odnos sa vama, pod vašom kontrolom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här profilen låter dig bjuda in dina kontakter att etablera en privat relation med dig, under din kontroll."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profil, kişilerinizi kontrolünüz altında sizinle özel bir ilişki kurmaya davet etmenize olanak tanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей профіль дозволяє запрошувати своїх контактів для встановлення приватних стосунків з вами під вашим контролем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ này cho phép bạn mời liên hệ thiết lập mối quan hệ riêng tư với bạn, dưới quyền kiểm soát của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置文件允许您邀请您的联系人在您的控制下与您建立私人关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置文件允許您邀請您的聯繫人在您的控制下與您建立私人關係。"
          }
        }
      }
    },
