    "edit_space_view_contacts_no_profile" : {
      "comment" : "EditSpaceViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدعوة جهة اتصال ، يجب عليك إكمال ملف التعريف الذي يمثلك لجهة الاتصال هذه. هل تريد إكماله؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можете да премахнете активния профил"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivní profil nelze odstranit"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at invitere en kontaktperson skal du udfylde den profil, der repræsenterer dig for denne kontaktperson. Vil du fuldføre det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen Kontakt einzuladen, müssen Sie das Profil ausfüllen, das Sie für diesen Kontakt darstellt. Möchten Sie es vervollständigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορείτε να αφαιρέσετε το ενεργό προφίλ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To invite a contact, you must complete the profile that represents you to this contact. Do you want to complete it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para invitar a un contacto, debe completar el perfil que lo representa a este contacto. ¿Quieres completarlo?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای دعوت از یک مخاطب ، باید نمایه ای را ارائه دهید که نمایانگر این مخاطب است. آیا می خواهید آن را تکمیل کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat kutsua yhteyshenkilön, sinun on täytettävä profiili, joka edustaa sinua tähän yhteystietoon. Haluatko suorittaa sen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour inviter un contact, vous devez compléter le profil qui vous représente auprès de ce contact. Voulez-vous le compléter ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להזמין איש קשר, עליך להשלים את הפרופיל שמייצג אותך מול איש קשר זה. האם ברצונך להשלים זאת?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी संपर्क को आमंत्रित करने के लिए, आपको उस प्रोफ़ाइल को पूरा करना होगा जो इस संपर्क से आपका प्रतिनिधित्व करती है। क्या आप इसे पूरा करना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne možete ukloniti aktivni profil"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az aktív profilt nem lehet eltávolítani"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengundang kontak, Anda harus melengkapi profil yang mewakili Anda dengan kontak ini. Apakah Anda ingin melengkapinya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per invitare un contatto, è necessario completare il profilo che rappresenta questo contatto. Vuoi completarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
