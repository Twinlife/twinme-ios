        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können anschließend für jede Verbindung unabhängig voneinander festlegen, wie Sie den einzelnen Kontaktpersonen gegenüber auftreten möchten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε στη συνέχεια να προσαρμόσετε πώς εμφανίζεστε σε κάθε επαφή, ξεχωριστά για κάθε σχέση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can then modify how you wish to be known to each of your contacts, on each relationship, independently."
