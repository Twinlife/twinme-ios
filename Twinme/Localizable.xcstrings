    "twincode_view_message" : {
      "comment" : "TwincodeViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من جهة الاتصال القريبة منك مسح رمز QR لدعوتك ضوئيًا باستخدام Skred، أو اضغط على رمز الدعوة لنسخه إلى الحافظة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помолете приятел близо до вас да сканира вашия QR-код за покана с Skred или докоснете кода, за да го копирате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte přítele poblíž, aby naskenoval váš pozvánkový QR kód Skred, nebo klepněte na pozvánkový kód pro jeho zkopírování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed din kontaktperson nær dig om at scanne din invitations QR-kode med Skred, eller tryk på din invitationskode for at kopiere den til udklipsholderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitten Sie Ihren Freund in der Nähe, Ihren Einladungs-QR-Code mit Skred zu scannen, oder tippen Sie auf den Einladungs-Code, um ihn in die Zwischenablage zu kopieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον φίλο σας κοντά σας να σαρώσει τον QR‑κώδικα πρόσκλησής σας με το Skred ή πατήστε τον κωδικό για αντιγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask your contact near you to scan your invitation QR-code with Skred, or tap the invitation code to copy it to the clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídale a su contacto cerca de usted que escanee su código QR de invitación con Skred, o toque su código de invitación para copiarlo en el portapapeles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از مخاطب نزدیک خود بخواهید که کد QR دعوت شما را با Skred اسکن کند یا روی کد دعوت ضربه بزنید تا آن را در کلیپ بورد کپی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä lähellä olevaa kontaktia skannaamaan kutsusi QR-koodi Skredillä tai napauttamalla kutsukoodia kopioidaksesi se leikepöydälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à votre contact près de vous de scanner le QR-code de votre invitation avec Skred, ou appuyez sur le code d’invitation pour le copier dans le presse-papiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקש מאיש הקשר שלך הקרוב אליך לסרוק את קוד ה-QR של ההזמנה שלך עם Skred, או הקש על קוד ההזמנה כדי להעתיק אותו ללוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने नजदीकी संपर्क से अपने निमंत्रण क्यूआर-कोड को स्क्रेड के साथ स्कैन करने के लिए कहें, या इसे क्लिपबोर्ड पर कॉपी करने के लिए निमंत्रण कोड को टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite prijatelja u svojoj blizini da skenira vaš pozivni QR-kôd pomoću Skred ili dodirnite pozivni kôd kako biste ga kopirali u međuspremnik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérje meg a közelben lévő barátját, hogy olvassa be a meghívó QR-kódját Skred-vel, vagy koppintson a meghívókódra a vágólapra másoláshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta kontak di dekat Anda untuk memindai kode QR undangan dengan Skred, atau ketuk kode undangan untuk menyalinnya ke papan klip."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi al tuo contatto vicino a te di scansionare il tuo codice QR di invito con Skred, o tocca il tuo codice di invito per copiarlo negli appunti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの連絡先に Skred で招待 QR コードをスキャンするよう依頼するか、招待コードをタップしてクリップボードにコピーしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까운 사람에게 Skred로 초대 QR 코드를 스캔하도록 요청하거나 초대 코드를 탭하여 클립보드에 복사하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be kontakten din nær deg om å skanne QR-koden for invitasjonen din med Skred, eller trykk på invitasjonskoden for å kopiere den til utklippstavlen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag je contactpersoon bij jou in de buurt om de QR-code van je uitnodiging te scannen met Skred, of tik op je uitnodigingscode om deze naar het klembord te kopiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś kontakt w pobliżu, aby zeskanował kod QR zaproszenia za pomocą Skred lub dotknij kodu zaproszenia, aby skopiować go do schowka."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao seu contato perto de você para ler o código QR do convite com o Skred ou toque no código do convite para copiá-lo para a área de transferência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugați prietenul de lângă dvs. să scaneze codul dvs. QR de invitație cu Skred sau apăsați pe cod pentru a-l copia în clipboard."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите друга, который находится рядом с вами, отсканировать QR-код вашего приглашения с помощью Skred или нажмите свой код приглашения, чтобы скопировать его в буфер обмена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte priateľa v blízkosti, aby naskenoval váš QR‑kód pozvánky pomocou Skred, alebo ťuknite na pozývací kód na jeho kopírovanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosite prijatelja v svoji bližini, naj s Skred skenira vašo QR-kodo povabila, ali tapnite kodo povabila, da jo kopirate v odložišče."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkojini mikut tuaj pranë jush të skanojë QR-kodin e ftesës suaj me skred, ose prekni kodin e ftesës për ta kopjuar në kujtesën e përkohshme."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite prijatelja u vašoj blizini da skenira vaš pozivni QR-kod pomoću Skred, ili dodirnite pozivni kod da biste ga kopirali u međuspremnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be din kontakt nära dig att skanna din QR-kod för inbjudan med Skred, eller tryck på din inbjudningskod för att kopiera den till urklippet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınınızdaki kişiden davetiye QR kodunu Skred ile taramasını isteyin veya davet koduna dokunarak panoya kopyalayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть свого контакта поруч із вами відсканувати QR-код вашого запрошення за допомогою Skred або торкніться коду запрошення, щоб скопіювати його в буфер обміну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu bạn bè gần bạn quét mã QR mời của bạn bằng Skred, hoặc chạm vào mã mời để sao chép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请您附近的联系人使用 Skred 扫描您的邀请二维码，或点击邀请码将其复制到剪贴板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請您附近的聯絡人使用 Skred 掃描您的邀請二維碼，或點擊邀請碼將其複製到剪貼簿。"
          }
        }
      }
    },
