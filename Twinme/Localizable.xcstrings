    "transfert_call_view_delete_confirm_message" : {
      "comment" : "TransfertCallViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من أنك تريد حذف رمز \"تحويل المكالمات\" هذا؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този линк за прехвърляне на разговор ще бъде изтрит. Потвърждавате ли?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento odkaz pro přenos hovoru bude smazán. Potvrdit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil slette denne \"Opkaldsoverførsel\"-kode?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie diesen Code für die „Anrufübertragung“ löschen möchten?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο σύνδεσμος μεταφοράς κλήσης θα διαγραφεί. Επιβεβαίωση;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this \"Call Transfer\" code?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está seguro de que desea eliminar este código de \"Transferencia de llamadas\"?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئن هستید که می خواهید این کد \"انتقال تماس\" را حذف کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko varmasti poistaa tämän \"Soitonsiirto\" -koodin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir supprimer ce code \"Transfert d'Appel\" ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אתה בטוח שברצונך למחוק את קוד \"העברת שיחות\" זה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई इस \"कॉल ट्रांसफ़र\" कोड को हटाना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova poveznica za prijenos poziva bit će izbrisana. Potvrditi?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a hívásátviteli link törlődni fog. Megerősíti?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda yakin ingin menghapus kode \"Transfer Panggilan\" ini?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler eliminare questo codice \"Trasferimento chiamata\"?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この「通話転送」コードを削除してもよろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 \"통화 전송\" 코드를 삭제하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette denne \"Call Transfer\"-koden?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet u zeker dat u deze \"Call Transfer\"-code wilt verwijderen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz usunąć ten kod „Przekierowanie połączeń”?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem a certeza que pretende eliminar este código de \"Transferência de chamadas\"?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest link de transfer apel va fi șters. Confirmați?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите удалить этот код «Перевод вызова»?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento odkaz na prenos hovoru bude odstránený. Potvrdiť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezava za prenos klica bo izbrisana. Potrdite?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jeni i sigurt që dëshironi ta fshini këtë kod \\\"Transferimi i thirrjes\\\"?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj link za prenos poziva biće obrisan. Potvrditi?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill ta bort den här \"Samtalsöverföring\"-koden?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu \"Çağrı Aktarımı\" kodunu silmek istediğinizden emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені, що хочете видалити цей код \"Переадресація виклику\"?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc muốn xóa mã \"Chuyển cuộc gọi\" này không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要删除此「呼叫转移」代码吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要刪除此「呼叫轉移」代碼嗎？"
          }
        }
      }
    },
