    "proxy_view_information" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم البروكسي فقط إذا لم تتمكن من الاتصال بالخدمة من شبكات Wi-Fi أو شبكات الهاتف المحمول القياسية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте прокси само ако не можете да се свържете към услугата чрез стандартни Wi‑Fi или мобилни мрежи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte proxy pouze v případě, že se nemůžete ke službě připojit přes běžnou Wi‑Fi nebo mobilní síť."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug kun en proxy, hvis du ikke kan oprette forbindelse til tjenesten fra standard Wi-Fi- eller mobilnetværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie einen Proxy nur dann, wenn Sie über herkömmliche WLAN- oder Mobilfunknetze keine Verbindung zum Dienst herstellen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε proxy μόνο αν δεν μπορείτε να συνδεθείτε στην υπηρεσία μέσω κανονικού Wi‑Fi ή δικτύου κινητής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a proxy only if you can't connect to the service from standard Wi-Fi or cellular networks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un proxy solo si no puedes conectarte al servicio desde redes Wi-Fi o móviles estándar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط در صورتی از پروکسی استفاده کنید که نمی"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä välityspalvelinta vain, jos et voi muodostaa yhteyttä palveluun tavallisista Wi-Fi- tai matkapuhelinverkoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un proxy uniquement si vous ne pouvez pas vous connecter au service depuis un réseau Wi-Fi ou cellulaire standard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש בפרוקסי רק אם אינך מצליח להתחבר לשירות מרשתות Wi-Fi או סלולריות רגילות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रॉक्सी का उपयोग केवल तभी करें जब आप मानक वाई-फ़ाई या सेलुलर नेटवर्क से सेवा से कनेक्ट न हो पा रहे हों।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite proxy samo ako se ne možete povezati s uslugom putem standardnih Wi-Fi ili mobilnih mreža."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak akkor használj proxy-t, ha az alkalmazás nem tud csatlakozni normál Wi-Fi vagy mobilhálózaton."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan proksi hanya jika Anda tidak dapat terhubung ke layanan dari Wi-Fi standar atau jaringan seluler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza un proxy solo se non riesci a connetterti al servizio tramite Wi-Fi standard o reti cellulari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準のWi-Fiまたはモバイルネットワークからサービスに接続できない場合にのみ、プロキシを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표준 Wi-Fi 또는 셀룰러 네트워크에서 서비스에 연결할 수 없는 경우에만 프록시를 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk bare en proxy hvis du ikke kan koble til tjenesten fra standard Wi-Fi- eller mobilnettverk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een proxy alleen als je geen verbinding kunt maken met de service via standaard wifi of mobiele netwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj serwera proxy tylko wtedy, gdy nie możesz połączyć się z usługą za pośrednictwem standardowej sieci Wi-Fi lub sieci komórkowych."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize um proxy apenas se não conseguir ligar-se ao serviço a partir de redes Wi-Fi ou telemóveis padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți un proxy doar dacă nu vă puteți conecta la serviciu prin rețele Wi-Fi sau mobile obișnuite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте прокси только если вы не можете подключиться к сервису через стандартные сети Wi-Fi или сотовую связь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použite proxy len vtedy, ak sa z bežnej Wi‑Fi alebo mobilnej siete nedokážete pripojiť k službe."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy uporabite samo, če se s storitvijo ne morete povezati prek običajnih omrežij Wi-Fi ali mobilnih omrežij."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përdorni një proxy vetëm nëse nuk mund të lidheni me shërbimin nga rrjetet standarde Wi-Fi ose celulare."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite proxy samo ako ne možete da se povežete sa uslugom preko standardnih Wi-Fi ili mobilnih mreža."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd endast en proxy om du inte kan ansluta till tjänsten från vanliga Wi-Fi- eller mobilnätverk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca standart Wi-Fi veya hücresel ağlardan hizmete bağlanamıyorsanız proxy kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте проксі, лише якщо ви не можете підключитися до служби через стандартні мережі Wi-Fi або стільникові мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ sử dụng proxy nếu bạn không thể kết nối với dịch vụ từ mạng Wi-Fi hoặc mạng di động tiêu chuẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当您无法通过标准 Wi-Fi 或蜂窝网络连接到服务时才使用代理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅當您無法透過標準 Wi-Fi 或蜂窩網路連接到服務時才使用代理程式。"
          }
        }
      }
    },
