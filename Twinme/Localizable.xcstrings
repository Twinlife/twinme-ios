    "quality_of_service_view_step1_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تبادل الرسائل المشفرة مباشرة بين الأجهزة في الوقت الفعلي ، باستخدام نهج \"نظير إلى نظير \" ، بدون خوادم توزيع المحتوى. هذا يضمن عدم وجود أي أثر في السحابة ويوفر حماية خصوصية فريدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Криптираните съобщения се обменят директно между устройствата в реално време чрез peer‑to‑peer подход, без сървъри за разпространение на съдържанието. Това гарантира липса на следи в облака и уникална поверителност."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrované zprávy jsou vyměňovány přímo mezi zařízeními v reálném čase pomocí „peer‑to‑peer“ přístupu, bez serverů pro distribuci obsahu. To zajišťuje žádné stopy v cloudu a jedinečnou ochranu soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypterede beskeder udveksles direkte mellem enheder i realtid ved hjælp af en \"peer-to-peer\"-tilgang uden indholdsdistributionsservere. Dette sikrer, at der ikke er spor i skyen og giver en unik beskyttelse af privatlivets fred."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselte Nachrichten werden in Echtzeit direkt zwischen den Geräten nach dem „Peer-to-Peer“-Prinzip ausgetauscht, ohne Server zur Inhaltsverteilung. Dies stellt sicher, dass keine Spuren in der Cloud hinterlassen werden, und bietet einen einzigartigen Schutz Ihrer Privatsphäre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κρυπτογραφημένα μηνύματα ανταλλάσσονται απευθείας μεταξύ συσκευών σε πραγματικό χρόνο μέσω peer‑to‑peer, χωρίς διακομιστές διανομής περιεχομένου. Έτσι δεν αφήνουν ίχνη στο cloud και προσφέρουν μοναδική προστασία ιδιωτικότητας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted messages are exchanged directly between devices in real time, using a \"peer-to-peer\" approach, without content distribution servers. This ensures there are no trace in the cloud and provides unique privacy protection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes cifrados se intercambian directamente entre dispositivos en tiempo real, utilizando un enfoque \"peer-to-peer\", sin servidores de distribución de contenido. Esto garantiza que no haya rastros en la nube y brinda una protección de privacidad única."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیام‌های رمزگذاری‌شده مستقیماً بین دستگاه‌ها در زمان واقعی، با استفاده از رویکرد \"همتا به همتا\" بدون سرورهای توزیع محتوا مبادله می‌شوند. این تضمین می کند که هیچ اثری در ابر وجود ندارد و حفاظت از حریم خصوصی منحصر به فردی را فراهم می کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salattuja viestejä vaihdetaan suoraan laitteiden välillä reaaliajassa käyttämällä \"peer-to-peer\" -lähestymistapaa ilman sisällönjakelupalvelimia. Tämä varmistaa, että pilvessä ei ole jälkiä ja tarjoaa ainutlaatuisen yksityisyyden suojan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages chiffrés sont échangés directement entre les appareils en temps réel, en utilisant une approche \"peer-to-peer\", sans serveurs de distribution de contenu. Cela garantit l’absence de trace dans le cloud et offre une protection unique de la confidentialité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הודעות מוצפנות מוחלפות ישירות בין מכשירים בזמן אמת, תוך שימוש בגישת \"עמית לעמית\", ללא שרתי הפצת תוכן. זה מבטיח שאין עקבות בענן ומספק הגנת פרטיות ייחודית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री वितरण सर्वर के बिना \"पीयर-टू-पीयर\" दृष्टिकोण का उपयोग करते हुए, एन्क्रिप्ट किए गए संदेशों का वास्तविक समय में उपकरणों के बीच सीधे आदान-प्रदान किया जाता है। यह सुनिश्चित करता है कि क्लाउड में कोई निशान नहीं है और अद्वितीय गोपनीयता सुरक्षा प्रदान करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrirane poruke razmjenjuju se izravno između uređaja u stvarnom vremenu, pristupom „peer-to-peer”, bez poslužitelja za distribuciju sadržaja. To osigurava da nema tragova u oblaku i pruža jedinstvenu zaštitu privatnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A titkosított üzenetek valós időben, közvetlenül eszközről eszközre kerülnek továbbításra, tartalomszerverek nélkül. Ez biztosítja, hogy ne maradjon nyom a felhőben, és egyedi adatvédelmet nyújt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan terenkripsi dipertukarkan langsung antar perangkat dalam waktu nyata, menggunakan pendekatan \"peer-to-peer\", tanpa server distribusi konten. Ini memastikan tidak ada jejak di cloud dan memberikan perlindungan privasi yang unik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi crittografati vengono scambiati direttamente tra i dispositivi in tempo reale, utilizzando un approccio \"peer-to-peer\", senza server di distribuzione dei contenuti. Ciò garantisce che non vi siano tracce nel cloud e fornisce una protezione della privacy unica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されたメッセージは、コンテンツ配信サーバーなしで「ピアツーピア」アプローチを使用して、リアルタイムでデバイス間で直接交換されます。 これにより、クラウドに痕跡が残らず、独自のプライバシー保護が提供されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 메시지는 콘텐츠 배포 서버 없이 \"peer-to-peer\" 접근 방식을 사용하여 장치 간에 실시간으로 직접 교환됩니다. 이렇게 하면 클라우드에 흔적이 남지 않으며 고유한 개인 정보 보호 기능을 제공합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypterte meldinger utveksles direkte mellom enheter i sanntid, ved hjelp av en \"peer-to-peer\"-tilnærming, uten innholdsdistribusjonsservere. Dette sikrer at det ikke er spor i skyen og gir unik personvernbeskyttelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versleutelde berichten worden rechtstreeks in realtime uitgewisseld tussen apparaten, met behulp van een \"peer-to-peer\"-benadering, zonder contentdistributieservers. Dit zorgt ervoor dat er geen spoor in de cloud is en biedt unieke privacybescherming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaszyfrowane wiadomości są wymieniane bezpośrednio między urządzeniami w czasie rzeczywistym, przy użyciu metody „peer-to-peer”, bez serwerów dystrybucji treści. Zapewnia to brak śladów w chmurze i zapewnia wyjątkową ochronę prywatności."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens criptografadas são trocadas diretamente entre os dispositivos em tempo real, usando uma abordagem \"peer-to-peer\", sem servidores de distribuição de conteúdo. Isso garante que não haja vestígios na nuvem e fornece proteção de privacidade exclusiva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajele criptate sunt schimbate direct între dispozitive în timp real, fără servere de distribuție. Astfel nu există urme în cloud și se asigură confidențialitate unică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмен зашифрованными сообщениями между устройствами осуществляется напрямую в режиме реального времени с использованием подхода \"peer-to-peer\" без использования серверов распространения контента. Это гарантирует отсутствие следов в облаке и обеспечивает уникальную защиту конфиденциальности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrované správy sa vymieňajú priamo medzi zariadeniami v reálnom čase pomocou peer‑to‑peer prístupu, bez distribučných serverov. Zaručuje to nulové stopy v cloude a jedinečnú ochranu súkromia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrirana sporočila se izmenjujejo neposredno med napravami v realnem času z uporabo pristopa »peer-to-peer«, brez strežnikov za distribucijo vsebine. To zagotavlja, da v oblaku ni sledi, in nudi edinstveno zaščito zasebnosti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesazhet e enkriptuara shkëmbehen drejtpërdrejt midis pajisjeve në kohë reale, duke përdorur një qasje \\\"peer-to-peer\\\", pa serverë shpërndarjeje të përmbajtjes. Kjo siguron që të mos ketë gjurmë në cloud dhe ofron mbrojtje unike të privatësisë."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrovane poruke se razmenjuju direktno između uređaja u realnom vremenu, koristeći \\\"peer-to-peer\\\" pristup, bez servera za distribuciju sadržaja. Ovo osigurava da nema tragova u oblaku i pruža jedinstvenu zaštitu privatnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypterade meddelanden utbyts direkt mellan enheter i realtid, med hjälp av en \"peer-to-peer\"-metod, utan innehållsdistributionsservrar. Detta säkerställer att det inte finns några spår i molnet och ger ett unikt integritetsskydd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifreli mesajlar, içerik dağıtım sunucuları olmadan, \"peer-to-peer\" yaklaşımı kullanılarak gerçek zamanlı olarak doğrudan cihazlar arasında değiş tokuş edilir. Bu, bulutta iz olmamasını sağlar ve benzersiz gizlilik koruması sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зашифровані повідомлення обмінюються безпосередньо між пристроями в режимі реального часу за допомогою \"peer-to-peer\" підходу без серверів розподілу вмісту. Це гарантує відсутність слідів у хмарі та забезпечує унікальний захист конфіденційності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn được mã hóa trao đổi trực tiếp giữa thiết bị theo thời gian thực, không qua máy chủ trung gian. Điều này bảo đảm không để lại dấu vết và bảo vệ quyền riêng tư tối đa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密消息直接在设备之间实时交换，使用“点对点”方法，无需内容分发服务器。 这确保了云中没有痕迹，并提供了独特的隐私保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密消息直接在設備之間實時交換，使用“點對點”方法，無需內容分發服務器。這確保了雲中沒有痕跡，並提供了獨特的隱私保護。"
          }
        }
      }
    },
    "quality_of_service_view_step2_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لضمان جودة خدمة جيدة ، قم بتهيئة جهازك للسماح للتطبيق بتلقي الإشعارات في الخلفية واستبعاده من تحسينات البطارية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да осигурите добро качество на услугата, настройте устройството да позволява на приложението да получава известия във фонов режим и го изключете от оптимизациите за батерия."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro zajištění dobré kvality služby nakonfigurujte zařízení tak, aby aplikace mohla přijímat oznámení na pozadí a byla vyloučena z optimalizace baterie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at sikre en god servicekvalitet skal du konfigurere din enhed til at tillade applikationen at modtage meddelelser i baggrunden og udelukke den fra batterioptimeringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um eine gute Dienstqualität zu gewährleisten, konfigurieren Sie Ihr Gerät so, dass die Anwendung im Hintergrund Benachrichtigungen empfangen kann und von der Akku-Optimierung ausgenommen wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για καλή ποιότητα υπηρεσίας, ρυθμίστε τη συσκευή σας ώστε να επιτρέπει στην εφαρμογή να λαμβάνει ειδοποιήσεις στο παρασκήνιο και να εξαιρείται από βελτιστοποιήσεις μπαταρίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ensure a good quality of service, configure your device to allow the application to receive notifications in the background and exclude it from battery optimizations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantizar una buena calidad de servicio, configure su dispositivo para permitir que la aplicación reciba notificaciones en segundo plano y exclúyala de las optimizaciones de batería."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای اطمینان از کیفیت خوب خدمات، دستگاه خود را طوری پیکربندی کنید که به برنامه اجازه دهد اعلان‌ها را در پس‌زمینه دریافت کند و آن را از بهینه‌سازی باتری حذف کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmistaaksesi hyvän palvelun laadun, määritä laitteesi sallimaan sovelluksen vastaanottaa ilmoituksia taustalla ja sulkemaan se pois akun optimoinnista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour garantir une bonne qualité de service, configurez votre appareil pour permettre à l’application de recevoir des notifications en arrière-plan et l’exclure de l’optimisation de la batterie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להבטיח איכות טובה של שירות, הגדר את המכשיר שלך כך שיאפשר לאפליקציה לקבל התראות ברקע ולא לכלול אותה מאופטימיזציה של הסוללה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेवा की अच्छी गुणवत्ता सुनिश्चित करने के लिए, एप्लिकेशन को पृष्ठभूमि में सूचनाएं प्राप्त करने की अनुमति देने के लिए अपने डिवाइस को कॉन्फ़िगर करें और इसे बैटरी ऑप्टिमाइज़ेशन से बाहर करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako biste osigurali dobru kvalitetu usluge, konfigurirajte svoj uređaj tako da aplikaciji dopusti primanje obavijesti u pozadini i izuzmite je iz optimizacija baterije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jó szolgáltatásminőség érdekében engedélyezd az alkalmazás számára, hogy értesítéseket fogadjon a háttérben, és zárd ki az akkumulátoroptimalizációból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memastikan kualitas layanan yang baik, konfigurasikan perangkat Anda untuk mengizinkan aplikasi menerima pemberitahuan di latar belakang dan mengecualikannya dari pengoptimalan baterai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per garantire una buona qualità del servizio, configura il tuo dispositivo per consentire all’applicazione di ricevere notifiche in background ed escluderlo dalle ottimizzazioni della batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優れたサービス品質を確保するには、アプリケーションがバックグラウンドで通知を受信し、バッテリーの最適化から除外できるようにデバイスを構成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우수한 서비스 품질을 보장하려면 애플리케이션이 백그라운드에서 알림을 수신하고 배터리 최적화에서 제외하도록 장치를 구성하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å sikre god servicekvalitet, konfigurer enheten din slik at applikasjonen mottar varsler i bakgrunnen og ekskluderer den fra batterioptimalisering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een goede servicekwaliteit te garanderen, configureert u uw apparaat zodat de applicatie meldingen op de achtergrond kan ontvangen en sluit het uit van batterij-optimalisaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zapewnić dobrą jakość usługi, skonfiguruj swoje urządzenie tak, aby aplikacja otrzymywała powiadomienia w tle i wykluczała ją z optymalizacji baterii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantir uma boa qualidade de serviço, configure seu dispositivo para permitir que o aplicativo receba notificações em segundo plano e exclua-o das otimizações de bateria."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru o calitate bună a serviciului, permiteți aplicației să primească notificări în fundal și excludeți-o din optimizările de baterie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы обеспечить хорошее качество обслуживания, настройте свое устройство, чтобы разрешить приложению получать уведомления в фоновом режиме и исключить его из оптимизации батареи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby ste zaistili kvalitnú službu, povoľte aplikácii prijímať upozornenia na pozadí a vylúčte ju z optimalizácie batérie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dobro kakovost storitve nastavite napravo tako, da aplikaciji dovoli prejemanje obvestil v ozadju in jo izključi iz optimizacij baterije."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Për të siguruar një cilësi të mirë shërbimi, konfiguroni pajisjen tuaj që të lejojë aplikacionin të marrë njoftime në sfond dhe përjashtojeni nga optimizimet e baterisë."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da biste obezbedili dobar kvalitet usluge, podesite uređaj tako da dozvoli aplikaciji da prima obaveštenja u pozadini i izuzmite je iz optimizacije baterije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att säkerställa en god servicekvalitet, konfigurera din enhet så att applikationen får aviseringar i bakgrunden och utesluter den från batterioptimering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İyi bir hizmet kalitesi sağlamak için cihazınızı, uygulamanın arka planda bildirim almasına izin verecek ve pil optimizasyonlarından hariç tutacak şekilde yapılandırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб забезпечити високу якість обслуговування, налаштуйте свій пристрій, щоб програма могла отримувати сповіщення у фоновому режимі та виключити його з оптимізації батареї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để đảm bảo chất lượng dịch vụ, hãy cho phép ứng dụng nhận thông báo nền và loại trừ khỏi tối ưu hóa pin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为确保优质的服务，请将您的设备配置为允许应用程序在后台接收通知并将其排除在电池优化之外。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為確保優質的服務，請將您的設備配置為允許應用程序在後台接收通知並將其排除在電池優化之外。"
          }
        }
      }
    },
    "quality_of_service_view_step3_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " استخدم التطبيق بشكل متكرر حتى يعطي نظام التشغيل الأولوية له ولا ينهيه بشكل غير متوقع. \n\n ولا تنس إخبار جهات الاتصال الخاصة بك بهذا!"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте приложението редовно, за да му придаде ОС приоритет и да не го прекъсва неочаквано.\\n\\nИ не забравяйте да информирате и вашите контакти!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikaci používejte často, aby ji systém upřednostnil a neukončoval nečekaně.\\n\\nA nezapomeňte o tom informovat své kontakty!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug appen ofte, så operativsystemet prioriterer den og ikke afslutter den uventet. \n\nOg glem ikke at informere dine kontakter om dette!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie die Anwendung regelmäßig, damit das Betriebssystem sie priorisiert und nicht unerwartet beendet. \\n\\nUnd vergessen Sie nicht, auch Ihre Kontaktpersonen darüber zu informieren!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε συχνά την εφαρμογή ώστε το λειτουργικό σύστημα να της δίνει προτεραιότητα και να μην τη διακόπτει απροσδόκητα.\\n\\nΚαι μην ξεχάσετε να ενημερώσετε και τις επαφές σας!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app frequently so the OS prioritizes it, and doesn’t terminate it unexpectedly. \n\nAnd don’t forget to inform your contacts about this!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice la aplicación con frecuencia para que el sistema operativo le dé prioridad y no la cierre inesperadamente. \n\n¡Y no olvides informar a tus contactos sobre esto!"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از برنامه مکرر استفاده کنید تا سیستم عامل آن را در اولویت قرار دهد و به طور غیرمنتظره آن را خاتمه ندهد. \n\nو فراموش نکنید که در این مورد به مخاطبین خود اطلاع دهید!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä sovellusta usein, jotta käyttöjärjestelmä priorisoi sen eikä lopeta sitä odottamatta. \n\nJa muista ilmoittaa tästä yhteyshenkilöllesi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez fréquemment l’application pour que le système d’exploitation la considère comme importante et ne la termine pas de manière inattendue. \n\nEt n’oubliez pas d’en informer vos contacts !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש באפליקציה לעתים קרובות כדי שמערכת ההפעלה תתעדף אותה, ולא תפסיק אותה באופן בלתי צפוי. \n\nואל תשכח ליידע את אנשי הקשר שלך על כך!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप्लिकेशन का बार-बार उपयोग करें ताकि OS इसे प्राथमिकता दे, और इसे अनपेक्षित रूप से समाप्त न करे। \n\nऔर अपने संपर्कों को इस बारे में सूचित करना न भूलें!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite aplikaciju često kako bi joj OS dao prioritet i kako je ne bi neočekivano prekinuo.\\n\\nI ne zaboravite o tome obavijestiti svoje kontakte!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használd gyakran az alkalmazást, hogy az operációs rendszer előnyben részesítse, és ne zárja be váratlanul.\\n\\nÉs ne felejtsd el tájékoztatni a kapcsolataidat is!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan aplikasi sesering mungkin agar OS memprioritaskannya, dan tidak menghentikannya secara tiba-tiba. \n\nDan jangan lupa untuk memberi tahu kontak Anda tentang hal ini!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa frequentemente l’app in modo che il sistema operativo le dia la priorità e non la chiuda inaspettatamente. \n\nE non dimenticare di informare i tuoi contatti di questo!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを頻繁に使用して、OS がアプリを優先し、予期せず終了しないようにします。 \n\n連絡先にこのことを知らせることを忘れないでください!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OS가 우선 순위를 지정하고 예기치 않게 종료되지 않도록 앱을 자주 사용하세요. \n\n연락처에 이 사실을 알리는 것을 잊지 마세요!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk appen ofte slik at operativsystemet prioriterer den og ikke avslutter den uventet. \n\nOg ikke glem å informere kontaktene dine om dette!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de app regelmatig, zodat het besturingssysteem er prioriteit aan geeft en deze niet onverwacht beëindigt. \n\nEn vergeet niet je contacten hierover te informeren!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Często korzystaj z aplikacji, aby system operacyjny nadał jej priorytet i nie przerywał jej nieoczekiwanie. \n\nI nie zapomnij poinformować o tym swoich kontaktów!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o aplicativo com frequência para que o sistema operacional o priorize e não o encerre inesperadamente. \n\nE não se esqueça de informar seus contatos sobre isso!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți aplicația frecvent, astfel încât sistemul să o prioritizeze și să nu o închidă neașteptat.\\n\\nȘi nu uitați să vă informați contactele!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте приложение часто, чтобы ОС отдавала ему приоритет и не прерывала его работу неожиданно. \n\nИ не забудьте сообщить об этом своим контактам!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používajte aplikáciu pravidelne, aby ju OS uprednostnil a neukončoval ju nečakane. \\n\\nA nezabudnite o tom informovať aj svoje kontakty!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacijo uporabljajte pogosto, da ji operacijski sistem daje prednost in je ne prekine nepričakovano.\\n\\nIn ne pozabite o tem obvestiti svojih stikov!"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Përdoreni aplikacionin shpesh që OS ta prioritizojë dhe të mos e ndërpresë papritur. \\n\\nDhe mos harroni t’i informoni kontaktet tuaja për këtë!"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite aplikaciju često kako bi je OS prioritizovao i ne bi je neočekivano zaustavljao. \\n\\nI ne zaboravite da o ovome obavestite svoje kontakte!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd appen ofta så att operativsystemet prioriterar den och inte avslutar den oväntat. \n\nOch glöm inte att informera dina kontakter om detta!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşletim sisteminin öncelik vermesi ve beklenmedik bir şekilde sonlandırmaması için uygulamayı sık sık kullanın. \n\nKişilerinizi de bu konuda bilgilendirmeyi unutmayın!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте програму часто, щоб ОС визначила її пріоритет і не припиняла несподівано. \n\nІ не забудьте повідомити про це своїх контактів!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng ứng dụng thường xuyên để hệ điều hành ưu tiên và không tự động đóng nó.\n\nĐừng quên chia sẻ thông tin này cho bạn bè!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经常使用该应用程序，以便操作系统对其进行优先排序，并且不会意外终止它。 \n\n别忘了将此事告知您的联系人！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "經常使用該應用程序，以便操作系統對其進行優先排序，並且不會意外終止它。 \n\n別忘了將此事告知您的聯繫人！"
          }
        }
      }
    },
