        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A funcionalidade \"Click-to-call\" permite que os convidados lhe telefonem ou participem numa chamada em conferência (\"Click-to-meet\") a partir de um browser, sem ter de instalar a aplicação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
