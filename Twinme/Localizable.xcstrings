    "fullscreen_qrcode_view_save_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم باستيراد أو مسح رمز الاستجابة السريعة للدعوة باستخدام Skred لإضافة جهة الاتصال هذه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортирайте или сканирайте този QR-код за покана с Skred, за да добавите този контакт."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importujte nebo naskenujte tento pozvánkový QR kód pomocí Skred pro přidání kontaktu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer eller scan denne invitations QR-kode med Skred for at tilføje denne kontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren oder scannen Sie diesen Einladungs-QR-Code mit Skred, um diese Kontaktperson hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε ή σαρώστε αυτόν τον κωδικό QR με το Skred για να προσθέσετε αυτή την επαφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import or scan this invitation QR-Code with Skred to add this contact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe o escanee este código QR de invitación con Skred para agregar este contacto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای افزودن این مخاطب، این QR-Code دعوت را با Skred وارد یا اسکن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo tai skannaa tämän kutsun QR-koodi Skred lisätäksesi tämän yhteystiedon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez ou scannez ce QR-Code d’invitation avec Skred pour ajouter ce contact."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יבא או סרוק את ה-QR-Code של ההזמנה עם Skred כדי להוסיף איש קשר זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस संपर्क को जोड़ने के लिए Skred के साथ इस आमंत्रण क्यूआर-कोड को आयात या स्कैन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvezite ili skenirajte ovaj pozivni QR-kôd pomoću Skred kako biste dodali ovaj kontakt."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importáld vagy olvasd be ezt a QR-kódot Skred segítségével a kapcsolat hozzáadásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impor atau pindai Kode QR undangan ini dengan Skred untuk menambahkan kontak ini."
          }
        },
        "it" : {
