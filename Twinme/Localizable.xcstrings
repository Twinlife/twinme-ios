    "settings_room_view_allow_invite_as_personal_contact" : {
      "comment" : "SettingsRoomViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح للمشاركين بدعوة مشاركين آخرين كجهات اتصال شخصية"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешава на участниците да канят други като лични контакти"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit účastníkům zvát jiné účastníky jako osobní kontakty"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad deltagerne at invitere andre deltagere som personlige kontakter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilnehmern erlauben, andere Teilnehmer als persönliche Kontakte einzuladen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε στους συμμετέχοντες να προσκαλούν άλλους ως προσωπικές επαφές"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow participants to invite other participants as personal contacts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que los participantes inviten a otros participantes como contactos personales"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به شرکت کنندگان اجازه دهید سایر شرکت کنندگان را به عنوان تماس شخصی دعوت کنند"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli osallistujien kutsua yhteystietonsa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les participants à inviter d’autres participants en tant que contacts personnels"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר למשתתפים להזמין משתתפים אחרים כקשרים אישיים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिभागियों को अपने संपर्कों को आमंत्रित करने दें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopusti sudionicima da pozovu druge sudionike kao osobne kontakte"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A résztvevők meghívhatnak más résztvevőket személyes kontaktként"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan peserta untuk mengundang peserta lain sebagai kontak pribadi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti ai partecipanti di invitare altri partecipanti come contatti personali"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加者が他の参加者を個人的な連絡先として招待できるようにする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
