    "lock_screen_view_passcode_not_set" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم تعيين إعدادات مصادقة الجهاز. انتقل إلى إعدادات النظام واضبطها لفتح التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройките за удостоверяване на устройството не са зададени. Отидете в системните настройки и ги задайте, за да отключите приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení ověření zařízení nejsou nastavena. Přejděte do systémových nastavení a nastavte je pro odemknutí aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhedsgodkendelsesindstillinger er ikke indstillet. Gå til systemindstillingerne, og indstil dem til at låse applikationen op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen für die Geräteauthentifizierung sind nicht festgelegt. Gehen Sie zu den Systemeinstellungen und stellen Sie sie so ein, dass die Anwendung entsperrt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις ταυτοποίησης της συσκευής δεν έχουν οριστεί. Μεταβείτε στις ρυθμίσεις συστήματος και ορίστε τις για να ξεκλειδώσετε την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device authentication settings are not set. Go to the system settings and set them to unlock the application."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración de autenticación del dispositivo no está establecida. Vaya a la configuración del sistema y configúrelos para desbloquear la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیمات تأیید اعتبار دستگاه تنظیم نشده است. به تنظیمات سیستم بروید و آنها را برای باز کردن قفل برنامه تنظیم کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitetodennusasetuksia ei ole määritetty. Siirry järjestelmäasetuksiin ja aseta ne avaamaan sovellus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres d’authentification de l’appareil ne sont pas définis. Accédez aux paramètres système et définissez-les pour déverrouiller l’application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות אימות המכשיר אינן מוגדרות. עבור אל הגדרות המערכת והגדר אותן לביטול נעילת האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस प्रमाणीकरण सेटिंग्स सेट नहीं हैं। सिस्टम सेटिंग्स पर जाएं और उन्हें एप्लिकेशन अनलॉक करने के लिए सेट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavke autentifikacije uređaja nisu postavljene. Idite u sistemske postavke i postavite ih za otključavanje aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszköz hitelesítési beállításai nincsenek beállítva. Lépjen a rendszerbeállításokhoz, és állítsa be őket az alkalmazás feloldásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan otentikasi perangkat tidak diatur. Buka pengaturan sistem dan atur untuk membuka kunci aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni di autenticazione del dispositivo non sono impostate. Vai alle impostazioni di sistema e impostale per sbloccare l’applicazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス認証設定が設定されていません。 システム設定に移動し、アプリケーションのロックを解除するように設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치 인증 설정이 설정되지 않았습니다. 시스템 설정으로 이동하여 애플리케이션 잠금을 해제하도록 설정하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhetsautentiseringsinnstillinger er ikke angitt. Gå til systeminnstillingene og still dem til å låse opp applikasjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instellingen voor apparaatverificatie zijn niet ingesteld. Ga naar de systeeminstellingen en stel ze in om de applicatie te ontgrendelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia uwierzytelniania urządzenia nie są skonfigurowane. Przejdź do ustawień systemowych i ustaw je, aby odblokować aplikację."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia uwierzytelniania urządzenia nie są skonfigurowane. Przejdź do ustawień systemowych i ustaw je, aby odblokować aplikację."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setările de autentificare ale dispozitivului nu sunt configurate. Mergeți la setările de sistem și setați-le pentru a debloca aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки аутентификации устройства не заданы. Зайдите в настройки системы и установите их для разблокировки приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
