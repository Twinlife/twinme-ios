    "call_view_repeat_word" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سيتمكن من مقارنتها مع تلك الموجودة على شاشته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ще може да я сравни с тази на неговия/нейния екран."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jej může porovnat s tím, který vidí na své obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vil kunne sammenligne det med det, der vises på hans/hendes skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird es mit dem Wort auf seinem/ihrem Bildschirm vergleichen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ θα μπορέσει να τη συγκρίνει με αυτήν που εμφανίζεται στην οθόνη του/της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be able to compare it with the one on his/her screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podrá compararla con la que aparece en su pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ قادر خواهد بود آن را با صفحه نمایش خود مقایسه کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ voi verrata sitä ruudullaan näkyvään sanaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pourra le comparer avec celui de son écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ יוכל להשוות את זה לזה שבמסך שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इसकी तुलना अपनी स्क्रीन से कर सकेगा."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ će je moći usporediti s onom na svom zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ össze tudja hasonlítani a képernyőjén lévő szóval."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ akan dapat membandingkannya dengan layarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ potrà confrontarla con quella visualizzata sul suo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はそれを自分の画面と比較できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 상대방은 자신의 화면에 표시된 단어와 비교할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vil kunne sammenligne det med det som vises på skjermen hans/hennes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan het vergelijken met het woord op zijn/haar scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ będzie mógł porównać je ze słowem na swoim ekranie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poderá compará-la com a que aparece no seu ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ îl va putea compara cu cel de pe ecranul său."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сможет сравнить его с тем, что отображается на его/ее экране."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ho bude môcť porovnať so slovom zobrazeným na jeho/jej obrazovke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jo bo lahko primerjal/-a s tisto na svojem zaslonu."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ do të jetë në gjendje ta krahasojë me atë në ekranin e tij/saj."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ će moći da je uporedi sa onom na svom ekranu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kommer att kunna jämföra det med det som visas på hans/hennes skärm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kendi ekranındaki ile karşılaştırabilecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ зможе порівняти його з тим, що відображається на його екрані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ có thể so sánh từ này với từ hiển thị trên màn hình của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将能与他/她屏幕上的单词进行比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 將能與他/她螢幕上的單字進行比較。"
          }
        }
      }
    },
