    "template_click_to_call_view_template_video_bell_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لسائق التوصيل بالاتصال بك للحصول على التعليمات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволете на куриера да ви се обади за инструкции."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožněte doručovateli zavolat vám pro pokyny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad chaufføren at ringe til dig for at få instruktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglichen Sie es dem Paketboten, Sie für Anweisungen anzurufen."
