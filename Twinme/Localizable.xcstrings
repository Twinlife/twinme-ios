        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sertifikovan“ odnos osigurava da uvek komunicirate sa pravom osobom, čak i ako je usluga kompromitovana od strane treće strane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En \"certifierad\" relation säkerställer att du alltid kommunicerar med rätt person, även om tjänsten har äventyrats av en tredje part."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onaylı bir ilişki, hizmet üçüncü bir tarafça tehlikeye atılmış olsa bile her zaman doğru kişiyle iletişim kurduğunuzdan emin olmanızı sağlar."
