    "conversation_view_edit_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تعديل الرسالة على جهاز جهة اتصالك إلا إذا كان تطبيقها مُحدّثًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съобщението може да бъде редактирано на устройството на вашия контакт само ако тяхната версия на приложението е актуална."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zprávu lze upravit na zařízení kontaktu pouze tehdy, pokud má aktuální verzi aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskeden kan kun redigeres på din kontakts enhed, hvis deres app er opdateret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht kann nur auf dem Gerät Ihrer Kontaktperson bearbeitet werden, wenn deren App auf dem neuesten Stand ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μήνυμα μπορεί να επεξεργαστεί μόνο στη συσκευή της επαφής σας αν η εφαρμογή της είναι ενημερωμένη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The message can only be edited on your contact's device if their app is up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mensaje solo se puede editar en el dispositivo del contacto si su aplicación está actualizada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیام فقط در صورتی قابل ویرایش در دستگاه مخاطب شما است که برنامه او به"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viestiä voi muokata yhteyshenkilösi laitteella vain, jos hänen sovelluksensa on ajan tasalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le message ne peut être modifié sur l'appareil de votre contact que si son application est à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לערוך את ההודעה במכשיר של איש הקשר רק אם האפליקציה שלו מעודכנת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेश को आपके संपर्क के डिवाइस पर तभी संपादित किया जा सकता है, जब उनका ऐप अप-टू-डेट हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruku je moguće urediti na uređaju vašeg kontakta samo ako je njegova/njezina aplikacija ažurirana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az üzenet a kapcsolat eszközén csak akkor szerkeszthető, ha az alkalmazása naprakész."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan hanya dapat diedit di perangkat kontak Anda jika aplikasinya sudah diperbarui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il messaggio può essere modificato sul dispositivo del tuo contatto solo se la sua app è aggiornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先のデバイスでメッセージを編集するには、アプリが最新である必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처의 기기가 최신 상태인 경우에만 해당 기기에서 메시지를 편집할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen kan bare redigeres på kontaktens enhet hvis appen deres er oppdatert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bericht kan alleen worden bewerkt op het apparaat van je contactpersoon als de app up-to-date is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomość można edytować tylko na urządzeniu kontaktu, jeśli jego aplikacja jest aktualna."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mensagem só poderá ser editada no dispositivo do seu contacto se a sua aplicação estiver atualizada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajul poate fi editat pe dispozitivul contactului doar dacă aplicația acestuia este actualizată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение можно редактировать на устройстве вашего контакта, только если его приложение обновлено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správa môže byť upravená na zariadení kontaktu iba ak má aktuálnu verziu aplikácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporočilo je mogoče urediti na napravi vašega stika le, če je njegova aplikacija posodobljena."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesazhi mund të redaktohet në pajisjen e kontaktit tuaj vetëm nëse aplikacioni i tij/saj është i përditësuar."
          }
