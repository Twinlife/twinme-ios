    "create_space_view_onboarding_message_part_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تساعدك المساحات على تنظيم جهات الاتصال الخاصة بك وفقًا لدوائرك الاجتماعية التي ينتمون إليها، على سبيل المثال. العائلة، الأصدقاء، الأعمال، المرح، إلخ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Пространствата“ ви помагат да организирате контактите си според социалния кръг, към който принадлежат — например семейство, приятели, бизнес, забавление и др."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Prostory“ vám pomáhají organizovat kontakty podle společenských okruhů, například Rodina, Přátelé, Práce, Zábava atd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces hjælper dig med at organisere dine kontakter efter, hvilke af dine sociale cirkler de tilhører, f.eks. Familie, venner, forretning, sjov osv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bereiche“ helfen Ihnen dabei, Ihre Kontaktpersonen nach sozialen Kreisen zu organisieren, zu denen sie gehören, z. B. Familie, Freunde, Geschäftlich, Freizeit usw."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι «Χώροι» οργανώνουν τις επαφές σας ανάλογα με τον κοινωνικό κύκλο όπου ανήκουν, π.χ. Οικογένεια, Φίλοι, Εργασία, Ψυχαγωγία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces help you organize your contacts according to which of your social circles they belong to, eg. Family, Friends, Business, Fun, etc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Spaces te ayudan a organizar tus contactos según a cuál de tus círculos sociales pertenecen, por ejemplo. Familia, Amigos, Negocios, Diversión, etc."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فضاها به شما کمک می کند تا مخاطبین خود را بر اساس اینکه به کدام یک از حلقه های اجتماعی خود تعلق دارند، سازماندهی کنید. خانواده، دوستان، تجارت، سرگرمی و غیره"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces auttaa sinua järjestämään yhteystietosi sen mukaan, mihin sosiaalisiin piireihin he kuuluvat, esim. Perhe, ystävät, bisnes, hauskanpito jne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les « Spaces» vous aident à organiser vos contacts en fonction du cercle social auquel ils appartiennent, par exemple. Famille, Amis, Business, Fun, etc."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרחבים עוזרים לך לארגן את אנשי הקשר שלך לפי איזה מהמעגלים החברתיים שלך הם שייכים, למשל. משפחה, חברים, עסקים, כיף וכו'."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पेस आपको अपने संपर्कों को इस अनुसार व्यवस्थित करने में मदद करता है कि वे आपके किस सामाजिक दायरे से संबंधित हैं, उदाहरण के लिए। परिवार, मित्र, व्यवसाय, मौज-मस्ती, आदि।"
          }
        },
        "hr" : {
          "stringUnit" : {
