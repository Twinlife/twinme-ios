          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavitve preverjanja pristnosti naprave niso nastavljene. Pojdite v sistemske nastavitve in jih nastavite za odklepanje aplikacije."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilësimet e autentifikimit të pajisjes nuk janë vendosur. Shkoni te cilësimet e sistemit dhe vendosini ato për të zhbllokuar aplikacionin."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
