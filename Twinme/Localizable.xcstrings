    "group_member_view_remove_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من أنك تريد إزالة الأعضاء من هذه المجموعة؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигурни ли сте, че искате да премахнете членове от тази група?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu chcete odebrat členy z této skupiny?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil fjerne medlemmer fra denne gruppe?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie Mitglieder aus dieser Gruppe entfernen möchten?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε βέβαιοι ότι θέλετε να αφαιρέσετε μέλη από αυτήν την ομάδα;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to remove members from this group?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que deseas eliminar miembros de este grupo?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئن هستید که می خواهید اعضای این گروه را حذف کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko varmasti poistaa jäseniä tästä ryhmästä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment supprimer des membres de ce groupe ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם אכן להסיר חברים מקבוצה זו?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई इस समूह से सदस्यों को निकालना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeste li sigurni da želite ukloniti članove iz ove grupe?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan el akarod távolítani a tagokat a csoportból?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda yakin ingin menghapus anggota dari grup ini?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler rimuovere membri da questo gruppo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループからメンバーを削除してもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹에서 회원을 삭제 하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil fjerne medlemmer fra denne gruppen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je leden uit deze groep wilt verwijderen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz usunąć członków z tej grupy?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja remover membros deste grupo?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigur doriți să eliminați membri din acest grup?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите удалить участников из этой группы?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naozaj chcete odstrániť členov z tejto skupiny?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali ste prepričani, da želite odstraniti člane iz te skupine?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jeni i sigurt që dëshironi t’i hiqni anëtarët nga ky grup?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da li ste sigurni da želite da uklonite članove iz ove grupe?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill ta bort medlemmar från den här gruppen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gruptaki üyeleri kaldırmak istediğinizden emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені, що хочете видалити учасників з цієї групи?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc muốn xóa thành viên khỏi nhóm này không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要从该组中删除成员吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要從該組中刪除成員嗎？"
          }
        }
      }
    },
