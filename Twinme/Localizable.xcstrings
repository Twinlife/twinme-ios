          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica non appena il primo partecipante si unisce alla conferenza. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
