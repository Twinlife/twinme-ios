    "create_space_view_contacts_no_profile" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لنقل جهات الاتصال إلى Space ، يجب عليك إكمال ملف التعريف الذي يمثلك لجهات الاتصال الخاصة بك. هل تريد إكماله؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да преместите контакти в Space, трябва да завършите профила, който ви представя пред контактите ви. Искате ли да го завършите?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li přesunout kontakty do Prostoru, musíte dokončit profil, který vás představuje vašim kontaktům. Chcete jej dokončit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at flytte kontakter til et Space, skal du udfylde den profil, der repræsenterer dig for dine kontakter. Vil du fuldføre det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Kontakte in ein Space zu verschieben, müssen Sie das Profil vervollständigen, das Sie für Ihre Kontakte darstellt. Möchten Sie es vervollständigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να μετακινήσετε επαφές σε έναν Χώρο, πρέπει να ολοκληρώσετε το προφίλ που σας αντιπροσωπεύει στις επαφές σας. Θέλετε να το ολοκληρώσετε;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To move contacts to a Space, you must complete the profile that represents you to your contacts. Do you want to complete it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mover contactos a un Space, debe completar el perfil que lo representa a sus contactos. ¿Quieres completarlo?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتقال مخاطبین به Space ، باید نمایه ای را ارائه دهید که نمایانگر شما برای مخاطبین است. آیا می خواهید آن را تکمیل کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat siirtää yhteystietoja Space, sinun on suoritettava profiili, joka edustaa sinua kontakteihisi. Haluatko suorittaa sen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour déplacer des contacts vers un Space, vous devez compléter le profil qui vous représente auprès de vos contacts. Voulez-vous le compléter ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להעביר קבוצה לSpace, עליך להשלים את הפרופיל שמייצג אותך מול איש קשר זה. האם ברצונך להשלים זאת?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संपर्कों को Space में ले जाने के लिए, आपको उस प्रोफ़ाइल को पूरा करना होगा जो आपके संपर्कों से आपका प्रतिनिधित्व करती है। क्या आप इसे पूरा करना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za premještanje kontakata u Prostor morate dovršiti profil koji vas predstavlja vašim kontaktima. Želite li ga dovršiti?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A névjegyek Space-be mozgatásához ki kell töltenie azt a profilt, amely Önt a névjegyei felé képviseli. Szeretné kitölteni?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memindahkan kontak ke Space, Anda harus melengkapi profil yang mewakili Anda ke kontak Anda. Apakah Anda ingin melengkapinya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per spostare i contatti in uno Space, è necessario completare il profilo che ti rappresenta per i tuoi contatti. Vuoi completarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先をSpaceに移動するには、連絡先を表すプロファイルを完成させる必要があります。完了しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처를 Space으로 이동하려면 연락처를 나타내는 프로필을 작성해야합니다. 완료 하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å flytte kontakter til et Space, må du fullføre profilen som representerer deg for kontaktene dine. Vil du fullføre det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om contacten naar een Space te verplaatsen, moet u het profiel invullen dat u voor uw contacten vertegenwoordigt. Wil je het voltooien?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przenieść kontakty do Space, musisz wypełnić profil, który reprezentuje Cię dla Twoich kontaktów. Chcesz to zakończyć?"
          }
        },
        "pt-PT" : {
