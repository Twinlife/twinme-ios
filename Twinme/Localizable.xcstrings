    "create_external_call_view_conference_call_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انضم إلى مكالمة جماعية مباشرة من المتصفح. مثالية لاجتماعات العمل أو الاجتماعات العائلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присъединете се към конферентен разговор директно през браузър. Идеално за бизнес или семейни срещи."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte se ke konferenčnímu hovoru přímo z prohlížeče. Ideální pro pracovní nebo rodinné schůzky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deltag i et telefonmøde direkte fra en browser. Ideel til forretnings- eller familiemøder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treten Sie einem Konferenzanruf direkt über einen Browser bei. Ideal für geschäftliche oder familiäre Besprechungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμμετοχή σε τηλεδιάσκεψη απευθείας από πρόγραμμα περιήγησης. Ιδανικό για επαγγελματικές ή οικογενειακές συναντήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join a conference call directly from a browser. Ideal for business or family meetings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únase a una conferencia telefónica directamente desde un navegador. Ideal para reuniones de negocios o familiares."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستقیماً از طریق مرورگر به یک کنفرانس تلفنی بپیوندید. ایده‌آل برای جلسات کاری یا خانوادگی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liity neuvottelupuheluun suoraan selaimesta. Ihanteellinen liike- tai perhekokouksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoindre une conférence directement depuis un navigateur. Idéal pour les réunions professionnelles ou familiales."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצטרף לשיחת ועידה ישירות מדפדפן. אידיאלי לפגישות עסקיות או משפחתיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीधे ब्राउज़र से कॉन्फ़्रेंस कॉल में शामिल हों। बिज़नेस या फ़ैमिली मीटिंग के लिए बढ़िया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridružite se konferencijskom pozivu izravno iz preglednika. Idealno za poslovne ili obiteljske sastanke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konferenciahíváshoz való csatlakozás közvetlenül böngészőből. Ideális üzleti vagy családi megbeszélésekhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gabung panggilan konferensi langsung dari browser. Ideal untuk rapat bisnis atau keluarga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partecipa a una conference call direttamente da un browser. Ideale per riunioni di lavoro o familiari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザから直接電話会議に参加できます。ビジネスや家族の会議に最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저에서 바로 회의 통화에 참여합니다. 비즈니스 또는 가족 회의에 적합합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bli med i en konferansesamtale direkte fra en nettleser. Ideelt for forretnings- eller familiemøter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem rechtstreeks deel aan een conference call vanuit een browser. Ideaal voor zakelijke of familiebijeenkomsten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołączanie do telekonferencji bezpośrednio z przeglądarki. Idealne rozwiązanie na spotkania biznesowe lub rodzinne. "
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participe numa chamada em conferência diretamente de um browser. Ideal para reuniões de negócios ou familiares."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alăturați-vă unui apel conferință direct din browser. Ideal pentru întâlniri de afaceri sau familiale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присоединяйтесь к конференц-звонку непосредственно из браузера. Идеально подходит для деловых или семейных встреч."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojte sa ku konferenčnému hovoru priamo z prehliadača. Ideálne pre pracovné alebo rodinné stretnutia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridružite se konferenčnemu klicu neposredno iz brskalnika. Idealno za poslovna ali družinska srečanja."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bashkohuni në një thirrje konferencë drejtpërdrejt nga një shfletues. Ideale për takime biznesi ose familjare."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridružite se konferencijskom pozivu direktno iz pregledača. Idealno za poslovne ili porodične sastanke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delta i ett konferenssamtal direkt från en webbläsare. Perfekt för affärs- eller familjemöten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğrudan bir tarayıcıdan konferans görüşmesine katılın. İş veya aile toplantıları için idealdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приєднуйтесь до конференц-дзвінка безпосередньо з браузера. Ідеально підходить для ділових чи сімейних зустрічей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tham gia cuộc gọi hội nghị trực tiếp từ trình duyệt. Lý tưởng cho các cuộc họp kinh doanh hoặc gia đình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接从浏览器加入电话会议。非常适合商务或家庭会议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接從瀏覽器加入電話會議。非常適合商務或家庭會議。"
          }
        }
      }
    },
