    "conversation_view_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير رسائل الدردشة على الهاتف المحمول الخاص بك وأثناء نقلها. لضمان أعلى مستوى من أمان البيانات، يتم إرسالها مباشرةً إلى هاتف%@ باستخدام اتصال نظير إلى نظير بدون خادم وسيط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Чат съобщенията са криптирани на телефона ви и по време на предаването им.          За да се осигури най-високо ниво на сигурност на данните, те се изпращат директно до телефона на %@ чрез peer-to-peer връзка без посреднически сървър."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Zprávy chatu jsou šifrovány ve vašem telefonu i během přenosu.          Aby byla zajištěna nejvyšší úroveň zabezpečení dat, jsou zasílány přímo do telefonu %@ pomocí peer-to-peer připojení bez prostředního serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatbeskederne er krypteret på din mobiltelefon og under deres transmission. For at sikre det højeste niveau af datasikkerhed sendes de direkte til %@s telefon ved at bruge en peer-to-peer-forbindelse uden nogen mellemliggende server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ":lock Die Chatnachrichten werden auf Ihrem Handy und während ihrer Übertragung verschlüsselt. Um ein Höchstmaß an Datensicherheit zu gewährleisten, werden sie über eine Peer-to-Peer-Verbindung ohne zwischengeschalteten Server direkt an das Telefon von %@ gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Τα μηνύματα συνομιλίας κρυπτογραφούνται στο κινητό σας και κατά τη μετάδοσή τους.          Για να διασφαλιστεί το υψηλότερο επίπεδο ασφάλειας δεδομένων, αποστέλλονται απευθείας στο τηλέφωνο του/της %@ χρησιμοποιώντας σύνδεση peer-to-peer χωρίς ενδιάμεσο διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chat messages are encrypted on your cellphone and during their transmission. To ensure the highest level of data security, they are directly sent to %@’s phone by using a peer to peer connection with no intermediary server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes de chat se cifran en tu teléfono móvil y durante su transmisión. Para garantizar el máximo nivel de protección de datos, se envían directamente al teléfono de %@ utilizando una conexión punto a punto sin servidores intermediarios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیامهای چت در تلفن همراه شما و در حین انتقال آنها رمزگذاری میشوند. برای اطمینان از بالاترین سطح امنیت دادهها، آنها به طور مستقیم با استفاده از اتصال همتا به همتا و بدون هیچ سرور واسطی به تلفن %@ ارسال میشوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat-viestit salataan matkapuhelimeesi ja niiden lähetyksen aikana. Tietoturvan korkeimman tason varmistamiseksi ne lähetetään suoraan %@:n puhelimeen käyttämällä vertaisyhteyttä ilman välipalvelinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages de cette discussion sont cryptés sur votre téléphone et lors de leur transmission. Ils sont directement envoyés à %@ sans intermédiaire pour une sécurité maximum."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הודעות הצ'אט מוצפנות בטלפון הנייד שלך ובמהלך העברתן. כדי להבטיח את הרמה הגבוהה ביותר של אבטחת נתונים, הם נשלחים ישירות לטלפון של %@ באמצעות חיבור עמית לעמית ללא שרת מתווך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैट संदेश आपके सेलफोन पर और उनके प्रसारण के दौरान एन्क्रिप्ट किए जाते हैं. डेटा सुरक्षा के उच्चतम स्तर को सुनिश्चित करने के लिए, उन्हें बिना किसी मध्यस्थ सर्वर के सहकर्मी से सहकर्मी कनेक्शन का उपयोग करके सीधे %@ फोन पर भेजा जाता है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Poruke chata šifrirane su na vašem mobitelu i tijekom prijenosa. Kako bi se osigurao najviši stupanj sigurnosti podataka, izravno se šalju na telefon %@ pomoću peer-to-peer veze bez posredničkog poslužitelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock A csevegés üzenetei titkosítva vannak a telefonján és az átvitel során is. A legmagasabb szintű adatbiztonság érdekében közvetlenül a %@ telefonjára küldik őket peer-to-peer kapcsolaton keresztül, köztes szerver nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan obrolan dienkripsi pada ponsel Anda dan selama pesan tersebut dikirim. Untuk memastikan tingkat keamanan data tertinggi, pesan pesan tersebut dikirim langsung ke ponsel %@  dengan menggunakan sambungan peer to peer tanpa server perantara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi di chat vengono crittografati sul tuo cellulare e durante la loro trasmissione. Per garantire il massimo livello di sicurezza dei dati, vengono inviati direttamente al telefono di %@ utilizzando una connessione peer to peer senza server intermedio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットメッセージは、携帯電話との送信中に暗号化されます。最高レベルのデータセキュリティを確保するために、中間サーバーを使用せずにピアツーピア接続を使用して、%@ の電話に直接送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 메시지는 휴대폰과 전송 중에 암호화됩니다. 최고 수준의 데이터 보안을 보장하기 위해 중간 서버없이 P2P 연결을 사용하여 %@의 전화로 직접 전송됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat-meldingene er kryptert på din mobiltelefon og under overføringen. For å sikre det høyeste nivået av datasikkerhet, sendes de direkte til %@s telefon ved å bruke en peer-to-peer-tilkobling uten mellomliggende server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatbeskederne er krypteret på din mobiltelefon og under deres transmission. For at sikre det højeste niveau af datasikkerhed sendes de direkte til %@s telefon ved at bruge en peer-to-peer-forbindelse uden nogen mellemliggende server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomości czatu są szyfrowane na telefonie komórkowym i podczas ich transmisji. Aby zapewnić najwyższy poziom bezpieczeństwa danych, są one przesyłane bezpośrednio do telefonu %@ za pomocą połączenia peer to peer bez serwera pośredniczącego."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens do chat são encriptadas no seu telemóvel e durante a sua transmissão.\nPara assegurar o mais alto nível de segurança de dados, elas são enviadas diretamente para o telefone de %@ usando uma ligação ponto a ponto sem qualquer servidor intermediário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Mesajele de chat sunt criptate pe telefonul dvs. și în timpul transmiterii lor. Pentru a asigura cel mai înalt nivel de securitate a datelor, acestea sunt trimise direct pe telefonul lui %@ folosind o conexiune peer-to-peer fără server intermediar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения чата шифруются на вашем мобильном телефоне и в процессе их передачи.\n Чтобы обеспечить высокий уровень безопасности данных, они непосредственно отправляются на телефон  %@ с использованием peer to peer-подключения к серверу без посредника."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Správy chatu sú šifrované vo vašom telefóne aj počas prenosu. Na zabezpečenie najvyššej úrovne ochrany údajov sa odosielajú priamo na telefón %@ pomocou peer-to-peer spojenia bez sprostredkujúceho servera."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Klepetalna sporočila so šifrirana na vašem telefonu in med njihovim prenosom. Za najvišjo raven varnosti podatkov se pošiljajo neposredno na telefon %@ z uporabo povezave peer-to-peer brez posredniškega strežnika."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ":lock Mesazhet e bisedës janë të enkriptuara në telefonin tuaj dhe gjatë transmetimit të tyre. Për të siguruar nivelin më të lartë të mbrojtjes së të dhënave, ato dërgohen drejtpërdrejt në telefonin e %@ duke përdorur një lidhje peer-to-peer pa server ndërmjetës."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " :lock Poruke razgovora su šifrovane na vašem telefonu i tokom prenosa. Da bi se obezbedio najviši nivo bezbednosti podataka, one se direktno šalju na telefon %@ koristeći peer-to-peer vezu bez posredničkog servera."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chattmeddelandena krypteras på din mobiltelefon och under överföringen. För att säkerställa högsta nivå av datasäkerhet skickas de direkt till %@s telefon genom att använda en peer-to-peer-anslutning utan någon mellanliggande server."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet mesajları cep telefonunuzda ve iletim sırasında şifrelenir. En yüksek düzeyde veri güvenliği sağlamak için, ara sunucu olmadan eşler arası bir bağlantı kullanarak doğrudan %@ kişisinin telefonuna gönderilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомлення чату кодуються на вашому мобільному пристрої  під час їх передачі.\n Щоб забезпечити найвищий рівень безпеки, дані надсилаються безпосередньо на телефон користувача %@ за допомогою однорангового з’єднання без сервера-посередника."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn trò chuyện được mã hóa trên điện thoại của bạn và trong quá trình truyền. Để đảm bảo mức độ bảo mật dữ liệu cao nhất, chúng được gửi trực tiếp đến điện thoại của %@ thông qua kết nối ngang hàng không có máy chủ trung gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊天消息在您的手机内和在传输过程中已被加密。为了确保数据安全性的最高水准，它们以点对点连接、无中间服务器的方式被直接发送到%@的电话上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊天消息在您的手機上和傳輸過程中被加密。為確保最高級別的數據安全，它們通過對等連接直接發送到 %@ 的手機，無需中間服務器。"
          }
        }
      }
    },
