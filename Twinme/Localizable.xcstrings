    "create_external_call_view_onboarding_part_1_message_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح لك ميزة \"Click-to-call\" إمكانية الاتصال بك أو الانضمام إلى مكالمة جماعية (\"Click-to-meet\") من خلال المتصفح دون الحاجة إلى تثبيت التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click‑to‑call позволява на гости да ви се обаждат или да се присъединят към конферентен разговор (Click‑to‑meet) през браузър, без да инсталират приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click‑to‑call umožňuje hostům volat vám nebo se připojit ke konferenčnímu hovoru (Click‑to‑meet) z prohlížeče bez instalace aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click-to-call giver gæster mulighed for at ringe til dig eller deltage i et telefonmøde (\"Click-to-meet\") fra en browser uden at installere appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click-to-Call ermöglicht es Gästen, Sie anzurufen oder einen Konferenzanruf (Click-to-Meet) über einen Browser beizutreten, ohne die App zu installieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το click‑to‑call επιτρέπει σε επισκέπτες να σας καλέσουν ή να συμμετάσχουν σε τηλεδιάσκεψη (click‑to‑meet) από browser χωρίς να εγκαταστήσουν την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click-to-call allows guests to call you or join a conference call (Click-to-meet) from a browser without installing the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La función \"Click-to-call\" permite que sus invitados le llamen o se unan a una conferencia telefónica (\"Click-to-meet\") desde un navegador sin necesidad de instalar la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قابلیت کلیک برای تماس به مهمانان این امکان را می‌دهد که بدون نصب برنامه، از طریق مرورگر با شما تماس بگیرند یا به یک کنفرانس تلفنی (کلیک برای ملاقات) بپیوندند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click-to-call -toiminto antaa vieraille mahdollisuuden soittaa sinulle tai liittyä neuvottelupuheluun (\"Click-to-meet\") selaimesta ilman sovelluksen asentamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Click-to call\" permet aux invités de vous appeler, ou de rejoindre une conférence (\"Click-to-meet\"), depuis un navigateur, sans installer l'application. "
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Click-to-call\" מאפשר לאורחים להתקשר אליך או להצטרף לשיחת ועידה (\"Click-to-meet\") מדפדפן מבלי להתקין את האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Click-to-call\" मेहमानों को ऐप इंस्टॉल किए बिना ब्राउज़र से आपको कॉल करने या कॉन्फ़्रेंस कॉल (\"Click-to-meet\") में शामिल होने की सुविधा देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikni za poziv omogućuje gostima da vas nazovu ili se pridruže konferencijskom pozivu (Klikni za sastanak) iz preglednika bez instaliranja aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Click-to-call lehetővé teszi, hogy vendégek az alkalmazás telepítése nélkül hívjanak fel vagy csatlakozzanak egy konferenciahíváshoz (Click-to-meet) böngészőből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click-to-call memungkinkan tamu untuk menghubungi Anda atau bergabung dalam panggilan konferensi (\"Click-to-meet\") dari browser tanpa menginstal aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Click-to-call\" consente agli ospiti di chiamarti o di partecipare a una conference call (\"Click-to-meet\") da un browser senza installare l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Click-to-call」を使用すると、ゲストはアプリをインストールせずにブラウザから電話をかけたり、電話会議（「Click-to-meet」）に参加したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Click-to-call\" 기능을 사용하면 앱을 설치하지 않은 사용자도 브라우저에서 전화를 걸거나 회의 통화(\"Click-to-meet\")에 참여할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Click-to-call» lar gjester ringe deg eller delta i en konferansesamtale («Click-to-meet») fra en nettleser uten å installere appen."
          }
        },
        "nl" : {
          "stringUnit" : {
