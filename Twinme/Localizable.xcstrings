    "invitation_code_view_create_code_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدعوة جهة اتصال عندما لا تتمكن من الوصول إلى التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "за покана на контакт, когато нямате достъп до приложението."
