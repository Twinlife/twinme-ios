    "feedback_view_info_logs" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي سجل التصحيح فقط على بيانات تقنية منخفضة المستوى حول أنشطة التطبيق وسلوكه، ولا يكشف عن أي من معلوماتك الشخصية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug логът съдържа само технически данни за дейността и поведението на приложението и НЕ разкрива никаква ваша лична информация."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladicí protokol obsahuje pouze nízkoúrovňová technická data o činnosti a chování aplikace, a NEodhaluje žádné vaše osobní informace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fejlretningslog indeholder kun tekniske data på lavt niveau om applikationens aktiviteter og adfærd, og afslører INGEN af dine personlige oplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fehlerprotokoll (Debug Log) enthält ausschließlich technische Daten auf niedriger Ebene über die Aktivitäten und das Verhalten der Anwendung und gibt keinerlei persönliche Informationen von Ihnen preis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα Debug Log περιέχει μόνο τεχνικά δεδομένα χαμηλού επιπέδου σχετικά με τη λειτουργία της εφαρμογής και ΔΕΝ αποκαλύπτει προσωπικές πληροφορίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Debug Log contains only low-level technical data on application activities and behavior, and does NOT reveal any of your personal information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro de depuración contiene solo datos técnicos de bajo nivel sobre las actividades y el comportamiento de la aplicación, y NO revela ninguna de su información personal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log Debug فقط حاوی داده های فنی سطح پایین در مورد فعالیت ها و رفتار برنامه است و هیچ یک از اطلاعات شخصی شما را فاش نمی کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virheenkorjausloki sisältää vain alhaisen tason teknisiä tietoja sovellustoiminta ja käyttäytymisestä, eikä se paljasta MITÄÄN henkilökohtaisia "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un journal de débogage ne contient que des données techniques de bas niveau sur les activités et le comportement de l'application et ne révèle AUCUNE de vos informations personnelles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יומן ניפוי באגים מכיל רק נתונים טכניים ברמה נמוכה על פעילויות והתנהגות יישומים, ואינו חושף אף מידע אישי שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डीबग लॉग में एप्लिकेशन गतिविधियों और व्यवहार पर केवल निम्न-स्तरीय तकनीकी डेटा होता है, और यह आपकी किसी भी व्यक्तिगत जानकारी को प्रकट नहीं करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug zapisnik sadrži samo tehničke podatke niske razine o aktivnostima i ponašanju aplikacije i NE otkriva nikakve vaše osobne podatke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hibakeresési napló csak alacsony szintű technikai adatokat tartalmaz az alkalmazás működéséről, és NEM tartalmaz személyes információkat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug Log hanya berisi data teknis tingkat rendah tentang aktivitas dan perilaku aplikasi, dan TIDAK mengungkapkan informasi pribadi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un debug log contiene solo dati tecnici di basso livello sulle attività e sul comportamento dell'applicazione e NON rivela alcuna informazione personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグ ログには、アプリケーションのアクティビティと動作に関する低レベルの技術データのみが含まれ、個人情報は一切公開されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버그 로그에는 애플리케이션 활동 및 동작에 대한 저수준의 기술 데이터만 포함되며, 개인 정보는 공개되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En feilsøkingslogg inneholder kun tekniske data på lavt nivå om applikasjonsaktiviteter og oppførsel, og avslører IKKE noen av dine personlige opplysninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Debug Log bevat alleen technische gegevens op laag niveau over applicatie-activiteiten en -gedrag, en onthult GEEN persoonlijke informatie van u."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziennik debugowania zawiera wyłącznie podstawowe dane techniczne dotyczące aktywności i zachowania aplikacji i NIE ujawnia żadnych Twoich danych osobowych."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um registo de depuração contém apenas dados técnicos de baixo nível sobre as atividades e o comportamento da aplicação e NÃO revela qualquer informação pessoal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jurnal de depanare conține doar date tehnice de nivel scăzut despre activitățile aplicației și NU dezvăluie informații personale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал отладки содержит только низкоуровневые технические данные о действиях и поведении приложения и НЕ раскрывает никакую вашу личную информацию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladiaci log obsahuje iba nízkoúrovňové technické údaje o činnosti aplikácie a neodhaľuje žiadne vaše osobné informácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnevnik razhroščevanja vsebuje le nizkonivojske tehnične podatke o dejavnostih in vedenju aplikacije ter NE razkriva nobenih vaših osebnih podatkov."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një regjistër debug përmban vetëm të dhëna teknike të nivelit të ulët për aktivitetet dhe sjelljen e aplikacionit, dhe NUK zbulon asnjë nga të dhënat tuaja personale."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug log sadrži samo tehničke podatke niskog nivoa o aktivnostima i ponašanju aplikacije i NE otkriva nikakve vaše lične informacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En felsökningslogg innehåller endast tekniska data på låg nivå om applikationsaktiviteter och beteende och avslöjar INTE någon av dina personliga uppgifter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata Ayıklama Günlüğü yalnızca uygulama etkinlikleri ve davranışları hakkında düşük düzeyde teknik veriler içerir ve kişisel bilgilerinizden hiçbirini ifşa ETMEZ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Журнал налагодження містить лише низькорівневі технічні дані про дії та поведінку програми та НЕ розкриває вашу особисту інформацію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log kỹ thuật chỉ chứa dữ liệu kỹ thuật cấp thấp về hoạt động ứng dụng và KHÔNG tiết lộ thông tin cá nhân của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调试日志仅包含有关应用程序活动和行为的低级技术数据，不会泄露您的任何个人信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵錯日誌僅包含有關應用程式活動和行為的低階技術數據，不會洩露您的任何個人資訊。"
          }
        }
      }
    },
