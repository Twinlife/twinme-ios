    "call_view_tag_add_to_call" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بدعوة جهة اتصال للانضمام إلى المكالمة الجارية"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поканете контакт да се присъедини към текущия разговор"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvat kontakt do probíhajícího hovoru"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviter en kontakt til at deltage i det igangværende opkald"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kontaktperson einladen, dem laufenden Anruf beizutreten"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσκαλέστε μια επαφή να συμμετάσχει στην τρέχουσα κλήση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite a contact to join the ongoing call"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitar a un contacto a unirse a la llamada en curso"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک مخاطب را برای پیوستن به تماس در حال انجام دعوت کنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutsu yhteyshenkilö liittymään meneillään olevaan puheluun"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviter un contact à rejoindre l'appel en cours"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזמן איש קשר להצטרף לשיחה המתמשכת"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चल रही कॉल में शामिल होने के लिए किसी संपर्क को आमंत्रित करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
