    "cleanup_view_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يؤدي حذف الرسائل والوسائط والملفات من هذه المحادثة إلى إزالتها من جهاز جهة الاتصال الخاصة بك ، ولن تتمكن من القيام بذلك لاحقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтриването на съобщения, медии и файлове от този разговор не ги премахва от устройството на вашия контакт и няма да можете да го направите по‑късно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranění zpráv, médií a souborů z této konverzace je neodstraní z zařízení vašeho kontaktu a později to již nepůjde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletning af beskeder, medier og filer fra denne samtale fjerner dem ikke fra din kontakts enhed, og du vil ikke være i stand til det senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen von Nachrichten, Medien und Dateien aus dieser Unterhaltung entfernt sie nicht vom Gerät Ihrer Kontaktperson, und Sie werden dies später nicht mehr tun können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή μηνυμάτων, πολυμέσων και αρχείων από αυτή τη συνομιλία δεν τα αφαιρεί από τη συσκευή της επαφής σας και δεν θα μπορείτε να το κάνετε αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting messages, media, and files from this conversation does not remove them from your contact’s device, and you will not be able to do so later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar mensajes, medios y archivos de esta conversación no los elimina del dispositivo de su contacto, y no podrá hacerlo más tarde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف پیام ها ، رسانه ها و پرونده های این مکالمه آنها را از دستگاه مخاطب شما حذف نمی کند و بعداً نمی توانید این کار را انجام دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viestien, median ja tiedostojen poistaminen tästä keskustelusta ei poista niitä yhteystietosi laitteesta, etkä voi tehdä niin myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression des messages, médias et fichiers de cette conversation ne les supprime pas de l’appareil de votre contact et vous ne pourrez pas le faire plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיקת הודעות, מדיה וקבצים משיחה זו אינה מסלקת אותן מהמכשיר של איש הקשר שלך, ולא תוכל לעשות זאת בהמשך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वार्तालाप से संदेशों, मीडिया और फ़ाइलों को हटाने से वे आपके संपर्क के डिवाइस से नहीं हटते हैं, और आप बाद में ऐसा नहीं कर पाएंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brisanje poruka, medija i datoteka iz ovog razgovora ne uklanja ih s uređaja vašeg kontakta i to kasnije nećete moći učiniti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beszélgetésből törölt üzenetek, média és fájlok nem törlődnek a kapcsolat eszközéről, és később sem lehet őket eltávolítani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus pesan, media, dan file dari percakapan ini tidak akan menghapusnya dari perangkat kontak Anda dan Anda tidak akan dapat melakukannya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione di messaggi, media e file da questa conversazione non li rimuove dal dispositivo del tuo contatto e non sarai in grado di farlo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会話からメッセージ、メディア、およびファイルを削除しても、連絡先のデバイスからそれらを削除することはなく、後でそうすることはできません。"
