    "feedback_view_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقدر مساعدتك في تحديد المشكلات والعمل معنا لحلها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодарим ви за помощта при откриване и разрешаване на проблеми."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vážíme si vaší pomoci při identifikaci problémů a jejich řešení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi sætter pris på din hjælp til at identificere problemer og samarbejde med os for at få dem løst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir schätzen Ihre Hilfe dabei, Probleme zu identifizieren und gemeinsam mit uns an deren Lösung zu arbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτιμούμε τη βοήθειά σας στον εντοπισμό προβλημάτων και τη συνεργασία για την επίλυσή τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We appreciate your help in identifying issues and working with us to get them resolved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agradecemos su ayuda para identificar problemas y trabajar con nosotros para resolverlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از کمک شما در شناسایی مشکلات و همکاری با ما برای حل آنها سپاسگزاریم."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvostamme apuasi ongelmien tunnistamisessa ja kanssamme niiden ratkaisemisessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous apprécions votre aide pour identifier les problèmes et travailler avec nous pour les résoudre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנו מעריכים את עזרתך בזיהוי בעיות ובעבודה איתנו כדי לפתור אותן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्याओं की पहचान करने और उन्हें हल करने के लिए हमारे साथ काम करने में आपकी मदद के लिए हम आपकी सराहना करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cijenimo vašu pomoć u prepoznavanju problema i radu s nama kako bismo ih riješili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köszönjük, hogy segítesz a problémák felismerésében és megoldásában."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami menghargai bantuan Anda dalam mengidentifikasi masalah dan bekerja sama dengan kami untuk menyelesaikannya."
