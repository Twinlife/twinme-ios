        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai abilitato il filtro per i contatti sconosciuti sul tuo dispositivo, le chiamate in arrivo dall'applicazione appariranno nell'elenco \"Chiamanti sconosciuti\"."
