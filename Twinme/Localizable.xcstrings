          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntülü görüşme sırasında kamerasını kontrol etmenize izin vermesi için %@ ile iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть %@ дозволити вам керувати їхньою камерою під час відеодзвінка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu %@ cho phép bạn điều khiển camera của họ trong cuộc gọi video."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求 %@ 允许您在视频通话期间控制他们的摄像头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求 %@ 允許您在視訊通話期間控制他們的攝影機。"
          }
        }
      }
    },
    "call_view_camera_control_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرغب %@ بالتحكم في كاميرتك أثناء المكالمة. يمكنك استعادة التحكم في أي وقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ би искал/а да контролира вашата камера по време на разговора. Можете да възстановите контрола по всяко време."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chce během hovoru ovládat vaši kameru. Ovládání můžete kdykoli převzít zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vil gerne styre dit kamera under opkaldet. Du kan til enhver tid genvinde kontrollen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte Ihre Kamera während des Anrufs steuern. Sie können die Steuerung jederzeit wieder übernehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο/Η %@ θα ήθελε να ελέγξει την κάμερά σας κατά τη διάρκεια της κλήσης. Μπορείτε να ανακτήσετε τον έλεγχο οποτεδήποτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ would like to control your camera during the call. You can regain control at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ desea controlar tu cámara durante la llamada. Puedes recuperar el control en cualquier momento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ می‌خواهد در طول تماس، دوربین شما را کنترل کند. می‌توانید در هر زمانی کنترل را دوباره به دست بگیرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ haluaa hallita kameraasi puhelun aikana. Voit ottaa hallinnan takaisin milloin tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ souhaite contrôler votre caméra pendant l'appel. Vous pouvez reprendre le contrôle à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ רוצה לשלוט במצלמה שלך במהלך השיחה. ניתן להחזיר לעצמך שליטה בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कॉल के दौरान आपके कैमरे को नियंत्रित करना चाहता है। आप किसी भी समय नियंत्रण पुनः प्राप्त कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ želi upravljati vašom kamerom tijekom poziva. Kontrolu možete vratiti u bilo kojem trenutku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ szeretné vezérelni a kamerádat a hívás során. Bármikor visszaveheted az irányítást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ingin mengontrol kamera Anda selama panggilan. Anda dapat mengambil alih kendali kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ desidera controllare la tua videocamera durante la chiamata. Puoi riprendere il controllo in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が通話中にあなたのカメラを操作しようとしています。いつでも操作を取り戻すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님이 통화 중에 카메라를 제어하려고 합니다. 언제든지 다시 제어할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vil kontrollere kameraet ditt under samtalen. Du kan når som helst få tilbake kontrollen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wil je camera tijdens het gesprek bedienen. Je kunt de controle op elk moment terugkrijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chce sterować Twoją kamerą podczas połączenia. Możesz odzyskać kontrolę w dowolnym momencie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gostaria de controlar a sua câmara durante a chamada. Pode retomar o controlo a qualquer momento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dorește să vă controleze camera în timpul apelului. Puteți recăpăta controlul oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ хочет управлять вашей камерой во время разговора. Вы можете восстановить управление в любое время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ by chcel počas hovoru ovládať vašu kameru. Kedykoľvek môžete prevziať kontrolu späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bi rad/-a med klicem nadzoroval/-a vašo kamero. Nadzor lahko kadar koli prevzamete nazaj."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dëshiron të kontrollojë kamerën tuaj gjatë thirrjes. Mund ta rimerrni kontrollin në çdo kohë."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bi želeo/la da kontroliše vašu kameru tokom poziva. U svakom trenutku možete povratiti kontrolu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vill styra din kamera under samtalet. Du kan återfå kontrollen när som helst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, arama sırasında kameranızı kontrol etmek istiyor. Kontrolü istediğiniz zaman geri alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ хоче керувати вашою камерою під час дзвінка. Ви можете відновити контроль у будь-який час."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muốn điều khiển camera của bạn trong cuộc gọi. Bạn có thể lấy lại quyền kiểm soát bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 想在通话期间控制您的摄像头。您可以随时重新获得控制权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 想在通話期間控制您的相機。您可以隨時重新取得控制權。"
          }
        }
      }
    },
