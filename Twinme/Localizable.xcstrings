    "show_call_view_conference_call_information" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك هذا الرابط للاتصال بك أو الانضمام إلى مكالمة جماعية من متصفح."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Споделете този линк, за да ви се обадят или да се присъединят към конференция от браузър."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte tento odkaz, aby vám mohli zavolat nebo se připojit ke konferenci z prohlížeče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del dette link for at ringe til dig eller deltage i en konference fra en browser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen Sie diesen Link, um angerufen zu werden oder einer Konferenz über einen Browser beizutreten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοινοποιήστε αυτόν τον σύνδεσμο για να σας καλέσουν ή να συμμετάσχουν σε τηλεδιάσκεψη από πρόγραμμα περιήγησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share this link to call you or join a conference from a browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte este enlace para llamarte o unirte a una conferencia desde un navegador."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این لینک را برای تماس با شما یا پیوستن به کنفرانس از طریق مرورگر به اشتراک بگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa tämä linkki soittaaksesi sinulle tai liittyäksesi neuvotteluun selaimesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partager ce lien permettant de vous appeler ou de rejoindre une conférence depuis un navigateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתף קישור זה כדי להתקשר אליך או להצטרף לוועידה מדפדפן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राउज़र से आपको कॉल करने या कॉन्फ्रेंस में शामिल होने के लिए यह लिंक शेयर करें।"
