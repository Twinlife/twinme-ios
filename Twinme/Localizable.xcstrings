    "show_group_view_leave_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستغادر هذه المجموعة ولن تتمكن بعد الآن من الوصول إلى محادثاتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще напуснете групата и няма да имате достъп до разговорите й."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opustíte tuto skupinu a již nebudete mít přístup k jejím konverzacím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forlader denne gruppe, og du vil ikke længere kunne få adgang til dens samtaler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden diese Gruppe verlassen und können nicht mehr auf deren Unterhaltungen zugreifen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αποχωρήσετε από αυτή την ομάδα και δεν θα έχετε πλέον πρόσβαση στις συνομιλίες της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will leave this group and you will no longer be able to access its conversations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldrás de este grupo y ya no podrás acceder a sus conversaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما از این گروه خارج خواهید شد و دیگر نمی توانید به مکالمات آن دسترسی داشته باشید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistut tästä ryhmästä etkä voi enää käyttää sen keskusteluja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous allez quitter ce groupe et vous ne pourrez plus accéder à ses conversations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תעזוב את הקבוצה הזו ולא תוכל יותר לגשת לשיחות שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इस समूह को छोड़ देंगे और अब आप इसकी बातचीत तक नहीं पहुँच पाएँगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napustit ćete ovu grupu i više nećete moći pristupiti njezinim razgovorima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
