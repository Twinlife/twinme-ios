    "fatal_error_view_error_code_message" : {
      "comment" : "FatalErrorViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطأ فادح، الكود %d.\nالرجاء إعادة تشغيل التطبيق، والإبلاغ عن المشكلة عبر رسالة ملاحظات، إذا أمكن. نأسف للإزعاج."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фатална грешка, код %d.\\nМоля, рестартирайте приложението и сигнализирайте проблема чрез съобщение за обратна връзка, ако е възможно. Съжаляваме за неудобството."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatální chyba, kód %d.\\nRestartujte prosím aplikaci a pokud můžete, nahlaste problém prostřednictvím zpětné vazby. Omlouváme se za nepříjemnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatal fejl, kode %d.\nGenstart applikationen, og rapporter problemet via en feedbackmeddelelse, hvis du kan. Beklager ulejligheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwerwiegender Fehler, Code %d.\\nBitte starten Sie die Anwendung neu und melden Sie das Problem nach Möglichkeit über eine Feedback-Nachricht. Wir entschuldigen uns für die Unannehmlichkeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μοιραίο σφάλμα, κωδικός %d.\\nΕπανεκκινήστε την εφαρμογή και, αν μπορείτε, αναφέρετε το ζήτημα μέσω μηνύματος σχολίων. Συγγνώμη για την ενόχληση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatal error, code %d.\nPlease restart the application, and report the issue via a feedback message, if you can. Sorry for the inconvenience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error fatal, código %d.\nReinicie la aplicación e informe el problema mediante un mensaje de comentarios, si puede. Lo siento por los inconvenientes ocasionados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطای مرگبار، کد %d.\nلطفاً برنامه را مجدداً راه اندازی کنید و در صورت امکان، مشکل را از طریق یک پیام بازخورد گزارش دهید. با عرض پوزش برای ناراحتی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vakava virhe, koodi %d.\nKäynnistä sovellus uudelleen ja ilmoita ongelmasta palauteviestillä, jos voit. Anteeksi häiriö."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur fatale, code %d.\nVeuillez redémarrer l'application et signaler le problème via un message de commentaires, si vous le pouvez. Désolé pour le désagrément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שגיאה חמורה, קוד %d.\nאנא הפעל מחדש את היישום ודווח על הבעיה באמצעות הודעת משוב, אם אתה יכול. מצטער על אי הנוחות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घातक त्रुटि, कोड %d।\nकृपया एप्लिकेशन को पुनरारंभ करें, और यदि आप कर सकते हैं तो फीडबैक संदेश के माध्यम से समस्या की रिपोर्ट करें। असुविधा के लिए खेद है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritična pogreška, kôd %d.\\nPonovno pokrenite aplikaciju i, ako možete, prijavite problem putem poruke za povratne informacije. Ispričavamo se zbog neugodnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Végzetes hiba, kód: %d.\\nIndítsd újra az alkalmazást, és ha tudod, jelentsd a problémát visszajelzés formájában. Elnézést a kellemetlenségért."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan fatal, kode %d.\nSilakan mulai ulang aplikasi, dan laporkan masalahnya melalui pesan masukan, jika Anda bisa. Maaf untuk ketidaknyamanannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Errore irreversibile, codice %d.\nRiavvia l'applicazione e segnala il problema tramite un messaggio di feedback, se possibile. Ci dispiace per l'inconvenienza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "致命的なエラー、コード %d。\nアプリケーションを再起動し、フィードバック メッセージを通じて問題を報告してください、可能であれば。 ご不便をおかけして申し訳ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "치명적인 오류, 코드 %d.\n애플리케이션을 다시 시작하고 피드백 메시지를 통해 문제를 보고해 주세요가능하다면. 불편을 드려 죄송합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatal feil, kode %d.\nStart applikasjonen på nytt og rapporter problemet via en tilbakemeldingsmelding, hvis du kan. Beklager bryet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatale fout, code %d.\nStart de applicatie opnieuw op en rapporteer het probleem, indien mogelijk, via een feedbackbericht. Sorry voor het ongemak"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błąd krytyczny, kod %d.\nUruchom ponownie aplikację i, jeśli to możliwe, zgłoś problem za feedback wiadomości zwrotnej. Przepraszam za niedogodności."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erro fatal, código %d.\nReinicie o aplicativo e relate o problema por meio de uma mensagem de feedback, se possível. Desculpe pela inconveniência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eroare fatală, cod %d.\\nReporniți aplicația și raportați problema printr-un mesaj de feedback, dacă puteți. Ne cerem scuze pentru neplăceri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неустранимая ошибка, код %d.\nПожалуйста, перезапустите приложение и сообщите о проблеме через сообщение обратной связи, если можете. Приносим извинения за неудобства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatálna chyba, kód %d.\\nReštartujte aplikáciu a ak môžete, nahláste problém spätnou väzbou. Ospravedlňujeme sa za nepríjemnosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usodna napaka, koda %d.\\nProsimo, znova zaženite aplikacijo in, če lahko, prijavite težavo prek povratnega sporočila. Oprostite za nevšečnosti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gabim fatal, kodi %d.\\nJu lutemi rinisni aplikacionin dhe raportoni problemin përmes një mesazhi feedback, nëse mundeni. Na vjen keq për shqetësimin."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatalna greška, kod %d.\\nMolimo ponovo pokrenite aplikaciju i prijavite problem putem poruke za povratne informacije, ako možete. Izvinjavamo se zbog neprijatnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allvarligt fel, kod %d.\nStarta om programmet och rapportera problemet via ett feedbackmeddelande om du kan. Ursäkta besväret."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önemli hata, kod %d.\nLütfen uygulamayı yeniden başlatın ve mümkünse sorunu bir geri bildirim mesajıyla bildirin. Rahatsızlıktan dolayı özür dileriz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Критична помилка, код %d.\nБудь ласка, перезапустіть програму та повідомте про проблему за допомогою повідомлення зворотного зв’язку, якщо це можливо. Вибачте за незручності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lỗi nghiêm trọng, mã lỗi %d.\nVui lòng khởi động lại ứng dụng và gửi phản hồi nếu có thể. Xin lỗi vì sự bất tiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "致命错误，代码 %d。\n请重新启动应用程序，并通过反馈消息报告问题,如果可以的话。 抱歉给你带来不便。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "致命錯誤，代碼 %d。\n請重新啟動應用程序，並透過回饋訊息報告問題,如果可以的話。 抱歉給你帶來不便。"
          }
        }
      }
    },
