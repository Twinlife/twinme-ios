    "enter_invitation_code_view_certified_message" : {
      "comment" : "EnterInvitationCodeViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إنشاء العلاقة، يُنصح بشدة بتأكيده لتعزيز أمانها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След като връзката бъде създадена, силно се препоръчва да я сертифицирате за по-добра сигурност."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakmile je vztah vytvořen, doporučuje se jej certifikovat pro zvýšení bezpečnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når relationen er oprettet, anbefales det kraftigt at certificere den for at styrke dens sikkerhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald die Verbindung erstellt wurde, wird dringend empfohlen, diese zu zertifizieren, um deren Sicherheit zu erhöhen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφού δημιουργηθεί η σχέση, συνιστάται έντονα να την πιστοποιήσετε για ενίσχυση της ασφάλειας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once the relation has been created, it is strongly recommended to certify it to reinforce its security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez creada la relación, se recomienda certificarla para reforzar su seguridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از ایجاد رابطه، اکیداً توصیه می شود برای تقویت امنیت آن را تأیید کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suhde on luotu, on erittäin suositeltavaa sertifioida se turvallisuuden vahvistamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois la relation créée, il est fortement recommandé de la certifier pour renforcer sa sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר יצירת הקשר, מומלץ מאוד לאשר אותו כדי לחזק את האבטחה שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार संबंध बन जाने के बाद, इसकी सुरक्षा को सुदृढ़ करने के लिए इसे प्रमाणित करने की दृढ़ता से अनुशंसा की जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon stvaranja odnosa snažno se preporučuje potvrditi ga kako bi se pojačala sigurnost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolat létrehozása után erősen javasolt annak hitelesítése a biztonság növelése érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah hubungan tercipta, sangat disarankan untuk mensertifikasinya guna memperkuat keamanannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta creata la relazione, si consiglia vivamente di certificarla per rafforzarne la sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係を作成したら、セキュリティ強化のため認証することを強くお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관계가 생성되면 보안 강화를 위해 인증하는 것이 좋습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når relasjonen er opprettet, anbefales det sterkt å sertifisere den for å styrke sikkerheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat de relatie is aangemaakt, is het sterk aan te raden deze te certificeren om de veiligheid te vergroten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po utworzeniu relacji zdecydowanie zaleca się jej certyfikację w celu wzmocnienia jej bezpieczeństwa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após a criação da relação, é altamente recomendável certificá-la para reforçar a sua segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După crearea relației, este recomandat să o certificați pentru a-i crește securitatea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После создания связи настоятельно рекомендуется сертифицировать ее для усиления ее безопасности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po vytvorení vzťahu sa odporúča jeho certifikácia pre posilnenie bezpečnosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je odnos ustvarjen, je močno priporočljivo, da ga certificirate in s tem okrepite njegovo varnost."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasi të jetë krijuar marrëdhënia, rekomandohet fuqimisht ta certifikoni atë për të rritur sigurinë."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada se odnos kreira, snažno se preporučuje da ga sertifikujete kako biste pojačali njegovu bezbednost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När relationen väl har skapats rekommenderas det starkt att certifiera den för att stärka dess säkerhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlişki oluşturulduktan sonra, güvenliğini güçlendirmek için bunu onaylamanız şiddetle önerilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після створення зв’язку настійно рекомендується сертифікувати його, щоб посилити його безпеку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi tạo mối quan hệ, nên xác thực nó để tăng cường bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立联系后，强烈建议您验证该 PIN 码以增强其安全性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立聯繫後，強烈建議您驗證該 PIN 碼以增強其安全性。"
          }
        }
      }
    },
