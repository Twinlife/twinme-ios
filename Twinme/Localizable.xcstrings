        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izmenično črkujte besedo, prikazano na zaslonu, ki jo lahko drugi preveri. Ko so vse besede preverjene, bo vaš odnos z %@ certificiran."
