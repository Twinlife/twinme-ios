          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La deltakerne invitere andre deltakere som personlige kontakter"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta deelnemers toe hun contacten uit te nodigen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwalaj uczestnikom na zapraszanie innych uczestników jako kontaktów osobistych"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
