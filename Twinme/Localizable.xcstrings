          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolat meghívása a folyamatban lévő híváshoz"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
