    "settings_space_view_secret_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تظهر Space سرية في قائمة Space. لا يمكن الوصول إليه إلا عن طريق كتابة اسمه الدقيق في شريط البحث. لا يمكن استرجاع اسمه ، فلا تنساه!"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайният Space не се появява в списъка със Spaces. Достъп до него може да се получи само чрез въвеждане на точното му име в лентата за търсене. Името му не може да бъде извлечено, така че не го забравяйте!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajný Prostor se v seznamu Prostorů nezobrazuje. Lze k němu přistoupit pouze zadáním přesného názvu do vyhledávacího pole. Jeho název nelze zjistit, proto na něj nezapomeňte!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hemmelig Space vises ikke på listen over Space. Det kan kun fås adgang til det ved at indtaste det nøjagtige navn i søgefeltet. Dets navn kan ikke hentes, så glem ikke det!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein geheimes Space erscheint nicht in der Liste der Space. Sie können nur darauf zugreifen, indem Sie den genauen Namen in die Suchleiste eingeben. Der Name kann nicht abgerufen werden, vergessen Sie ihn also nicht!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας μυστικός Χώρος δεν εμφανίζεται στη λίστα των Χώρων. Μπορεί να προσπελαστεί μόνο πληκτρολογώντας το ακριβές όνομά του στη γραμμή αναζήτησης. Το όνομά του δεν μπορεί να ανακτηθεί, οπότε μην το ξεχάσετε!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A secret Space does not appear in the list of Space. It can only be accessed by typing its exact name in the search bar. Its name cannot be retrieved, so don’t forget it!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Space secreto no aparece en la lista de Space. Solo se puede acceder escribiendo su nombre exacto en la barra de búsqueda. Su nombre no se puede recuperar, ¡así que no lo olvides!"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceیی مخفی در لیست Space ظاهر نمی شود. فقط با تایپ نام دقیق آن در نوار جستجو ، می توان به آن دسترسی داشت. نام آن قابل بازیابی نیست ، بنابراین فراموش نکنید!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salainen Space ei näy Space -luettelossa. Siihen pääsee vain kirjoittamalla tarkka nimi hakupalkkiin. Sen nimeä ei voida hakea, joten älä unohda sitä!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Space secret n’apparait pas dans la liste des Space. Il ne peut être accédé qu’en tapant son nom exact dans la barre de recherche. Son nom ne peut pas être retrouvé, donc ne l’oubliez pas !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space סודי לא מופיע ברשימת Space. ניתן להשיג גישה אליו רק על ידי הזנת שמו המדויק בתיבת החיפוש לא ניתן לאחזר את שמו, אז אל תשכח/י אותו!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक गुप्त Space Space की सूची में प्रकट नहीं होता है। इसे केवल खोज बार में इसका सटीक नाम लिखकर एक्सेस किया जा सकता है। इसका नाम पुनर्प्राप्त नहीं किया जा सकता है, इसलिए इसे न भूलें!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajni Prostor ne prikazuje se na popisu Prostora. Može mu se pristupiti samo upisivanjem točnog naziva u traku za pretraživanje. Njegov naziv nije moguće dohvatiti, pa ga ne zaboravite!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy titkos Space nem jelenik meg a Space-ek listájában. Csak úgy érhető el, ha a keresősávba pontosan beírja a nevét. A neve nem állítható vissza, ezért ne felejtse el!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space rahasia tidak muncul pada daftar Space. Space tersebut hanya dapat diakses dengan mengetikkan nama persisnya pada bilah pencarian. Namanya tidak dapat diambil kembali, jadi jangan sampai lupa!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno Space segreto non appare nell’elenco di Space. È possibile accedervi solo digitandone il nome esatto nella barra di ricerca. Il suo nome non può essere recuperato, quindi non dimenticarlo!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットSkredboardはSkredboardのリストに表示されません。検索バーに正確な名前を入力することによってのみアクセスできます。その名前は取得できないので、忘れないでください！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀 Skredboard은 Skredboard목록에 나타나지 않습니다. 검색 창에 정확한 이름을 입력해야만 액세스 할 수 있습니다. 이름을 검색 할 수 없으므로 잊지 마십시오!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hemmelig Space vises ikke på listen over Space. Det er bare tilgang til det ved å skrive det eksakte navnet i søkefeltet. Navnet kan ikke hentes, så ikke glem det!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een geheime Space komt niet voor in de lijst van Space. Het is alleen toegankelijk door de exacte naam in de zoekbalk te typen. De naam kan niet worden opgehaald, dus vergeet het niet!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekretna Space nie pojawia się na liście Space. Dostęp do niego można uzyskać tylko poprzez wpisanie jego dokładnej nazwy w pasku wyszukiwania. Jego nazwy nie można pobrać, więc nie zapomnij o niej!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Space secreto não aparece na lista de Space. Ele só pode ser acessado digitando seu nome exato na barra de pesquisa. Seu nome não pode ser recuperado, então não esqueça!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Space secret nu apare în lista de Space-uri. Poate fi accesat doar tastând numele exact în bara de căutare. Numele său nu poate fi recuperat, așa că nu-l uitați!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретный Space не появляется в списке Space. Доступ к нему можно получить, введя его точное имя в строке поиска. Его имя не может быть восстановлено, поэтому не забывайте об этом!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajný Priestor sa nezobrazuje v zozname Priestorov. Dá sa k nemu pristúpiť iba zadaním presného názvu do vyhľadávacieho poľa. Jeho názov nie je možné získať, takže naň nezabudnite!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivni Prostor se ne prikaže na seznamu Prostorov. Dostopen je le z vnosom natančnega imena v iskalno vrstico. Njegovega imena ni mogoče pridobiti, zato ga ne pozabite!"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një Space sekret nuk shfaqet në listën e Space-ve. Mund të aksesohet vetëm duke shtypur emrin e saktë në shiritin e kërkimit. Emri i tij nuk mund të rikuperohet, prandaj mos e harroni!"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajni Space se ne pojavljuje na listi Space-ova. Može mu se pristupiti samo upisivanjem tačnog naziva u polje za pretragu. Njegovo ime ne može da se povrati, zato ga nemojte zaboraviti!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hemlig Space visas inte i listan över Space. Det går bara åt genom att skriva det exakta namnet i sökfältet. Namnet kan inte hämtas, så glöm inte det!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaces listesinde gizli bir Space görünmez. Yalnızca arama çubuğuna tam adı yazarak erişilebilir. Adı alınamıyor, bu yüzden unutmayın!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретний Space не відображається в списку Space. Доступ до нього можна отримати, лише ввівши його точну назву в рядку пошуку. Його назву неможливо відновити, тому не забувайте!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gian bí mật không hiển thị trong danh sách và chỉ truy cập được bằng cách nhập đúng tên. Tên này không thể khôi phục, vì vậy đừng quên!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机密Space不会出现在Spaces列表中。只能通过在搜索栏中键入其确切名称来访问它。无法检索其名称，所以请不要忘记它！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機密Space不會出現在Space列表中。只能通過在搜索欄中鍵入其確切名稱來訪問它。無法檢索其名稱，所以請不要忘記它！"
          }
        }
      }
    },
