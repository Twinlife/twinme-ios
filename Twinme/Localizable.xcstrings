        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav ordet som vises på skjermen, slik at den andre kan bekrefte det. Når alle ordene er bekreftet, vil relasjonen din med %@ være sertifisert."
          }
