        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به محض اینکه اولین شرکت کننده به کنفرانس ملحق شد، مطلع شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen heti, kun ensimmäinen osallistuja liittyy neuvotteluun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être notifié dès que le premier participant rejoint la conférence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קבל הודעה ברגע שהמשתתף הראשון מצטרף לוועידה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसे ही पहला पार्टिसिपेंट कॉन्फ्रेंस में शामिल होगा, आपको नोटिफ़िकेशन मिलेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijesti me čim se prvi sudionik pridruži konferenciji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Értesítést kapsz, amint az első résztvevő csatlakozik a konferenciához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
