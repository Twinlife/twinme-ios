    "export_view_select_content" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد المحتويات التي تريد تصديرها.\nيمكن فقط تصدير المحتويات غير المؤقتة ، المصرح بنسخها / حفظها / مشاركتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете съдържанието, което искате да експортирате.\\nМогат да се експортират само неефимерни съдържания, разрешени за копиране/запазване/споделяне."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte obsah, který chcete exportovat.\\nExportovat lze pouze ne‑efemérní obsah, povolený ke kopírování/ukládání/sdílení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg det indhold, du vil eksportere.\nKun ikke-efemært indhold, der er autoriseret til at blive kopieret/gemt/delt, må eksporteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Inhalte aus, die Sie exportieren möchten.\\nNur NICHT-selbstlöschende Inhalte, deren Kopieren/Speichern/Teilen autorisiert ist, können exportiert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τα περιεχόμενα που θέλετε να εξαγάγετε.\\nΜόνο μη εφήμερα περιεχόμενα, επιτρεπόμενα για αντιγραφή/αποθήκευση/κοινοποίηση, μπορούν να εξαχθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the contents you want to export.\nOnly non-ephemeral contents, authorized to be copied/saved/shared, may be exported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione los contenidos que desea exportar.\nSolo se pueden exportar contenidos no efímeros, autorizados para ser copiados/guardados/compartidos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتویاتی را که می خواهید صادر کنید انتخاب کنید.\nفقط محتویات غیر زودگذر که مجاز به کپی/ذخیره/اشتراک گذاری هستند، می توانند صادر شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse sisältö, jonka haluat viedä.\nVain ei-lyhytaikainen sisältö, jonka kopiointi/tallennukset/jakaminen on sallittua, voidaan viedä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez les contenus que vous souhaitez exporter.\nSeuls les contenus non éphémères, autorisés à être copiés/sauvegardés/partagés, peuvent être exportés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר את התוכן שברצונך לייצא.\nמותר לייצא רק תוכן שאינו חולף, המאושר להעתקה/שמירה/שיתוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह सामग्री चुनें जिसे आप निर्यात करना चाहते हैं।\nHanya konten non-efemeral, diizinkan untuk disalin/disimpan/dibagikan, yang dapat diekspor."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite sadržaje koje želite izvesti.\\nMogu se izvesti samo ne-efemerni sadržaji, za koje je dopušteno kopiranje/spremanje/dijeljenje."
