    "show_space_view_move_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون لديك عدة مسافات لنقل جهات الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трябва да имате няколко Spaces, за да местите контакти."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musíte mít více Prostorů, abyste mohli přesouvat kontakty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal have mange Spaces for at flytte kontakter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie müssen mehrere Spaces haben, um Kontakte zu verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρέπει να έχετε πολλούς Χώρους για να μετακινήσετε επαφές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must have multiple Spaces to move contacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debes tener múltiples \"Espacios\" para mover contactos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای جابجایی مخاطبین باید چندین \"فضا\" داشته باشید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla on oltava useita Spaces yhteystietojen siirtämistä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devez avoir plusieurs « Spaces » pour déplacer des contacts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עליך להיות בעל מספר רווחים כדי להעביר אנשי קשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संपर्कों को स्थानांतरित करने के लिए आपके पास एकाधिक \"रिक्त स्थान\" होने चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morate imati više Prostora da biste premjestili kontakte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A névjegyek áthelyezéséhez több Space-re van szükség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda harus memiliki beberapa \"Spasi\" untuk memindahkan kontak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devi avere più \"Spaces\" per spostare i contatti."
          }
        },
        "ja" : {
          "stringUnit" : {
