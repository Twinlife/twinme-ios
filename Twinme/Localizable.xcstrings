        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los minicódigos son de un solo uso y tienen una validez de 24 horas. Puedes dárselos a tus contactos para crear una relación cuando no tengas acceso a la aplicación (por ejemplo, sin teléfono)."
          }
        },
        "fa" : {
          "stringUnit" : {
