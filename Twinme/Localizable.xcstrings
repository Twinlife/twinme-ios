    "application_error_no_storage_space_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق التطبيق، وأفرغ مساحة على جهازك، ثم أعد تشغيله."
