        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du raderar ett Space tas alla kontakter, grupper och konversationer bort från det Space. Är du säker på att du vill ta bort detta Space?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space silindiğinde, bu Space tan tüm kişiler, gruplar ve ileti dizileri kaldırılır. Bu Space silmek istediğinizden emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалення Space видаляє всі контакти, групи та бесіди з цього Space. Ви впевнені, що хочете видалити цей Space?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa Không gian sẽ xóa toàn bộ liên hệ, nhóm và cuộc trò chuyện trong Không gian đó. Bạn có chắc muốn tiếp tục?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除Skredboard会从该Skredboard中删除所有联系人，群组和对话。 确定要删除此Skredboard吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除Skredboard會從該Skredboard中刪除所有聯繫人，群組和對話。 確定要刪除此Skredboard嗎？"
          }
        }
      }
    },
