        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaboravila sam svoje baletne cipele… Možeš li mi ih donijeti, molim te?😘"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elfelejtettem a balettcipőmet… El tudnád hozni, kérlek?😘"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya lupa sepatu balet saya ... Bisakah Anda membawanya? 😘"
