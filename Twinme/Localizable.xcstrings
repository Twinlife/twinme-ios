    "add_contact_view_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من جهة الاتصال الخاصة بك مسح رمز QR الخاص بدعوتك باستخدام Skred، أو اضغط على زر \"Scan\" لمسح رمز جهة الاتصال الخاصة بك ضوئيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помолете вашия приятел близо до вас да сканира вашия QR-код за покана с Skred или натиснете бутона „Сканиране“, за да сканирате кода на вашия приятел."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte svého přítele poblíž vás, aby naskenoval váš pozvánkový QR kód pomocí Skred, nebo klepněte na „Skenovat“ a naskenujte jeho kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed din kontaktperson om at scanne QR-koden til din invitation med Skred, eller tryk på knappen \"Scan\" for at scanne din kontaktpersons kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitten Sie Ihre befreundete Person in Ihrer Nähe, Ihren Einladungs-QR-Code mit Skred zu scannen, oder tippen Sie auf die Schaltfläche „Scannen“, um den Code Ihrer befreundeten Person zu scannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον φίλο σας κοντά σας να σαρώσει τον δικό σας QR‑κώδικα πρόσκλησης με το Skred, ή πατήστε το κουμπί «Σάρωση» για να σαρώσετε τον δικό του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask your contact to scan the QR code of your invitation with Skred, or tap the “Scan” button to scan your contact’s code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídale a su contacto que escanee el código QR de su invitación con Skred, o toque el botón \"Escanear\" para escanear el código de su contacto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از مخاطب خود بخواهید که کد QR دعوتنامه شما را با Skred اسکن کند یا روی دکمه «اسکن» ضربه بزنید تا کد مخاطب شما اسکن شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä yhteyshenkilöäsi skannaamaan kutsusi QR-koodi Skredillä tai napauttamalla \"Skannaa\" -painiketta skannataksesi yhteystietosi koodin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à votre contact de scanner le code QR de votre invitation avec Skred, ou appuyez sur le bouton « Scanner » pour scanner le code de votre contact."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקש מאיש הקשר שלך לסרוק את קוד ה-QR של ההזמנה שלך עם \"Skred\", או הקש על כפתור \"סריקה\" כדי לסרוק את הקוד של איש הקשר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने संपर्क को अपने निमंत्रण के क्यूआर कोड को \"Skred\" से स्कैन करने के लिए कहें, या अपने संपर्क के कोड को स्कैन करने के लिए \"स्कैन\" बटन पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite prijatelja u svojoj blizini da skenira vaš pozivni QR-kôd pomoću Skred ili dodirnite gumb \"Skeniraj\" kako biste skenirali kôd svog prijatelja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérd meg a közeledben lévő barátodat, hogy olvassa be a meghívó QR-kódodat a Skred segítségével, vagy koppints a „Beolvasás” gombra a barátod kódjának beolvasásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta kontak Anda untuk memindai kode QR undangan Anda dengan Skred, atau ketuk tombol \"Pindai\" untuk memindai kode kontak Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi al tuo contatto di scansionare il codice QR del tuo invito con Skred oppure tocca il pulsante \"Scansiona\" per scansionare il codice del tuo contatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skredを使用して招待状の QR コードをスキャンするように連絡先に依頼するか、「スキャン」ボタンをタップして連絡先のコードをスキャンします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처에 Skred로 초대장의 QR 코드를 스캔하도록 요청하거나 \"스캔\" 버튼을 눌러 연락처의 코드를 스캔하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be kontakten din om å skanne QR-koden til invitasjonen din med Skred, eller trykk på \"Skann\"-knappen for å skanne kontaktens kode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag uw contactpersoon om de QR-code van uw uitnodiging te scannen met Skred, of tik op de knop “Scannen” om de code van uw contactpersoon te scannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś kontakt o zeskanowanie kodu QR zaproszenia za pomocą Skred lub naciśnij przycisk „Skanuj”, aby zeskanować kod kontaktu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao seu contato para escanear o código QR do seu convite com Skred ou toque no botão “Scan” para escanear o código do seu contato."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugați prietenul de lângă dvs. să scaneze codul dvs. QR de invitație cu Skred sau apăsați butonul „Scanare” pentru a scana codul prietenului dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите своего контакта отсканировать QR-код вашего приглашения с помощью Skred или нажмите кнопку «Сканировать», чтобы отсканировать код вашего контакта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte svojho priateľa v blízkosti, aby naskenoval váš pozývací QR‑kód pomocou Skred, alebo klepnite na tlačidlo „Skenovať“ a naskenujte kód vášho priateľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosite prijatelja v svoji bližini, naj s Skred skenira vašo QR-kodo povabila, ali tapnite gumb »Skeniraj«, da skenirate kodo svojega prijatelja."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkojini mikut tuaj pranë jush të skanojë QR-kodin tuaj të ftesës me skred, ose prekni butonin \\\"Skanim\\\" për të skanuar kodin e mikut tuaj."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite prijatelja u vašoj blizini da skenira vaš pozivni QR-kod pomoću Skred, ili dodirnite dugme \"Skeniraj\" da skenirate kod prijatelja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be din kontakt att skanna QR-koden för din inbjudan med Skred, eller tryck på knappen \"Skanna\" för att skanna din kontakts kod."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişinizden davetiyenizin QR kodunu Skred ile taramasını isteyin veya kişinizin kodunu taramak için \"Tara\" düğmesine dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть свого контакта відсканувати QR-код вашого запрошення за допомогою Skred або натисніть кнопку «Сканувати», щоб відсканувати код вашого контакту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu bạn bè gần bạn quét mã QR mời của bạn bằng Skred, hoặc nhấn nút \"Quét\" để quét mã của bạn bè."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请您的联系人使用 Skred 扫描邀请函的二维码，或点击“扫描”按钮扫描您联系人的代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
