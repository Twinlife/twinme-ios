    "in_app_subscription_view_accept_invitation" : {
      "comment" : "InAppSubscriptionViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعوك %@ للاستمتاع بالخدمات المتميزة التي يدعمها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ви кани да се възползвате от премиум услугите, които поддържа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vás zve, abyste využili prémiové služby, které podporuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ inviterer dig til at nyde premium-tjenester, som den understøtter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lädt Sie ein, Premium-Dienste zu genießen, die es unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ σας προσκαλεί να απολαύσετε τις premium υπηρεσίες που υποστηρίζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ invites you to enjoy premium services, which it supports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lo invita a disfrutar de los servicios premium que admite."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ از شما دعوت می کند از خدمات ممتازی که پشتیبانی می کند لذت ببرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kutsuu sinut nauttimaan premium-palveluista, joita se tukee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vous invite à profiter de services premium, qu’il prend en charge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ מזמין אותך ליהנות משירותי פרימיום, שבהם הוא תומך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपको प्रीमियम सेवाओं का आनंद लेने के लिए आमंत्रित करता है, जिसका वह समर्थन करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vas poziva da uživate u premium uslugama koje podržava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ meghívja Önt, hogy élvezze az általa támogatott prémium szolgáltatásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mengundang Anda untuk menikmati layanan premium, yang didukungnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ti invita a usufruire dei servizi premium, che supporta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、それがサポートするプレミアム サービスを楽しむようにあなたを招待します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 지원하는 프리미엄 서비스를 즐기도록 초대합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ inviterer deg til å nyte premium-tjenester, som den støtter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nodigt u uit om te genieten van premium services, die het ondersteunt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zaprasza do korzystania z usług premium, które obsługuje."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ convida você a desfrutar de serviços premium, aos quais oferece suporte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vă invită să beneficiați de serviciile premium pe care le susține."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ приглашает вас воспользоваться услугами премиум-класса, которые он поддерживает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vás pozýva využívať prémiové služby, ktoré podporuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vas vabi, da uživate v premium storitvah, ki jih podpira."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ju fton të përfitoni nga shërbimet premium që ai mbështet."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vas poziva da uživate u premium uslugama koje podržava."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ inbjuder dig att njuta av premiumtjänster som den stöder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sizi desteklediği premium hizmetlerin keyfini çıkarmaya davet ediyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ запрошує вас користуватися послугами преміум-класу, які він підтримує."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mời bạn sử dụng dịch vụ cao cấp mà họ đang hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 邀请您享受它支持的高级服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 邀請您享受它支持的高級服務。"
          }
        }
      }
    },
