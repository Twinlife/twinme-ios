    "authentified_relation_view_onboarding_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تضمن العلاقة \"المعتمدة\" أنك تتواصل دائمًا مع الشخص المناسب، حتى إذا تم اختراق الخدمة بواسطة جهة خارجية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Сертифицирана“ връзка гарантира, че винаги комуникирате с правилния човек, дори ако услугата е компрометирана от трета страна."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Certifikovaný“ vztah zajišťuje, že vždy komunikujete se správnou osobou, i kdyby byla služba kompromitována třetí stranou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En \"certificeret\" relation sikrer, at du altid kommunikerer med den rigtige person, selvom tjenesten er blevet kompromitteret af en tredjepart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine „zertifizierte“ Verbindung stellt sicher, dass Sie immer mit der richtigen Person kommunizieren, selbst wenn der Dienst durch Dritte kompromittiert wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια «πιστοποιημένη» σχέση εξασφαλίζει ότι επικοινωνείτε πάντα με το σωστό άτομο, ακόμη και αν η υπηρεσία έχει παραβιαστεί από τρίτο μέρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A \"certified\" relation ensures that you are always communicating with the right person, even if the service has been compromised by a third party."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una relación \"certificada\" garantiza que siempre te estás comunicando con la persona correcta, incluso si el servicio ha sido comprometido por un tercero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک رابطه \"تأیید شده\" تضمین می کند که شما همیشه با شخص مناسب در ارتباط هستید، حتی اگر این سرویس توسط شخص ثالث به خطر افتاده باشد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sertifioitu suhde varmistaa, että kommunikoit aina oikean henkilön kanssa, vaikka palvelu olisi vaarantunut kolmannen osapuolen toimesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une relation « certifiée » vous assure de toujours communiquer avec la bonne personne, même si le service a été compromis par un tiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קשר \"מוסמך\" מבטיח שאתה תמיד מתקשר עם האדם המתאים, גם אם השירות נפגע על ידי צד שלישי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक \"प्रमाणित\" संबंध यह सुनिश्चित करता है कि आप हमेशा सही व्यक्ति के साथ संवाद कर रहे हैं, भले ही सेवा किसी तीसरे पक्ष द्वारा समझौता की गई हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Potvrđeni” odnos osigurava da uvijek komunicirate s pravom osobom, čak i ako je usluga kompromitirana od strane treće strane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „hitelesített” kapcsolat biztosítja, hogy mindig a megfelelő személlyel kommunikálj, még akkor is, ha a szolgáltatást illetéktelen fél kompromittálta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relasi yang \"tersertifikasi\" memastikan bahwa Anda selalu berkomunikasi dengan orang yang tepat, bahkan jika layanan telah disusupi oleh pihak ketiga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una relazione \"certificata\" assicura che stai sempre comunicando con la persona giusta, anche se il servizio è stato compromesso da una terza parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「認証された」関係は、第三者がサービスを損なっても、常に正しい人と通信していることを保証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증된 관계는 제3자가 서비스를 손상시켰더라도 항상 올바른 사람과 소통하고 있음을 보장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En \"sertifisert\" relasjon sikrer at du alltid kommuniserer med rett person, selv om tjenesten har blitt kompromittert av en tredjepart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een \"gecertificeerde\" relatie zorgt ervoor dat u altijd met de juiste persoon communiceert, zelfs als de service is gecompromitteerd door een derde partij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Certyfikowana” relacja zapewnia, że "
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma relação “certificada” garante que está sempre a comunicar com a pessoa certa, mesmo que o serviço tenha sido comprometido por terceiros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relație „certificată” garantează că comunicați întotdeauna cu persoana potrivită, chiar dacă serviciul ar fi compromis de o terță parte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сертифицированное» отношение гарантирует, что вы всегда общаетесь с нужным человеком, даже если сервис был скомпрометирован третьей стороной."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Certifikovaný“ vzťah zaručuje, že vždy komunikujete so správnou osobou, aj keď by bola služba kompromitovaná treťou stranou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Certificiran« odnos zagotavlja, da vedno komunicirate s pravo osebo, tudi če je bila storitev kompromitirana s strani tretje osebe."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një marrëdhënie \\\"e certifikuar\\\" siguron që ju gjithmonë po komunikoni me personin e duhur, edhe nëse shërbimi është komprometuar nga një palë e tretë."
