    "privacy_view_display_recent_call_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا فعّلتَ خاصية تصفية جهات الاتصال غير المعروفة على جهازك، فستظهر المكالمات الواردة من التطبيق في قائمة \"المتصلون غير المعروفين\"."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако сте активирали филтриране на непознати контакти на устройството си, входящите обаждания от приложението ще се показват в списъка „Непознати обаждащи се“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jste na svém zařízení povolili filtrování neznámých kontaktů, příchozí hovory z aplikace se zobrazí v seznamu „Neznámí volající“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har aktiveret filtrering af ukendte kontakter på din enhed, vises indgående opkald fra applikationen på listen \"Ukendte opkaldere\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie auf Ihrem Gerät die Filterung unbekannter Kontakte aktiviert haben, werden eingehende Anrufe von dieser Anwendung in der Liste „Unbekannte Anrufer“ angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν έχετε ενεργοποιήσει το φιλτράρισμα άγνωστων επαφών στη συσκευή σας, οι εισερχόμενες κλήσεις από την εφαρμογή θα εμφανίζονται στη λίστα «Άγνωστοι καλούντες»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have enabled unknown contacts filtering on your device, incoming calls from the application will appear in the \"Unknown Callers\" list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ha activado el filtro de contactos desconocidos en su dispositivo, las llamadas entrantes de la aplicación aparecerán en la lista de \"Llamadas desconocidas\"."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر فیلتر کردن مخاطبین ناشناس را در دستگاه خود فعال کرده باشید، تماس‌های دریافتی از برنامه در لیست «تماس‌گیرندگان ناشناس» ظاهر می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos olet ottanut käyttöön tuntemattomien yhteystietojen suodatuksen laitteellasi, sovelluksesta tulevat puhelut näkyvät \"Tuntemattomat soittajat\" -luettelossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez activé le filtrage des contacts inconnus sur votre appareil, les appels entrants provenant de l'application apparaîtront dans la liste « Correspondants inconnus »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם הפעלת סינון אנשי קשר לא ידועים במכשיר שלך, שיחות נכנסות מהאפליקציה יופיעו ברשימת \"מתקשרים לא ידועים\"."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आपने अपने डिवाइस पर अनजान कॉन्टैक्ट फ़िल्टरिंग चालू की है, तो एप्लिकेशन से आने वाली कॉल \"अनजान कॉलर्स\" लिस्ट में दिखाई देंगी।"
