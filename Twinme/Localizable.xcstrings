        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstránenie správ, médií a súborov z tejto konverzácie ich neodstráni zo zariadenia vášho kontaktu a nebudete to môcť urobiť neskôr."
