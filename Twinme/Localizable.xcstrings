    "call_view_camera_control_ask_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب %@ للسماح لك بالتحكم في الكاميرا أثناء مكالمة الفيديو."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помолете %@ да ви позволи да контролирате камерата му/й по време на видеоразговора."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte %@ o povolení ovládat jejich kameru během videohovoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed %@ om at tillade dig at styre deres kamera under videoopkaldet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitten Sie %@, Ihnen die Steuerung ihrer Kamera während des Videoanrufs zu erlauben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον/την %@ να σας επιτρέψει να ελέγχετε την κάμερά του/της κατά τη διάρκεια της βιντεοκλήσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ to allow you to control their camera during the video call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita a %@ que te permita controlar su cámara durante la videollamada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از %@ بخواهید که در طول تماس ویدیویی به شما اجازه کنترل دوربین خود را بدهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä %@:ia antamaan sinulle lupa hallita heidän kameraansa videopuhelun aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à %@ de vous autoriser à contrôler sa caméra pendant l'appel vidéo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקש מ-%@ לאפשר לך לשלוט במצלמה שלהם במהלך שיחת הווידאו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो कॉल के दौरान %@ से उनके कैमरे को नियंत्रित करने की अनुमति माँगें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatražite od %@ da vam dopusti upravljanje svojom kamerom tijekom videopoziva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérd meg %@-t, hogy engedélyezze kamerájának vezérlését videohívás közben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta %@ untuk mengizinkan Anda mengontrol kamera mereka selama panggilan video."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a %@ di consentirti di controllare la sua fotocamera durante la videochiamata. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ通話中に%@にカメラの操作を許可するよう依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화상 통화 중 %@에게 카메라 제어 권한을 요청하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be %@ om å la deg kontrollere kameraet deres under videosamtalen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag %@ om je toe te staan "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś użytkownika %@ o umożliwienie sterowania jego kamerą podczas rozmowy wideo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao %@ para lhe permitir controlar a câmara dele durante a videochamada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cereți lui %@ să vă permită controlul camerei sale în timpul apelului video."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите %@ разрешить вам управлять его камерой во время видеозвонка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte %@, aby vám počas videohovoru umožnil ovládať jeho kameru."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosite %@, naj vam med video klicem dovoli nadzor svoje kamere."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkoji %@ t’ju lejojë të kontrolloni kamerën e tij/saj gjatë thirrjes video."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite %@ da vam dozvoli da kontrolišete njegovu/njenu kameru tokom video poziva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
