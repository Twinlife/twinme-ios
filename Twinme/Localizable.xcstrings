          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνιστάται έντονα η πιστοποίηση των σχέσεων που δημιουργούνται με Μίνι‑Κωδικό για ενίσχυση της ασφάλειας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is strongly recommended to certify relations established with a Mini-Code to reinforce their security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recomienda encarecidamente certificar las relaciones establecidas con un minicódigo para reforzar su seguridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکیداً توصیه می‌شود روابطی که با یک مینی‌کد برقرار شده‌اند را برای تقویت امنیت آنها تأیید کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On erittäin suositeltavaa sertifioida Mini-koodilla luodut suhteet niiden turvallisuuden vahvistamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est fortement recommandé de certifier les relations établies avec un Mini-Code pour renforcer leur sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מומלץ מאוד לאשר קשרים שנוצרו באמצעות מיני-קוד כדי לחזק את אבטחתם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिनी-कोड के साथ स्थापित संबंधों को उनकी सुरक्षा को सुदृढ़ करने के लिए प्रमाणित करने की दृढ़ता से अनुशंसा की जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snažno se preporučuje potvrditi odnose uspostavljene Mini-kodom kako bi se pojačala njihova sigurnost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erősen ajánlott a Mini-kóddal létrehozott kapcsolatok hitelesítése a biztonság növelése érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat disarankan untuk mensertifikasi relasi yang dibuat dengan Mini-Kode guna memperkuat keamanannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si consiglia vivamente di certificare le relazioni stabilite con un Mini-codice per rafforzarne la sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミニコードで確立した関係は、セキュリティ強化のため、認証することを強くお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니 코드로 설정된 관계의 보안을 강화하기 위해 인증을 강력히 권장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det anbefales på det sterkeste å sertifisere etablerte relasjoner med en minikode for å forsterke sikkerheten deres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt sterk aanbevolen om relaties die u tot stand hebt gebracht te certificeren met een minicode om de beveiliging ervan te versterken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdecydowanie zaleca się certyfikowanie relacji nawiązanych za pomocą Mini-kodu, aby wzmocnić ich bezpieczeństwo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É altamente recomendável certificar as relações estabelecidas com um Minicódigo para reforçar a sua segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recomandă puternic certificarea relațiilor create cu Mini-Coduri pentru a le crește securitatea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настоятельно рекомендуется сертифицировать связи, установленные с помощью мини-кода, чтобы усилить их безопасность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dôrazne sa odporúča certifikovať vzťahy vytvorené pomocou Mini‑Kódu na zvýšenie bezpečnosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Močno priporočamo, da odnose, vzpostavljene z Mini-kodo, certificirate, da okrepite njihovo varnost."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekomandohet fort të certifikohen marrëdhëniet e krijuara me Mini-Kod për të forcuar sigurinë e tyre."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snažno se preporučuje sertifikovanje odnosa uspostavljenih Mini-kodom kako bi se pojačala njihova bezbednost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det rekommenderas starkt att certifiera etablerade relationer med en minikod för att förstärka deras säkerhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenliklerini güçlendirmek için kurulan ilişkileri bir Mini Kod ile onaylamanız şiddetle önerilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настійно рекомендується сертифікувати зв'язки, встановлені за допомогою міні-коду, щоб посилити їхню безпеку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nên xác thực các mối quan hệ được tạo bằng Mini-Code để tăng cường bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强烈建议对使用迷你代码建立的关系进行认证，以增强其安全性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強烈建議使用迷你程式碼建立的關係進行認證，以增強其安全性。"
          }
        }
      }
    },
    "invitation_room_view_message" : {
      "comment" : "InvitationRoomViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من جهة الاتصال القريبة منك مسح رمز QR الخاص بـ \"الغرفة\" باستخدام Skred، أو النقر على رمز الدعوة لنسخه إلى الحافظة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помолете ваш приятел близо до вас да сканира QR-кода на „стаята“ с Skred или докоснете кода за покана, за да го копирате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte svého přítele poblíž, aby naskenoval QR kód „místnosti“ pomocí Skred, nebo klepněte na pozvánkový kód pro jeho zkopírování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed din kontaktperson nær dig om at scanne QR-koden til \"room\" med Skred, eller tryk på invitationskoden for at kopiere den til udklipsholderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitten Sie Ihr Gegenüber, den QR-Code des „Raums“ mit Skred zu scannen, oder tippen Sie auf den Einladungscode, um ihn in die Zwischenablage zu kopieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον φίλο σας κοντά σας να σαρώσει τον QR‑κώδικα του «δωματίου» με το Skred ή πατήστε τον κωδικό για αντιγραφή στο πρόχειρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask your contact near you to scan the QR-code of the \"room\" with Skred, or tap the invitation code to copy it to the clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídale a su contacto cercano que escanee el código QR de la \"room\" con Skred, o toque el código de invitación para copiarlo en el portapapeles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از مخاطب نزدیک خود بخواهید تا کد QR \"اتاق\" را با Skred اسکن کند یا روی کد دعوت ضربه بزنید تا آن را در کلیپ بورد کپی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä lähellä olevaa yhteyshenkilöäsi skannaamaan \"huoneen\" QR-koodi Skredillä tai kopioida se leikepöydälle napauttamalla kutsukoodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à votre contact près de vous de scanner le QR-code de la “room“ avec Skred, ou appuyez sur le code d’invitation pour le copier dans le presse-papiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקש מאיש הקשר שלך לידך לסרוק את קוד ה-QR של ה\"חדר\" עם Skred, או הקש על קוד ההזמנה כדי להעתיק אותו ללוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने नजदीकी संपर्क को स्क्रेड के साथ \"कमरे\" के क्यूआर-कोड को स्कैन करने के लिए कहें, या इसे क्लिपबोर्ड पर कॉपी करने के लिए निमंत्रण कोड पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite prijatelja u svojoj blizini da skenira QR-kôd „sobe” pomoću Skred ili dodirnite pozivni kôd kako biste ga kopirali u međuspremnik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérd meg a közeledben lévő barátodat, hogy olvassa be a „szoba” QR-kódját Skred segítségével, vagy koppints a meghívókódra a vágólapra másoláshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta kontak Anda di dekat Anda untuk memindai kode QR \"room\" dengan Skred, atau ketuk kode undangan untuk menyalinnya ke papan klip."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi al tuo contatto vicino a te di scansionare il QR-code della \"room\" con Skred, oppure tocca il codice di invito per copiarlo negli appunti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの連絡先に、Skred で「ルーム」の QR コードをスキャンするか、招待コードをタップしてクリップボードにコピーするよう依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가까운 연락처에게 Skred로 \"방\"의 QR 코드를 스캔하도록 요청하거나 초대 코드를 탭하여 클립보드에 복사하도록 요청하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be kontakten din nær deg om å skanne QR-koden til \"room\" med Skred, eller trykk på invitasjonskoden for å kopiere den til utklippstavlen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag je contactpersoon bij jou in de buurt om de QR-code van de \"room\" te scannen met Skred, of tik op de uitnodigingscode om deze naar het klembord te kopiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś kontakt w pobliżu, aby zeskanował kod QR „room” z Skred lub dotknij kodu zaproszenia, aby skopiować go do schowka."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao seu contato perto de você para escanear o código QR da \"room\" com Skred ou toque no código do convite para copiá-lo para a área de transferência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugați prietenul de lângă dvs. să scaneze codul QR al „camerei” cu Skred sau apăsați pe cod pentru a-l copia în clipboard."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросите друга рядом с вами отсканировать QR-код «room» с помощью Skred или нажмите код приглашения, чтобы скопировать его в буфер обмена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte svojho priateľa v blízkosti, aby naskenoval QR‑kód „miestnosti“ pomocou Skred, alebo ťuknite na pozývací kód na jeho kopírovanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosite prijatelja v svoji bližini, naj s Skred skenira QR-kodo »sobe«, ali tapnite kodo povabila, da jo kopirate v odložišče."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkojini mikut tuaj pranë jush të skanojë QR-kodin e \\\"dhomës\\\" me skred, ose prekni kodin e ftesës për ta kopjuar në kujtesën e përkohshme."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite prijatelja u vašoj blizini da skenira QR-kod \\\"sobe\\\" pomoću Skred, ili dodirnite pozivni kod da biste ga kopirali u međuspremnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be din kontakt nära dig att skanna QR-koden för \"room\" med Skred, eller tryck på inbjudningskoden för att kopiera den till urklippet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınınızdaki arkadaşınızdan \"odanın\" QR kodunu Skred ile taramasını isteyin veya davet koduna dokunarak panoya kopyalamasını isteyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попросіть свого контакта поруч із вами сканувати QR-код \"кімнати\" за допомогою Skred або торкніться коду запрошення, щоб скопіювати його в буфер обміну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu bạn bè gần bạn quét mã QR của \"phòng\" bằng Skred hoặc nhấn vào mã mời để sao chép vào bộ nhớ tạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请你附近的朋友用 Skred 扫描“房间”的二维码，或点击邀请码将其复制到剪贴板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請您附近的聯絡人使用 Skred 掃描「房間」的二維碼，或點擊邀請碼將其複製到剪貼簿。"
          }
        }
      }
    },
