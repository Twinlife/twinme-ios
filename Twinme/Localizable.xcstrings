          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy po kolei przeliteruj słowo wyświetlone na ekranie, które druga osoba może zweryfikować. Gdy wszystkie słowa zostaną zweryfikowane, relacja z %@ zostanie potwierdzona."
          }
