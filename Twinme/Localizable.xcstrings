    "create_group_view_member_allow_invitation_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لأعضاء المجموعة بدعوة جهات الاتصال الخاصة بهم"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши на членовете на групата да канят свои контакти"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit členům skupiny pozvat své kontakty"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad gruppemedlemmer at invitere deres kontakter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppenmitgliedern erlauben, deren eigene Kontakte einzuladen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε στα μέλη να προσκαλούν τις επαφές τους"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow group members to invite their contacts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir a los miembros del grupo invitar a sus contactos"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجازه اعضای گروه را به تماس های خود دعوت کنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli ryhmän jäsenet kutsua yhteyshenkilöt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les membres à inviter leurs contacts"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לחברי קבוצה להזמין את אנשי הקשר שלהן"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समूह के सदस्यों को उनके संपर्कों को आमंत्रित करने की अनुमति दें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopusti članovima grupe da pozivaju svoje kontakte"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezd a csoporttagoknak, hogy meghívhassák kapcsolataikat"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan anggota grup untuk mengundang kontak mereka"
