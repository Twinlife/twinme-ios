        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کلمه را تأیید نکرد. گواهی رابطه ناموفق بود و باید دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ei vahvistanut sanaa. Suhteen sertifiointi epäonnistui, ja sinun on yritettävä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas validé le mot. La certification de la relation a échoué et vous devrez réessayer."
