    "account_view_delete_account" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف حسابك ، إلى جانب جميع البيانات المرتبطة به ، بشكل دائم. يتأكد؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашият акаунт и всички свързани с него данни ще бъдат изтрити завинаги. Потвърждавате?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet a všechna související data budou trvale odstraněna. Potvrdit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto vil sammen med alle tilknyttede data blive slettet permanent. Bekræfte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Konto wird zusammen mit allen zugehörigen Daten dauerhaft gelöscht. Bestätigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός σας και όλα τα συσχετισμένα δεδομένα θα διαγραφούν οριστικά. Επιβεβαίωση;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, along with all associated data, will be permanently deleted. Confirm?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuenta, junto con todos los datos asociados, se eliminarán de forma permanente. ¿Confirmar?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب شما، همراه با تمام داده های مرتبط، برای همیشه حذف خواهد شد. تایید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilisi ja kaikki siihen liittyvät tiedot poistetaan pysyvästi. Vahvistaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte, ainsi que toutes les données associées, seront définitivement supprimés. Confirmer ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון שלך, יחד עם כל הנתונים המשויכים, יימחקו לצמיתות. האם לאשר?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका खाता, सभी संबद्ध डेटा सहित, स्थायी रूप से हटा दिया जाएगा। पुष्टि करना?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš račun, zajedno sa svim povezanim podacima, bit će trajno izbrisan. Potvrditi?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiókod és minden kapcsolódó adat véglegesen törlődik. Megerősíted?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun Anda, beserta semua data terkait, akan dihapus secara permanen. Mengonfirmasi?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account, insieme a tutti i dati associati, verrà eliminato definitivamente. Confermare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントは、関連するすべてのデータとともに完全に削除されます。 確認？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 계정은 모든 관련 데이터와 함께 영구적으로 삭제됩니다. 확인하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen din, sammen med alle tilknyttede data, slettes permanent. Bekrefte?"
          }
        },
