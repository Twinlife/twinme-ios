    "settings_view_content_information" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعريف محتويات الوسائط المرسلة في المحادثة: يتطلب الوضوح العالي مزيدًا من البيانات وبالتالي وقتًا أطول للإرسال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резолюцията на медиите, изпращани в разговор: високата резолюция изисква повече данни и повече време за предаване."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozlišení médií odeslaných v konverzaci: vysoké rozlišení vyžaduje více dat a tedy delší přenos."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definition af medieindhold, der sendes i en samtale: High definition kræver flere data og derfor mere transmissionstid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auflösung von Medieninhalten, die in einer Unterhaltung gesendet werden: High Definition erfordert mehr Datenvolumen und somit eine längere Übertragungszeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανάλυση των πολυμέσων που αποστέλλονται σε συνομιλία: η υψηλή ανάλυση απαιτεί περισσότερα δεδομένα και περισσότερο χρόνο μεταφοράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolution of media contents sent in a conversation: high definition requires more data and therefore more transmission time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolución de contenidos multimedia enviados en una conversación: la alta definición requiere más datos y por tanto más tiempo de transmisión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضوح محتوای رسانه ای ارسال شده در یک مکالمه: وضوح بالا به داده های بیشتر و در نتیجه زمان انتقال بیشتر نیاز دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskustelussa lähetettyjen mediasisältöjen resoluutio: teräväpiirto vaatii enemmän dataa ja siten enemmän lähetysaikaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résolution des contenus médias envoyés dans une conversation : la haute définition nécessite plus de données et donc plus de temps de transmission."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רזולוציה של תוכן מדיה שנשלח בצ'אט: High Definition דורש יותר נתונים ולכן יותר זמן שידור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वार्तालाप में भेजी गई मीडिया सामग्री का समाधान: हाई डेफिनिशन के लिए अधिक डेटा की आवश्यकता होती है और इसलिए अधिक प्रसारण समय लगता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razlučivost medijskih sadržaja poslanih u razgovoru: visoka razlučivost zahtijeva više podataka i stoga više vremena prijenosa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beszélgetésben küldött média felbontása: a nagy felbontás több adatforgalmat és hosszabb átvitelidőt igényel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolusi konten media yang dikirim dalam percakapan: definisi tinggi membutuhkan lebih banyak data dan karenanya lebih banyak waktu transmisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risoluzione dei contenuti multimediali inviati in una conversazione: l’alta definizione richiede più dati e quindi più tempo di trasmissione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話で送信されるメディア コンテンツの解像度: 高解像度では、より多くのデータが必要になるため、送信時間が長くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화에서 전송되는 미디어 콘텐츠의 해상도: 고화질에는 더 많은 데이터가 필요하므로 전송 시간이 더 걸립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppløsning av medieinnhold som sendes i en samtale: høy oppløsning krever mer data og derfor mer sendetid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definitie van media-inhoud die in een gesprek wordt verzonden: high definition vereist meer gegevens en dus meer transmissietijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdzielczość treści multimedialnych przesyłanych w konwersacji: wysoka rozdzielczość wymaga większej ilości danych, a co za tym idzie dłuższego czasu transmisji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolução dos conteúdos de mídia enviados em uma conversa: a alta definição requer mais dados e, portanto, mais tempo de transmissão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezoluția conținutului media trimis într-o conversație: definiția înaltă necesită mai multe date și timp de transmisie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение медиаконтента, отправляемого во время разговора: для высокой четкости требуется больше данных и, следовательно, больше времени на передачу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozlíšenie mediálneho obsahu odoslaného v konverzácii: vysoké rozlíšenie vyžaduje viac dát a teda dlhší čas prenosu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ločljivost medijskih vsebin, poslanih v pogovoru: visoka ločljivost zahteva več podatkov in zato več časa za prenos."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezolucioni i mediave të dërguara në një bisedë: definicioni i lartë kërkon më shumë të dhëna dhe, për rrjedhojë, më shumë kohë transmetimi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezolucija medijskih sadržaja poslatih u razgovoru: visoka definicija zahteva više podataka i samim tim više vremena za prenos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upplösning av medieinnehåll som skickas i en konversation: hög upplösning kräver mer data och därför längre sändningstid."
