    "contact_capabilities_view_information_discreet_relation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعرض اسم جهة الاتصال في الإشعارات ولا يحفظ المكالمات في سجل المكالمات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не показва името на контакта в известията и не записва обажданията в историята."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazuje jméno kontaktu v oznámeních a nezaznamenává hovory v historii hovorů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser ikke kontaktens navn i meddelelser og gemmer ikke opkald i opkaldshistorikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Kontaktnamen nicht in Benachrichtigungen an und speichert Anrufe nicht im Anrufsverlauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν εμφανίζει το όνομα της επαφής στις ειδοποιήσεις και δεν καταγράφει κλήσεις στο ιστορικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does not display contact name in notifications, and does not record calls in calls history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No muestra el nombre del contacto en las notificaciones y no guarda las llamadas en el historial de llamadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام مخاطب را در اعلان ها نمایش نمی دهد و تماس ها را در سابقه تماس ذخیره نمی کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei näytä yhteyshenkilön nimeä ilmoituksissa eikä tallenna puheluita puheluhistoriaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'affiche pas le nom du contact dans les notifications et n'enregistre pas les appels dans l'historique des appels."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אינו מציג את שם איש הקשר בהתראות ואינו שומר שיחות בהיסטוריית השיחות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אינו מציג את שם איש הקשר בהתראות ואינו שומר שיחות בהיסטוריית השיחות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikazuje ime kontakta u obavijestima i ne bilježi pozive u povijesti poziva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem jeleníti meg a kapcsolat nevét az értesítésekben, és nem rögzíti a hívásokat az előzményekben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak menampilkan nama kontak di notifikasi dan tidak menyimpan panggilan di riwayat panggilan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non visualizza il nome del contatto nelle notifiche e non salva le chiamate nella cronologia delle chiamate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知に連絡先名は表示されず、通話は通話履歴に保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림에 연락처 이름을 표시하지 않으며 통화 기록에 통화를 저장하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser ikke kontaktnavn i varsler og lagrer ikke anrop i anropsloggen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft de naam van de contactpersoon niet weer in meldingen en slaat geen oproepen op in de oproepgeschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wyświetla nazwy kontaktu w powiadomieniach i nie zapisuje połączeń w historii połączeń."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não exibe o nome do contato nas notificações e não salva as chamadas no histórico de chamadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu afișează numele contactului în notificări și nu înregistrează apelurile în istoricul apelurilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не отображает имя контакта в уведомлениях и не сохраняет звонки в истории звонков."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazuje meno kontaktu v upozorneniach a nezaznamenáva hovory v histórii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V obvestilih ne prikaže imena stika in ne beleži klicev v zgodovini klicev."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk shfaq emrin e kontaktit në njoftime dhe nuk regjistron thirrjet në historikun e thirrjeve."
