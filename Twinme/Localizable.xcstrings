    "invitation_call_view_generate_code_message" : {
      "comment" : "InvitationCallViewController",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا الإجراء إلى إبطال رمز الدعوة الحالي المرتبط برابط \"النقر للاتصال\"هذا. يتأكد؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това действие анулира текущия код за покана, свързан с този „click‑to‑call“ линк. Потвърждавате ли?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato akce zneplatní aktuální pozvánkový kód spojený s tímto „click‑to‑call“ odkazem. Potvrdit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne handling ugyldiggør den aktuelle invitationskode, der er knyttet til dette \"click-to-call\"-link. Bekræfte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion macht den aktuellen Einladungscode, der mit diesem „Click-to-Call“-Link verknüpft ist, ungültig. Bestätigen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ενέργεια ακυρώνει τον τρέχοντα κωδικό πρόσκλησης αυτού του συνδέσμου «click‑to‑call». Επιβεβαίωση;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This action invalidates the current invite code associated with this \"click-to-call\" link. Confirm?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción invalida el código de invitación actual asociado con este enlace de \"click-to-call\". ¿Confirmar?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این اقدام کد دعوت فعلی مرتبط با پیوند \"click-to-call\" را باطل می‌کند. تایید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä toiminto mitätöi nykyisen kutsukoodin, joka liittyy tähän \"click-to-call\" -linkkiin. Vahvistaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action invalide le code d’invitation actuel associé à ce lien \"click-to-call\". Confirmer?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו מבטלת את קוד ההזמנה הנוכחי המשויך לקישור \"הקלק להתקשר\" זה. לְאַשֵׁר?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह क्रिया इस \"क्लिक-टू-कॉल\" लिंक से जुड़े वर्तमान आमंत्रण कोड को अमान्य कर देती है। पुष्टि करना?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova radnja poništava trenutni pozivni kôd povezan s ovom poveznicom „klikni za poziv”. Potvrditi?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a művelet érvényteleníti a jelenlegi „click-to-call” meghívókódot ehhez a linkhez. Megerősíted?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini membatalkan kode undangan saat ini yang terkait dengan tautan \"click-to-call\" ini. Mengonfirmasi?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione invalida il codice di invito corrente associato a questo link \"click-to-call\". Confermare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
