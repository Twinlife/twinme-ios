    "settings_space_view_allow_notifications_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر الإشعارات فقط عندما تكون هذه المساحة هي المساحة النشطة حاليًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Известия ще се показват само когато този Space е текущо активен."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení se zobrazí pouze tehdy, když je daný Prostor aktuálně aktivní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer vises kun, når dette Space er det aktuelt aktive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen werden nur angezeigt, wenn dieser Space gerade aktiv ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις θα εμφανίζονται μόνο όταν αυτός ο Χώρος είναι ο τρέχον ενεργός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications will only appear when that Space is the one currently active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones solo aparecerán cuando ese Space sea el que está actualmente activo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌ها فقط زمانی ظاهر می‌شوند که آن Space فضای فعلی فعال باشد."
