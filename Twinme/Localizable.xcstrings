        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne handlingen ugyldiggjør den gjeldende invitasjonskoden knyttet til denne \"click-to-call\"-koblingen. Bekrefte?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
