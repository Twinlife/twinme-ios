    "privacy_view_lock_screen_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح الوصول إلى التطبيق باستخدام خدمات المصادقة البيومترية أو رمز المرور بجهازك. لا يزال بإمكانك الرد على المكالمات الواردة وتلقي الإخطارات أثناء قفل الوصول إلى التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключете достъпа до приложението чрез биометрия или парола на устройството. Все още ще можете да приемате обаждания и известия, докато приложението е заключено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemkněte přístup k aplikaci pomocí biometrického ověření nebo kódu zařízení. Příchozí hovory a oznámení budou přijímány i při uzamknutém přístupu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås op for adgang til applikationen ved hjælp af enhedens biometriske tjenester eller adgangskodeautentificeringstjenester. Du kan stadig besvare indgående opkald og modtage underretninger, mens adgangen til appen er låst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperren Sie den Zugriff auf die Anwendung mithilfe der biometrischen Dienste oder der Passcode-Authentifizierung Ihres Geräts. Sie können weiterhin eingehende Anrufe annehmen und Benachrichtigungen erhalten, während der Zugriff auf die App gesperrt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκλειδώστε την εφαρμογή χρησιμοποιώντας βιομετρικά ή κωδικό συσκευής. Μπορείτε πάντα να απαντάτε σε κλήσεις και να λαμβάνετε ειδοποιήσεις ενώ η εφαρμογή είναι κλειδωμένη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock access to the application using your device biometric or passcode authentication services. You can still answer incoming calls and receive notifications while access to the app is locked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquee el acceso a la aplicación utilizando los servicios de autenticación biométrica o de contraseña de su dispositivo. Aún puede responder llamadas entrantes y recibir notificaciones mientras el acceso a la aplicación está bloqueado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با استفاده از خدمات تأیید بیومتریک یا کد عبور دستگاه ، دسترسی به برنامه را باز کنید. هنگامی که دسترسی به برنامه قفل است ، همچنان می توانید به تماس های دریافتی پاسخ دهید و اعلان ها را دریافت کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa sovelluksen käyttö laitteesi biometristen tai pääsykooditodennuspalveluiden avulla. Voit silti vastata saapuviin puheluihin ja vastaanottaa ilmoituksia, kun pääsy sovellukseen on lukittu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez l’accès à l’application à l’aide des services d’authentification biométrique ou par mot de passe de votre appareil. Vous pouvez toujours répondre aux appels entrants et recevoir des notifications lorsque l’accès à l’application est verrouillé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נעילת גישה לאפליקציה באמצעות שירותי הביומטריה או אימות הסיסמה של המכשיר שלך. אתה עדיין יכול לענות לשיחות נכנסות ולקבל התראות כאשר הגישה לאפליקציה נעולה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने डिवाइस बायोमेट्रिक या पासकोड प्रमाणीकरण सेवाओं का उपयोग करके एप्लिकेशन तक पहुंच को अनलॉक करें। आप अभी भी इनकमिंग कॉल्स का जवाब दे सकते हैं और ऐप को एक्सेस करने के दौरान नोटिफिकेशन प्राप्त कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otključajte pristup aplikaciji pomoću biometrije uređaja ili usluga autentifikacije lozinkom/PIN-om. I dalje možete odgovarati na dolazne pozive i primati obavijesti dok je pristup aplikaciji zaključan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oldd fel az alkalmazás elérését az eszköz biometrikus vagy jelkódos hitelesítésével. A bejövő hívásokra továbbra is válaszolhatsz, és értesítéseket is fogadhatsz, még zárolt állapotban is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka kunci akses ke aplikasi menggunakan biometrik perangkat atau layanan otentikasi kode sandi. Anda masih dapat menjawab panggilan masuk dan menerima pemberitahuan saat akses ke aplikasi terkunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca l’accesso all’applicazione utilizzando i servizi di autenticazione biometrica o passcode del dispositivo. Puoi comunque rispondere alle chiamate in arrivo e ricevere notifiche mentre l’accesso all’app è bloccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの生体認証またはパスコード認証サービスを使用して、アプリケーションへのアクセスのロックを解除します。 アプリへのアクセスがロックされている間も、着信に応答して通知を受け取ることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치 생체 인식 또는 암호 인증 서비스를 사용하여 애플리케이션에 대한 액세스를 잠금 해제합니다. 앱에 대한 액세스가 잠겨있는 동안에도 수신 전화를 받고 알림을받을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås opp tilgang til applikasjonen ved hjelp av enhetens biometriske tjenester eller passordgodkjenningstjenester. Du kan fortsatt svare på innkommende anrop og motta varsler mens tilgangen til appen er låst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel de toegang tot de applicatie met behulp van de biometrische of wachtwoordverificatieservices van uw apparaat. U kunt nog steeds inkomende oproepen beantwoorden en meldingen ontvangen terwijl de toegang tot de app is vergrendeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuj dostęp do aplikacji przy użyciu usług uwierzytelniania biometrycznego lub kodu dostępu. Nadal możesz odbierać połączenia przychodzące i otrzymywać powiadomienia, gdy dostęp do aplikacji jest zablokowany."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie o acesso ao aplicativo usando os serviços de autenticação biométrica ou de senha do dispositivo. Você ainda pode atender chamadas e receber notificações enquanto o acesso ao aplicativo está bloqueado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deblocați accesul la aplicație prin autentificare biometrică sau cod. Puteți răspunde în continuare la apeluri și primi notificări chiar dacă aplicația este blocată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разблокируйте доступ к приложению с помощью служб биометрической аутентификации или аутентификации по паролю. Вы по-прежнему можете отвечать на входящие звонки и получать уведомления, пока доступ к приложению заблокирован."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odomknite prístup do aplikácie pomocou biometrického overenia alebo kódu zariadenia. Počas zamknutia môžete stále prijímať hovory a oznámenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odklenite dostop do aplikacije z biometričnimi storitvami ali storitvami preverjanja pristnosti z geslom naprave. Še vedno lahko odgovarjate na dohodne klice in prejemate obvestila, medtem ko je dostop do aplikacije zaklenjen."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhbllokoni qasjen në aplikacion duke përdorur shërbimet biometrike të pajisjes suaj ose autentifikimin me kod. Mund të përgjigjeni ende ndaj thirrjeve hyrëse dhe të merrni njoftime ndërkohë që qasja në aplikacion është e bllokuar."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otključajte pristup aplikaciji korišćenjem biometrijskih usluga uređaja ili autentifikacije šifrom. I dalje možete odgovarati na dolazne pozive i primati obaveštenja dok je pristup aplikaciji zaključan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås upp åtkomst till applikationen med hjälp av enhetens biometriska eller autentiseringstjänster för lösenord. Du kan fortfarande svara på inkommande samtal och ta emot aviseringar medan åtkomsten till appen är låst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazınızın biyometrik veya şifre doğrulama hizmetlerini kullanarak uygulamaya erişimin kilidini açın. Uygulamaya erişim kilitliyken de gelen aramaları cevaplayabilir ve bildirimler alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрити доступ до додатку через автентифікацію шляхом введення біометричних даних або паролю. Відповідати на вхідні дзвінки та отримувати сповіщення можливо навіть у разі відсутності доступу до додатку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa truy cập ứng dụng bằng sinh trắc học hoặc mã bảo mật. Bạn vẫn có thể nhận cuộc gọi và thông báo khi ứng dụng bị khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用设备生物识别或密码验证服务解锁对应用程序的访问。 在访问该应用程序时，您仍然可以接听来电并接收通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用設備生物識別或密碼驗證服務解鎖對應用程序的訪問。在訪問該應用程序時，您仍然可以接聽來電並接收通知。"
          }
        }
      }
    },
