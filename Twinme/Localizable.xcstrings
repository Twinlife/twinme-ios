    "account_migration_scanner_view_migration_start_from_current_device_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح رمز الاستجابة السريعة المعروض في قسم \"الحساب / النقل من جهاز آخر\" في القائمة الجانبية للجهاز الآخر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирайте QR-кода, показан в секцията „Акаунт / Прехвърляне от друго устройство“ в страничното меню на другото устройство."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte QR kód zobrazený v části „Účet / Přenos z jiného zařízení“ v postranním menu druhého zařízení."
