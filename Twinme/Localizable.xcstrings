    "proxy_view_limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد وصلت إلى الحد الأقصى لعدد البروكسيات المسموح بها (%d). لإضافة بروكسي جديد، يجب عليك أولاً إزالته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнахте лимита на позволените проксита (%d). За да добавите ново, първо трябва да премахнете едно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
